  <ItemGroup>
    <PackageReference Include="BepuPhysics" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Runtime/FlickerVoid.Engine.Runtime.csproj" />
  </ItemGroup>
</Project>
