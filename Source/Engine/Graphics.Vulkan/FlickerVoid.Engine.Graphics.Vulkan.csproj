<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Graphics/FlickerVoid.Engine.Graphics.csproj" />
  </ItemGroup>
  <!-- The engine's DLSS library and NVIDIA's DLSS and Ray Reconstruction runtimes, built on the first build (Source/Native/Dlss) and copied beside every program. -->
  <PropertyGroup>
    <NativeLibraryName>Dlss</NativeLibraryName>
    <NativeLibraryFile>FlickerVoid.Dlss</NativeLibraryFile>
  </PropertyGroup>
  <Import Project="../../Native/Native.targets" />
  <ItemGroup>
    <None Include="$(NativeOutput)*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- The glob above ran before a first build made the files, so they are taken again once it has. -->
  <Target Name="TakeBuiltNativeFiles" AfterTargets="BuildNativeLibrary" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="$(NativeOutput)*" />
      <None Include="$(NativeOutput)*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
