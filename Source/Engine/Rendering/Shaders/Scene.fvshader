{
  "entryPoints": { "VertexMain": "Vertex", "SilhouetteVertexMain": "Vertex", "GeometryMain": "Pixel", "OutlineMain": "Pixel" },
  // The shading controls materials set (Name.fvmat), packed in this order into the buffer LoadMaterial reads.
  // Every default keeps the plain look: the base color lit by plain diffuse light.
  "parameters": [
    { "name": "tint", "type": "color", "default": [1, 1, 1] },
    { "name": "rampSoftness", "type": "float", "default": 1, "minimum": 0, "maximum": 1 },
    { "name": "wrap", "type": "float", "default": 0, "minimum": 0, "maximum": 1 },
    { "name": "shadowTint", "type": "color", "default": [0, 0, 0] },
    { "name": "rimColor", "type": "color", "default": [1, 1, 1] },
    { "name": "rimStrength", "type": "float", "default": 0, "minimum": 0, "maximum": 4 },
    { "name": "rimPower", "type": "float", "default": 3, "minimum": 0.5, "maximum": 8 },
    { "name": "specular", "type": "float", "default": 0, "minimum": 0, "maximum": 4 },
    { "name": "glossiness", "type": "float", "default": 0.5, "minimum": 0, "maximum": 1 },
    { "name": "emissive", "type": "color", "default": [0, 0, 0] },
    { "name": "emissiveIntensity", "type": "float", "default": 1, "minimum": 0, "maximum": 16 },
    // A painting or image used in place of the mesh part's own texture; its alpha is how thick the paint is.
    { "name": "texture", "type": "texture", "default": null },
    // How many times the texture repeats over the mesh part's uvs.
    { "name": "textureScale", "type": "float", "default": 1, "minimum": 0.1, "maximum": 16 },
    // How high, in world units, the thickest impasto of a painting's relief stands; it tilts the light, the mesh stays flat.
    { "name": "reliefDepth", "type": "float", "default": 0.01, "minimum": 0, "maximum": 0.1 },
    // The paint's coverage (its texture's alpha times the base color's) below which the surface is a hole, as in a cutout card:
    // nothing is drawn there, outlined or shadowed; 0 keeps the whole surface.
    { "name": "cutoff", "type": "float", "default": 0, "minimum": 0, "maximum": 1 },
    // Colours the painting through a row of this palette (uncompressed, one colour a texel): its brightness picks the colour along
    // the row, the darkest the first, so one grey painting gives many fronts, cars or coats.
    { "name": "palette", "type": "texture", "default": null },
    // The palette's row, from the top.
    { "name": "paletteRow", "type": "float", "default": 0, "minimum": 0, "maximum": 255 }
  ]
}
