{
  // Skin, wax, marble and fruit: light scatters under the surface, so it wraps further round the terminator in the scatter
  // color and shadows' edges warm (ShadingModel.Skin); a tint varies by place, as skin blushes in patches.
  "shadingModel": "Skin",
  "parameters": [
    // The color light scatters in under the surface, deep red for skin.
    { "name": "scatter", "type": "color", "default": [0.9, 0.3, 0.18] },
    // How far past the terminator the scattered light reaches: 0 none, 1 round to the back.
    { "name": "scatterWidth", "type": "float", "default": 0.5, "minimum": 0, "maximum": 1 },
    { "name": "variation", "type": "float", "default": 0, "minimum": 0, "maximum": 1 },
    { "name": "variationScale", "type": "float", "default": 0.2, "minimum": 0.05, "maximum": 10 }
  ]
}
