<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NVorbis" />
    <PackageReference Include="Silk.NET.SDL" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Cameras/FlickerVoid.Engine.Cameras.csproj" />
    <ProjectReference Include="../Flow/FlickerVoid.Engine.Flow.csproj" />
    <ProjectReference Include="../Rendering/FlickerVoid.Engine.Rendering.csproj" />
  </ItemGroup>
  <!-- Valve's Steam Audio library, fetched on the first build (Source/Native/SteamAudio) and copied beside every program that uses the audio. -->
  <PropertyGroup>
    <NativeLibraryName>SteamAudio</NativeLibraryName>
    <NativeLibraryFile>phonon</NativeLibraryFile>
  </PropertyGroup>
  <Import Project="../../Native/Native.targets" />
  <ItemGroup>
    <None Include="$(NativeOutput)*phonon*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="TakeFetchedSteamAudio" AfterTargets="BuildNativeLibrary" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="$(NativeOutput)*phonon*" />
      <None Include="$(NativeOutput)*phonon*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
