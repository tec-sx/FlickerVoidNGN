<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- MaskDecoder reads 16-bit images through StbImageSharp's pointer API. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" />
    <PackageReference Include="SharpGLTF.Core" />
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Engine/Rendering/FlickerVoid.Engine.Rendering.csproj" />
    <ProjectReference Include="../ShaderCompiler/FlickerVoid.Tools.ShaderCompiler.csproj" />
  </ItemGroup>
</Project>
