<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:props="using:FlickerVoid.Editor.Assets.Props"
             xmlns:inspector="using:FlickerVoid.Editor.Inspector"
             xmlns:controls="using:FlickerVoid.Editor.Controls"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Props.PropPanelView"
             x:DataType="props:PropPanelViewModel">
  <!-- A plain object's boxes: the size of the next one, and one taken out; its parts are listed in the outliner. -->
  <ScrollViewer>
    <StackPanel>
      <controls:PanelCard Header="Next box" Icon="{x:Static shell:LucideIcons.Cube}">
        <controls:PanelCard.Actions>
          <Button Classes="icon small" Command="{Binding AddBoxCommand}"
                  ToolTip.Tip="Add a box of this size beside the others; shape it with the mesh tools, hollow it with H.">
            <PathIcon Data="{x:Static shell:LucideIcons.Add}" />
          </Button>
        </controls:PanelCard.Actions>
        <StackPanel>
          <controls:PanelRow Label="Size">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
              <inspector:DragNumberBox Grid.Column="0" Value="{Binding Width}" Minimum="0.01" ToolTip.Tip="Width of the next box, in metres." />
              <inspector:DragNumberBox Grid.Column="1" Value="{Binding Height}" Minimum="0.01" ToolTip.Tip="Height of the next box, in metres." />
              <inspector:DragNumberBox Grid.Column="2" Value="{Binding Depth}" Minimum="0.01" ToolTip.Tip="Depth of the next box, in metres." />
            </Grid>
          </controls:PanelRow>
          <Button Classes="quiet" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding AddBoxCommand}"
                  ToolTip.Tip="Add a box of this size beside the others; shape it with the mesh tools, hollow it with H.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Add}" />
              <TextBlock Text="Add box" />
            </StackPanel>
          </Button>
        </StackPanel>
      </controls:PanelCard>
      <controls:PanelCard Header="Parts" Icon="{x:Static shell:LucideIcons.Layers}" Note="{Binding Boxes.Count}">
        <StackPanel>
          <controls:PanelRow Label="Part">
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Boxes}" SelectedItem="{Binding Chosen}" />
          </controls:PanelRow>
          <Button Classes="quiet delete" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding RemoveCommand}"
                  ToolTip.Tip="Take the part out, with the doors placed on it; the last part stays.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Delete}" />
              <TextBlock Text="Remove part" />
            </StackPanel>
          </Button>
        </StackPanel>
      </controls:PanelCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>
