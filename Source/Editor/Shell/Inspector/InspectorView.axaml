<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:FlickerVoid.Editor.Core.Inspector"
             xmlns:scenes="using:FlickerVoid.Engine.Runtime.Scenes"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Inspector.InspectorView"
             x:DataType="inspector:InspectorViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="heading" />
    <DropDownButton DockPanel.Dock="Bottom" Content="Add Component" HorizontalAlignment="Stretch" Margin="2"
                    IsEnabled="{Binding !!AddableComponents.Count}">
      <DropDownButton.Flyout>
        <MenuFlyout ItemsSource="{Binding AddableComponents}">
          <MenuFlyout.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="scenes:SceneComponent">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="Command" Value="{Binding $parent[UserControl].((inspector:InspectorViewModel)DataContext).AddComponentCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </ControlTheme>
          </MenuFlyout.ItemContainerTheme>
        </MenuFlyout>
      </DropDownButton.Flyout>
    </DropDownButton>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Components}" Margin="2,0,2,4">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="inspector:ComponentViewModel">
            <Border Classes="category">
            <Expander Classes="ownChevron" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,1">
              <Expander.Header>
                <DockPanel>
                  <Panel DockPanel.Dock="Right" Width="16">
                    <Button Classes="icon small" IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove the component"
                            Command="{Binding $parent[UserControl].((inspector:InspectorViewModel)DataContext).RemoveComponentCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="{x:Static shell:MaterialIcons.Close}" />
                    </Button>
                  </Panel>
                  <Panel DockPanel.Dock="Right" Width="16" Margin="0,0,2,0">
                    <PathIcon Classes="small" Data="{x:Static shell:MaterialIcons.Collapse}" IsVisible="{Binding $parent[Expander].IsExpanded}" />
                    <PathIcon Classes="small" Data="{x:Static shell:MaterialIcons.Expand}" IsVisible="{Binding !$parent[Expander].IsExpanded}" />
                  </Panel>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
              </Expander.Header>
              <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="inspector:FieldViewModel">
                    <Grid ColumnDefinitions="88,*" Margin="0,1">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <ContentControl Grid.Column="1" Content="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
