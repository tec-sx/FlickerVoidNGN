<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:FlickerVoid.Editor.Core.Inspector"
             xmlns:shell="using:FlickerVoid.Editor"
             xmlns:local="using:FlickerVoid.Editor.Inspector"
             x:Class="FlickerVoid.Editor.Inspector.InspectorView"
             x:DataType="inspector:InspectorViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="heading" />
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="4,0,4,2"
          IsVisible="{Binding Template, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="Template" VerticalAlignment="Center" ToolTip.Tip="The entity template it starts from; the scene saves only what differs" />
      <local:AssetPickerView Grid.Column="1" DataContext="{Binding Template}" />
    </Grid>
    <Button DockPanel.Dock="Bottom" Content="Add Component" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2"
            IsEnabled="{Binding !!AddChoices.Count}" Click="OnAddComponentClick" />
    <Border Classes="well">
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Components}" Margin="2,0,2,4">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="inspector:ComponentViewModel">
            <Border Classes="category">
            <Expander Classes="ownChevron" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,1">
              <Expander.Header>
                <DockPanel>
                  <Panel DockPanel.Dock="Right" Width="16">
                    <Button Classes="icon small" IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove the component"
                            Command="{Binding $parent[UserControl].((inspector:InspectorViewModel)DataContext).RemoveComponentCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="{x:Static shell:MaterialIcons.Close}" />
                    </Button>
                  </Panel>
                  <Panel DockPanel.Dock="Right" Width="16" Margin="0,0,2,0">
                    <PathIcon Classes="small" Data="{x:Static shell:MaterialIcons.Collapse}" IsVisible="{Binding $parent[Expander].IsExpanded}" />
                    <PathIcon Classes="small" Data="{x:Static shell:MaterialIcons.Expand}" IsVisible="{Binding !$parent[Expander].IsExpanded}" />
                  </Panel>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
              </Expander.Header>
              <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRow}" />
            </Expander>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    </Border>
  </DockPanel>
</UserControl>
