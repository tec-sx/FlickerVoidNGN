<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:FlickerVoid.Editor.Core.Inspector"
             xmlns:shell="using:FlickerVoid.Editor"
             xmlns:controls="using:FlickerVoid.Editor.Controls"
             xmlns:local="using:FlickerVoid.Editor.Inspector"
             x:Class="FlickerVoid.Editor.Inspector.InspectorView"
             x:DataType="inspector:InspectorViewModel">
  <DockPanel>
    <!-- The entity: its icon, its name over where it is, and the template it starts from. -->
    <Border DockPanel.Dock="Top" Classes="entityHeader">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Border Classes="iconTile">
          <PathIcon Data="{Binding Icon, Converter={x:Static shell:LucideIcons.ByName}}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Classes="title" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Place}" Classes="faint small" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Place, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <local:AssetPickerView Grid.Column="2" Classes="chip" DataContext="{Binding Template}" MaxWidth="150" VerticalAlignment="Center"
                               IsVisible="{Binding $parent[UserControl].((inspector:InspectorViewModel)DataContext).Template, Converter={x:Static ObjectConverters.IsNotNull}}"
                               ToolTip.Tip="The entity template it starts from; the scene saves only what differs." />
      </Grid>
    </Border>
    <!-- The category rail (rule R11): everything, then the modules the components come from; under them, the filter. -->
    <Border DockPanel.Dock="Left" Classes="rail" IsVisible="{Binding HasSelection}">
      <DockPanel>
        <ToggleButton x:Name="FilterToggle" DockPanel.Dock="Bottom" Classes="railButton" ToolTip.Tip="Filter the components by name or by a field's name.">
          <PathIcon Data="{x:Static shell:LucideIcons.Search}" />
        </ToggleButton>
        <Button DockPanel.Dock="Top" Classes="railButton" Classes.on="{Binding ShowsAllCategories}" Command="{Binding ShowAllCategoriesCommand}"
                ToolTip.Tip="All: the components of every module.">
          <PathIcon Data="{x:Static shell:LucideIcons.Layers}" />
        </Button>
        <ListBox Classes="rail" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <PathIcon Data="{Binding Converter={x:Static local:CategoryIcons.ByModule}}" ToolTip.Tip="{Binding}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <controls:SearchBox DockPanel.Dock="Top" Classes="row" Text="{Binding FilterText}" PlaceholderText="Filter components"
                        IsVisible="{Binding #FilterToggle.IsChecked}"
                        ToolTip.Tip="Show only the components that have the text in their name or in a field's name." />
    <ScrollViewer>
      <StackPanel>
        <ItemsControl ItemsSource="{Binding VisibleComponents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="inspector:ComponentViewModel">
              <StackPanel>
                <!-- A section: open, its fields; folded, one line saying what it holds. -->
                <ToggleButton Classes="section" IsChecked="{Binding IsExpanded}">
                  <DockPanel>
                    <Panel DockPanel.Dock="Left" Width="14" Margin="0,0,6,0">
                      <PathIcon Classes="small faint" Data="{x:Static shell:LucideIcons.Expand}" IsVisible="{Binding IsExpanded}" />
                      <PathIcon Classes="small faint" Data="{x:Static shell:LucideIcons.Next}" IsVisible="{Binding !IsExpanded}" />
                    </Panel>
                    <PathIcon DockPanel.Dock="Left" Classes="muted" Data="{Binding Icon, Converter={x:Static shell:LucideIcons.ByName}}" Margin="0,0,7,0" />
                    <Button DockPanel.Dock="Right" Classes="icon small" IsVisible="{Binding CanRemove}" ToolTip.Tip="More: remove the component.">
                      <PathIcon Data="{x:Static shell:LucideIcons.More}" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="Remove component"
                                    Command="{Binding $parent[UserControl].((inspector:InspectorViewModel)DataContext).RemoveComponentCommand}"
                                    CommandParameter="{Binding}">
                            <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.Delete}" /></MenuItem.Icon>
                          </MenuItem>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Summary}" Classes="faint small" FontWeight="Normal" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsExpanded}" />
                    </StackPanel>
                  </DockPanel>
                </ToggleButton>
                <Border Classes="sectionBody" IsVisible="{Binding IsExpanded}">
                  <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRow}" />
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="quiet addRow" IsEnabled="{Binding !!AddChoices.Count}" IsVisible="{Binding HasSelection}" Click="OnAddComponentClick"
                ToolTip.Tip="Add a component: a searchable list, grouped by module.">
          <DockPanel>
            <PathIcon DockPanel.Dock="Left" Data="{x:Static shell:LucideIcons.Add}" Margin="0,0,7,0" />
            <TextBlock Text="Add component" VerticalAlignment="Center" />
          </DockPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
