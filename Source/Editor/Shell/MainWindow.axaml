<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="using:FlickerVoid.Editor.Data"
        xmlns:shell="using:FlickerVoid.Editor"
        xmlns:inspector="using:FlickerVoid.Editor.Inspector"
        xmlns:inspectorCore="using:FlickerVoid.Editor.Core.Inspector"
        xmlns:assets="using:FlickerVoid.Editor.Assets"
        xmlns:viewports="using:FlickerVoid.Editor.Viewports"
        xmlns:scenes="using:FlickerVoid.Editor.Scenes"
        xmlns:controls="using:FlickerVoid.Editor.Controls"
        x:Class="FlickerVoid.Editor.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        Title="{Binding Title}"
        Width="1280" Height="720"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="30">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding Viewport.SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAssetsCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding PlayCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding Viewport.DuplicateSelectedCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <!-- The title bar: the window's own buttons stay on the right, the editor's tools fill the rest, and the empty bar behind
         them drags the window. -->
    <Border DockPanel.Dock="Top" Classes="toolbar titleBar">
      <Grid ColumnDefinitions="*,Auto,*">
        <Border Grid.ColumnSpan="3" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar" />
        <StackPanel Orientation="Horizontal">
          <PathIcon Classes="logo" Data="{x:Static shell:MaterialIcons.Logo}" />
          <TextBlock Text="{Binding Title}" Classes="windowTitle" IsHitTestVisible="False" />
          <Separator />
          <Button Classes="icon" Click="HandleOpenProjectClick" ToolTip.Tip="Open another project; the editor reopens on it.">
            <PathIcon Data="{x:Static shell:MaterialIcons.FolderOpen}" />
          </Button>
          <Button Classes="icon save" Command="{Binding Viewport.SaveCommand}" ToolTip.Tip="Save the scene (Ctrl+S).">
            <PathIcon Data="{x:Static shell:MaterialIcons.Save}" />
          </Button>
          <Button Classes="icon save" Command="{Binding SaveAssetsCommand}" ToolTip.Tip="Save the edited materials and moods (Ctrl+Shift+S).">
            <PathIcon Data="{x:Static shell:MaterialIcons.SaveAssets}" />
          </Button>
          <Button Classes="icon" Command="{Binding DiscardAssetsCommand}" ToolTip.Tip="Forget the unsaved material and mood edits.">
            <PathIcon Data="{x:Static shell:MaterialIcons.Discard}" />
          </Button>
          <Separator />
          <Button Classes="icon" Command="{Binding Viewport.DuplicateSelectedCommand}" ToolTip.Tip="Duplicate the selected entity (Ctrl+D).">
            <PathIcon Data="{x:Static shell:MaterialIcons.Duplicate}" />
          </Button>
          <Button Classes="icon delete" Command="{Binding Viewport.DeleteSelectedCommand}" ToolTip.Tip="Delete the selected entity (Delete).">
            <PathIcon Data="{x:Static shell:MaterialIcons.Delete}" />
          </Button>
          <Separator />
          <Button Classes="icon" Click="HandleMaterialsClick" ToolTip.Tip="Open the material editor.">
            <PathIcon Data="{x:Static shell:MaterialIcons.Materials}" />
          </Button>
          <Button Classes="icon bake" Command="{Binding Viewport.BakeProbesCommand}" ToolTip.Tip="Bake the irradiance volumes' probes with the View tab's lighting.">
            <PathIcon Data="{x:Static shell:MaterialIcons.Bake}" />
          </Button>
          <ToggleButton Classes="icon" IsChecked="{Binding Viewport.IsGameView}"
                        ToolTip.Tip="Game View (G): hides the grid, sky, icons, selection and gizmo to show the world as the game will.">
            <PathIcon Data="{x:Static shell:MaterialIcons.GameView}" />
          </ToggleButton>
        </StackPanel>
        <Button Grid.Column="1" Classes="icon play" Command="{Binding PlayCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Play (F5): runs the project's game on the scene as it is now, without saving it. Needs an open project.">
          <PathIcon Data="{x:Static shell:MaterialIcons.Play}" />
        </Button>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Viewport.SelectionText}" Margin="12,0,0,0" />
        <TextBlock Text="{Binding Viewport.Status}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="Shift+A over the viewport adds an entity at the camera's pivot. Alt+left drag orbits, Alt+middle drag pans, Alt+right drag or the wheel zooms; hold the right button to look round and fly with WASD, Q and E." />
      </DockPanel>
    </Border>
    <!-- The viewport over the content browser, and the side panel beside them: the scene outliner over the inspector and the
         View and Data tabs. Every splitter resizes. -->
    <Grid ColumnDefinitions="*,2,300">
      <Grid RowDefinitions="*,2,160">
        <Border Classes="well viewport">
        <Panel>
          <viewports:ViewportControl DataContext="{Binding Viewport}"
                                     controls:EditorMenus.AddChoices="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).AddChoices}" />
          <viewports:ViewportOverlay DataContext="{Binding Viewport}" />
        </Panel>
        </Border>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
        <assets:AssetBrowserView Grid.Row="2" DataContext="{Binding Assets}" />
      </Grid>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <Grid Grid.Column="2" RowDefinitions="*,2,*" Classes="sidePanel">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Scene" Classes="heading" />
          <Border Classes="well">
            <scenes:SceneTreeView x:Name="SceneTree" DataContext="{Binding SceneTree}"
                                  controls:EditorMenus.AddChoices="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).AddChoices}" />
          </Border>
        </DockPanel>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
        <TabControl x:Name="SidePanel" Grid.Row="2" Padding="0" SelectedIndex="{Binding SideTab}">
          <TabItem Header="Inspector">
            <inspector:InspectorView DataContext="{Binding Inspector}" />
          </TabItem>
          <TabItem Header="View">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{Binding MoodHeading}" Classes="heading"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="The lighting mood the viewport draws with. Open a mood file in the content browser to edit it." />
              <Border Classes="well">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding ViewSettings.Fields}" Margin="4,2">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="inspectorCore:FieldViewModel">
                      <Grid ColumnDefinitions="104,*" Margin="0,1">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ContentControl Grid.Column="1" Content="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              </Border>
            </DockPanel>
          </TabItem>
          <TabItem Header="Data">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{Binding DataHeading}" Classes="heading" TextTrimming="CharacterEllipsis" />
              <Border Classes="well">
                <data:DataView DataContext="{Binding DataContent}" />
              </Border>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
