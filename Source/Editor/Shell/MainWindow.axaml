<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="using:FlickerVoid.Editor.Data"
        xmlns:shell="using:FlickerVoid.Editor"
        xmlns:inspector="using:FlickerVoid.Editor.Inspector"
        xmlns:inspectorCore="using:FlickerVoid.Editor.Core.Inspector"
        xmlns:assets="using:FlickerVoid.Editor.Assets"
        xmlns:viewports="using:FlickerVoid.Editor.Viewports"
        xmlns:scenes="using:FlickerVoid.Editor.Scenes"
        xmlns:controls="using:FlickerVoid.Editor.Controls"
        xmlns:vehicles="using:FlickerVoid.Editor.Vehicles"
        xmlns:environments="using:FlickerVoid.Editor.Environments"
        xmlns:documents="using:FlickerVoid.Editor.Documents"
        x:Class="FlickerVoid.Editor.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        Title="{Binding Title}"
        Width="1280" Height="720"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="30">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveShownCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAssetsCommand}" />
    <KeyBinding Gesture="Ctrl+Space" Command="{Binding ToggleContentCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding PlayCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+F11" Command="{Binding CompileCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding Viewport.DuplicateSelectedCommand}" />
  </Window.KeyBindings>
  <Grid RowDefinitions="30,*,24">
    <!-- The top bar: the project's menu and the document tabs, the command search in the middle, then what is unsaved, undo,
         Compile and Play. The empty bar behind them drags the window, whose own buttons are drawn over its right end. -->
    <Border Classes="topBar">
      <Grid ColumnDefinitions="*,Auto,*">
        <Border Grid.ColumnSpan="3" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar" />
        <StackPanel Orientation="Horizontal">
          <Button Classes="quiet project" ToolTip.Tip="The project: open another, save, the material editor, the settings.">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Classes="logo" Data="{x:Static shell:LucideIcons.Logo}" />
              <TextBlock Text="{Binding ProjectName}" Classes="title" VerticalAlignment="Center" />
              <PathIcon Classes="small faint" Data="{x:Static shell:LucideIcons.Expand}" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Open project..." Click="HandleOpenProjectClick" ToolTip.Tip="Open another project; the editor reopens on it.">
                  <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.FolderOpen}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Save" InputGesture="Ctrl+S" Command="{Binding SaveShownCommand}"
                          ToolTip.Tip="Save what is shown: the scene, the creation's file in the creator, or the open document.">
                  <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.Save}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save assets" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAssetsCommand}" ToolTip.Tip="Save the edited materials, moods and other assets.">
                  <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.SaveAssets}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Discard asset edits" Command="{Binding DiscardAssetsCommand}" ToolTip.Tip="Forget the unsaved asset edits.">
                  <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.Discard}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Materials" Click="HandleMaterialsClick" ToolTip.Tip="Open the material editor in a tab.">
                  <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.Materials}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Project settings" Click="HandleProjectSettingsClick"
                          ToolTip.Tip="The graphics settings, kept in the project's Content/Settings.fvsettings.">
                  <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.Settings}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Bake light probes" Command="{Binding Viewport.BakeProbesCommand}"
                          ToolTip.Tip="Bake the irradiance volumes' probes with the viewport's lighting.">
                  <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.Bake}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Open in Visual Studio" Command="{Binding OpenInVisualStudioCommand}" ToolTip.Tip="Opens the project's solution. Needs an open project.">
                  <MenuItem.Icon><PathIcon Classes="filled" Data="{x:Static shell:LucideIcons.VisualStudio}" /></MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <!-- The document tabs (rule R6): the level, then every editor opened in place. -->
          <Button Classes="docTab" Classes.shown="{Binding Documents.IsLevelShown}" Command="{Binding Documents.ShowLevelCommand}"
                  ToolTip.Tip="The level's viewport; the open editors stay in their tabs.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static shell:LucideIcons.Scene}" />
              <TextBlock Text="{Binding LevelName}" VerticalAlignment="Center" />
              <Ellipse Classes="unsavedDot" IsVisible="{Binding IsLevelUnsaved}" ToolTip.Tip="The scene has unsaved edits (Ctrl+S)." />
            </StackPanel>
          </Button>
          <ListBox Classes="docTabs" ItemsSource="{Binding Documents.Documents}" SelectedItem="{Binding Documents.Selected}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="documents:EditorDocument">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{Binding Icon, Converter={x:Static shell:LucideIcons.ByName}}" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  <Button Classes="icon small" Margin="2,0,-4,0" Focusable="False"
                          Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).Documents.CloseCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="Close the tab; unsaved edits stay held until they are saved.">
                    <PathIcon Data="{x:Static shell:LucideIcons.Close}" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <Button Grid.Column="1" Classes="command" Click="HandleCommandClick" Focusable="False" ToolTip.Tip="Search every command and run it (Ctrl+K).">
          <DockPanel>
            <PathIcon DockPanel.Dock="Left" Classes="small" Data="{x:Static shell:LucideIcons.Search}" Margin="0,0,8,0" />
            <Border DockPanel.Dock="Right" Classes="kbd"><TextBlock Text="Ctrl K" /></Border>
            <TextBlock Text="Search or run a command" VerticalAlignment="Center" />
          </DockPanel>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Classes="quiet unsaved" Command="{Binding SaveEverythingCommand}" IsVisible="{Binding HasUnsavedChanges}" ToolTip.Tip="{Binding UnsavedTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static shell:LucideIcons.Unsaved}" />
              <TextBlock Text="{Binding UnsavedText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Classes="vsep" IsVisible="{Binding HasUnsavedChanges}" />
          <Button Classes="icon" Command="{Binding UndoCommand}" Focusable="False" ToolTip.Tip="{Binding UndoTip}">
            <PathIcon Data="{x:Static shell:LucideIcons.Undo}" />
          </Button>
          <Button Classes="icon" Command="{Binding RedoCommand}" Focusable="False" ToolTip.Tip="{Binding RedoTip}">
            <PathIcon Data="{x:Static shell:LucideIcons.Redo}" />
          </Button>
          <Border Classes="vsep" />
          <Button Classes="quiet" Command="{Binding CompileCommand}"
                  ToolTip.Tip="Compile (Ctrl+Alt+F11): builds the project's code again and reloads it, keeping the scene's unsaved edits. Needs an open project.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static shell:LucideIcons.Code}" />
              <TextBlock Text="Compile" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="primary" Command="{Binding PlayCommand}" Margin="2,0"
                  ToolTip.Tip="Play (F5): runs the project's game on the scene as it is now, without saving it. Needs an open project.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="solid" Data="{x:Static shell:LucideIcons.Play}" />
              <TextBlock Text="Play" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="icon" Click="HandleProjectSettingsClick" Margin="2,0,6,0"
                  ToolTip.Tip="Project Settings: the graphics settings, kept in the project's Content/Settings.fvsettings.">
            <PathIcon Data="{x:Static shell:LucideIcons.Settings}" />
          </Button>
          <!-- Room for the window's own three buttons, drawn over the bar's end. -->
          <Border Width="132" IsVisible="{Binding $parent[Window].IsExtendedIntoWindowDecorations}" IsHitTestVisible="False" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- The bottom strip: the docks' tabs, the last message, then the selection. -->
    <Border Grid.Row="2" Classes="strip">
      <DockPanel>
        <ToggleButton DockPanel.Dock="Left" Classes="stripTab" IsChecked="{Binding IsContentOpen}"
                      ToolTip.Tip="Open or close the content drawer (Ctrl+Space): the files of the project.">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{x:Static shell:LucideIcons.Folder}" />
            <TextBlock Text="Content" />
            <Border Classes="kbd"><TextBlock Text="Ctrl Space" /></Border>
          </StackPanel>
        </ToggleButton>
        <ToggleButton DockPanel.Dock="Left" Classes="stripTab" IsChecked="{Binding IsDayDockOpen, Mode=OneWay}" Command="{Binding ToggleDayDockCommand}"
                      ToolTip.Tip="Open or close the Day dock: the scene's environment over the day, edited under the viewport it lights.">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{x:Static shell:LucideIcons.Sun}" />
            <TextBlock Text="Day" />
          </StackPanel>
        </ToggleButton>
        <Border DockPanel.Dock="Right" Classes="stripCell">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Select}" />
            <TextBlock Text="{Binding Viewport.SelectionText}" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Viewport.Status}" Classes="muted" TextTrimming="CharacterEllipsis" Margin="12,0"
                   ToolTip.Tip="Shift+A over the viewport adds an entity at the camera's pivot. Alt+left drag orbits, Alt+middle drag pans, Alt+right drag or the wheel zooms; hold the right button to look round and fly with WASD, Q and E." />
      </DockPanel>
    </Border>
    <!-- The viewport over the docks, and the side column beside them: the context panel over the outliner, or under it once
         swapped. Every edge between them drags. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="{Binding SideWidth, Mode=TwoWay}" MinWidth="240" MaxWidth="900" />
      </Grid.ColumnDefinitions>
      <Grid RowDefinitions="*,Auto,Auto">
        <Panel>
        <ContentControl Content="{Binding Documents.Selected.Content}" IsVisible="{Binding !Documents.IsLevelShown}" />
        <Border Classes="well viewport" IsVisible="{Binding Documents.IsLevelShown}">
        <Panel>
          <viewports:ViewportControl DataContext="{Binding Viewport}"
                                     controls:EditorMenus.AddChoices="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).AddChoices}" />
          <viewports:ViewportOverlay DataContext="{Binding Viewport}" />
          <!-- While a creation is made: its file, carrying on in a copy of it, and the way back to the level. -->
          <Border Classes="viewportBar" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding Viewport.IsCreating}">
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0,0,0">
              <PathIcon Data="{x:Static shell:LucideIcons.Vehicle}" />
              <TextBlock Text="{Binding CreatorHeading}" VerticalAlignment="Center" FontWeight="Medium" Margin="2,0,4,0" />
              <Button Classes="viewportIcon text" Content="Duplicate and Edit" Command="{Binding DuplicateAndEditCommand}"
                      ToolTip.Tip="Carry on in a copy of the file, which this placed one then names; the first file keeps how it was saved." />
              <Button Classes="viewportIcon text" Content="Leave" Command="{Binding Viewport.LeaveCreatorCommand}"
                      ToolTip.Tip="Go back to the level (Escape, or a double-click beside the creation)." />
            </StackPanel>
          </Border>
        </Panel>
        </Border>
        </Panel>
        <!-- The Day dock: an opened environment's day, edited under the viewport it lights. -->
        <Panel Grid.Row="1" IsVisible="{Binding IsDayDockOpen}">
          <environments:EnvironmentEditorView x:Name="DayDock" DataContext="{Binding DayDock}"
                                              Height="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).DayDockHeight}" />
          <controls:HeightGrip Value="{Binding DayDockHeight}"><Border /></controls:HeightGrip>
        </Panel>
        <Panel Grid.Row="2" IsVisible="{Binding IsContentOpen}">
          <assets:AssetBrowserView DataContext="{Binding Assets}" Height="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).ContentHeight}" />
          <controls:HeightGrip Value="{Binding ContentHeight}"><Border /></controls:HeightGrip>
        </Panel>
      </Grid>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <Grid Grid.Column="2" RowDefinitions="*,1,*" Background="{DynamicResource EditorPanelBrush}">
        <!-- The context panel holds only what is selected or open, the newest in front; empty, it says how to fill it. -->
        <Panel Grid.Row="{Binding ContextRow}">
          <TextBlock Classes="hint" IsVisible="{Binding !HasContext}" TextWrapping="Wrap" Margin="12" VerticalAlignment="Top"
                     Text="Select an entity, or open a data asset or a vehicle in the content drawer, to edit it here." />
          <TabControl x:Name="SidePanel" SelectedIndex="{Binding SideTab}" IsVisible="{Binding HasContext}">
            <TabItem IsVisible="{Binding ShowsInspector}">
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <PathIcon Data="{x:Static shell:LucideIcons.Inspector}" />
                  <TextBlock Text="Inspector" />
                </StackPanel>
              </TabItem.Header>
              <inspector:InspectorView DataContext="{Binding Inspector}" />
            </TabItem>
            <TabItem IsVisible="{Binding ShowsData}">
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <PathIcon Data="{x:Static shell:LucideIcons.Data}" />
                  <TextBlock Text="{Binding DataTitle}" ToolTip.Tip="{Binding DataHeading}" />
                  <Button Classes="icon small" Margin="2,0,-4,0" Command="{Binding CloseDataCommand}" Focusable="False" ToolTip.Tip="Close the data asset; unsaved edits stay held.">
                    <PathIcon Data="{x:Static shell:LucideIcons.Close}" />
                  </Button>
                </StackPanel>
              </TabItem.Header>
              <data:DataView DataContext="{Binding DataContent}" />
            </TabItem>
            <TabItem IsVisible="{Binding ShowsCreator}">
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <PathIcon Data="{x:Static shell:LucideIcons.Vehicle}" />
                  <TextBlock Text="Vehicle" ToolTip.Tip="{Binding CreatorHeading}" />
                </StackPanel>
              </TabItem.Header>
              <vehicles:VehiclePanelView DataContext="{Binding CreatorPanel}" />
            </TabItem>
          </TabControl>
        </Panel>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
        <!-- The outliner: the scene's entities and the selection's whole tree, or the creation's parts in the creator, and the view's
             mood. Its corner button swaps it with the context panel. -->
        <Panel Grid.Row="{Binding OutlinerRow}">
          <TabControl x:Name="Outliner" SelectedIndex="{Binding OutlinerTab}">
            <TabItem IsVisible="{Binding !Viewport.IsCreating}">
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <PathIcon Data="{x:Static shell:LucideIcons.Scene}" />
                  <TextBlock Text="Scene" />
                </StackPanel>
              </TabItem.Header>
              <scenes:SceneTreeView x:Name="SceneTree" DataContext="{Binding SceneTree}"
                                    controls:EditorMenus.AddChoices="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).AddChoices}" />
            </TabItem>
            <TabItem IsVisible="{Binding !Viewport.IsCreating}">
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <PathIcon Data="{x:Static shell:LucideIcons.Network}" />
                  <TextBlock Text="Entity" ToolTip.Tip="{Binding EntityTree.Title, StringFormat='The whole tree of {0}'}" />
                </StackPanel>
              </TabItem.Header>
              <scenes:EntityTreeView x:Name="EntityTree" DataContext="{Binding EntityTree}" />
            </TabItem>
            <TabItem>
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <PathIcon Data="{x:Static shell:LucideIcons.Visible}" />
                  <TextBlock Text="View" />
                </StackPanel>
              </TabItem.Header>
              <DockPanel>
                <Border DockPanel.Dock="Top" Classes="entityHeader">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Border Classes="iconTile"><PathIcon Data="{x:Static shell:LucideIcons.Mood}" /></Border>
                    <TextBlock Grid.Column="1" Text="{Binding MoodHeading}" Classes="title" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="The lighting mood the viewport draws with. Open a mood file in the content drawer to edit it." />
                  </Grid>
                </Border>
                <ScrollViewer>
                  <Border Classes="sectionBody">
                    <StackPanel>
                      <Grid ColumnDefinitions="96,*" Margin="0,1" ToolTip.Tip="Draw the canvas the scene is painted on. Off hides it in the viewport only; the mood and lens keep it.">
                        <TextBlock Text="Canvas" Classes="fieldLabel" />
                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding Viewport.ShowCanvas}" HorizontalAlignment="Left" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding ViewSettings.Fields}" ItemTemplate="{StaticResource FieldRow}" />
                    </StackPanel>
                  </Border>
                </ScrollViewer>
              </DockPanel>
            </TabItem>
            <TabItem IsVisible="{Binding Viewport.IsCreating}">
              <TabItem.Header>
                <StackPanel Classes="tabHeader">
                  <PathIcon Data="{x:Static shell:LucideIcons.Layers}" />
                  <TextBlock Text="Parts" />
                </StackPanel>
              </TabItem.Header>
              <ListBox ItemsSource="{Binding CreatorParts}" SelectedItem="{Binding CreatorPart}" />
            </TabItem>
          </TabControl>
          <Button Classes="icon" Command="{Binding SwapPanelsCommand}" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="2" ToolTip.Tip="Swap the outliner and the context panel.">
            <PathIcon Data="{x:Static shell:LucideIcons.Swap}" />
          </Button>
        </Panel>
      </Grid>
    </Grid>
  </Grid>
</Window>
