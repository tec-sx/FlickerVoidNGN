<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:FlickerVoid.Engine.Editor.Shell"
        xmlns:inspector="using:FlickerVoid.Engine.Editor.Inspector"
        xmlns:assets="using:FlickerVoid.Engine.Editor.Assets"
        xmlns:viewports="using:FlickerVoid.Engine.Editor.Viewports"
        xmlns:scenes="using:FlickerVoid.Engine.Editor.Scenes"
        x:Class="FlickerVoid.Engine.Editor.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="720">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding Viewport.SaveCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding PlayCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ToggleButton Content="Select" IsChecked="{Binding Viewport.IsSelectMode}" ToolTip.Tip="Select (Q)" />
        <ToggleButton Content="Move" IsChecked="{Binding Viewport.IsMoveMode}" ToolTip.Tip="Move (W)" />
        <ToggleButton Content="Rotate" IsChecked="{Binding Viewport.IsRotateMode}" ToolTip.Tip="Rotate (E)" />
        <ToggleButton Content="Scale" IsChecked="{Binding Viewport.IsScaleMode}" ToolTip.Tip="Scale (R)" />
        <Separator Width="1" Margin="4,0" />
        <ToggleButton Content="Perspective" IsChecked="{Binding Viewport.IsPerspective}"
                      ToolTip.Tip="Perspective or orthographic view; both frame the same height at the pivot." />
        <ToggleButton Content="Grid" IsChecked="{Binding Viewport.ShowGrid}" />
        <Separator Width="1" Margin="4,0" />
        <DropDownButton Content="Add" ToolTip.Tip="Add an entity to the open scene at the camera's pivot.">
          <DropDownButton.Flyout>
            <MenuFlyout ItemsSource="{Binding Presets}">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="scenes:EntityPreset">
                  <Setter Property="Header" Value="{Binding Name}" />
                  <Setter Property="Command" Value="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).AddEntityCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button Content="Delete" Command="{Binding Viewport.DeleteSelectedCommand}" ToolTip.Tip="Delete the selected entity (Delete)." />
        <Separator Width="1" Margin="4,0" />
        <Button Content="Save" Command="{Binding Viewport.SaveCommand}" ToolTip.Tip="Save the scene (Ctrl+S)." />
        <Button Content="Play" Command="{Binding PlayCommand}"
                ToolTip.Tip="Play (F5): runs the project's game on the scene as it is now, without saving it. Needs an open project." />
        <Button Content="Bake Probes" Command="{Binding Viewport.BakeProbesCommand}" ToolTip.Tip="Bake the irradiance volumes' probes with the View tab's lighting." />
        <Button Content="Materials" Click="HandleMaterialsClick" ToolTip.Tip="Open the material editor." />
        <ToggleButton Content="Game View" IsChecked="{Binding Viewport.IsGameView}"
                      ToolTip.Tip="Game View (G): hides the grid, icons, selection and gizmo to show the world as the game will." />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="8,2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Viewport.SelectionText}" Margin="16,0,0,0" />
        <TextBlock Text="{Binding Viewport.Status}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="Alt+left drag orbits, Alt+middle drag pans, Alt+right drag or the wheel zooms; hold the right button to look round and fly with WASD, Q and E." />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Right" Width="380" BorderThickness="1,0,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TabControl Padding="0">
        <TabItem Header="Scene">
          <scenes:SceneTreeView DataContext="{Binding SceneTree}" />
        </TabItem>
        <TabItem Header="Inspector">
          <inspector:InspectorView DataContext="{Binding Inspector}" />
        </TabItem>
        <TabItem Header="View">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ViewSettings.Fields}" Margin="12,4,12,12">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="inspector:FieldViewModel">
                  <Grid ColumnDefinitions="130,*" Margin="0,2">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ContentControl Grid.Column="1" Content="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>
    <Grid RowDefinitions="*,4,240">
      <viewports:ViewportControl DataContext="{Binding Viewport}" />
      <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
      <assets:AssetBrowserView Grid.Row="2" DataContext="{Binding Assets}" />
    </Grid>
  </DockPanel>
</Window>
