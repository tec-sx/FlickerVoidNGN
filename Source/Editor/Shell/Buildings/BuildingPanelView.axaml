<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:FlickerVoid.Editor"
             xmlns:buildings="using:FlickerVoid.Editor.Assets.Buildings"
             x:Class="FlickerVoid.Editor.Buildings.BuildingPanelView"
             x:DataType="buildings:BuildingPanelViewModel">
  <!-- The building as a whole: its storeys, top first, the one being edited picked, added, duplicated and taken away; its parts are in the outliner's Parts tab. -->
  <ScrollViewer>
    <StackPanel>
      <ToggleButton Classes="section" IsChecked="True">
        <DockPanel>
          <PathIcon DockPanel.Dock="Left" Classes="muted" Data="{x:Static shell:LucideIcons.Layers}" Margin="20,0,7,0" />
          <TextBlock Text="Storeys" VerticalAlignment="Center" />
        </DockPanel>
      </ToggleButton>
      <Border Classes="sectionBody">
        <StackPanel Spacing="4">
          <ListBox ItemsSource="{Binding Storeys}" SelectedItem="{Binding Storey}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="buildings:BuildingStoreyItem">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <UniformGrid Rows="1">
            <Button Classes="toolAction" Command="{Binding AddStoreyAboveCommand}" Margin="0,0,4,0" ToolTip.Tip="Add a storey on top, its walls a copy of the top storey's.">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Add}" />
                <TextBlock Text="Above" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="toolAction" Command="{Binding AddCellarCommand}" Margin="0,0,4,0" ToolTip.Tip="Give the building a cellar under the ground floor.">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Steps}" />
                <TextBlock Text="Cellar" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="toolAction" Command="{Binding DuplicateStoreyCommand}" Margin="0,0,4,0" ToolTip.Tip="Add a copy of this storey on top, openings and all.">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Duplicate}" />
                <TextBlock Text="Copy" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="toolAction" Command="{Binding RemoveStoreyCommand}" ToolTip.Tip="Take this storey away; the ground floor stays.">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Delete}" />
                <TextBlock Text="Remove" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </UniformGrid>
          <TextBlock Classes="faint small" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Pick a storey to edit it here or in the viewport's storey switcher; the ones above it are hidden while you work on it. With nothing picked, the Tool tab shows the storey's height, walls, floor, light and corner pillars." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
