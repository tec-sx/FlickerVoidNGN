<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assets="using:FlickerVoid.Editor.Assets"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Assets.AssetBrowserView"
             x:DataType="assets:AssetBrowserViewModel">
  <UserControl.Resources>
    <ControlTheme x:Key="ChoiceItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="assets:AssetChoice">
      <Setter Property="Header" Value="{Binding Name}" />
      <Setter Property="Command" Value="{Binding Command}" />
    </ControlTheme>
    <MenuFlyout x:Key="NewMenu">
      <MenuItem Header="Folder" Command="{Binding CreateFolderCommand}" />
      <MenuItem Header="Scene" Command="{Binding CreateSceneCommand}" />
      <MenuItem Header="Material" Command="{Binding CreateMaterialCommand}" />
      <MenuItem Header="Mood" Command="{Binding CreateMoodCommand}" />
      <MenuItem Header="Flow" Command="{Binding CreateFlowCommand}" />
      <MenuItem Header="Data Asset" ItemsSource="{Binding DataChoices}" IsEnabled="{Binding !!DataChoices.Count}" ItemContainerTheme="{StaticResource ChoiceItem}" />
      <MenuItem Header="Table" ItemsSource="{Binding TableChoices}" IsEnabled="{Binding !!TableChoices.Count}" ItemContainerTheme="{StaticResource ChoiceItem}" />
    </MenuFlyout>
  </UserControl.Resources>
  <Grid ColumnDefinitions="160,2,*">
    <TreeView x:Name="FolderTree" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DragDrop.AllowDrop="True">
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="assets:AssetFolder" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent">
            <PathIcon Width="14" Height="14" Data="{x:Static shell:MaterialIcons.Folder}" Foreground="#DCBC98" />
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
      <TreeView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="New Folder" Command="{Binding CreateFolderCommand}" />
          <MenuItem Header="New Scene" Command="{Binding CreateSceneCommand}" />
          <MenuItem Header="New Material" Command="{Binding CreateMaterialCommand}" />
          <MenuItem Header="New Mood" Command="{Binding CreateMoodCommand}" />
          <MenuItem Header="New Flow" Command="{Binding CreateFlowCommand}" />
          <MenuItem Header="New Data Asset" ItemsSource="{Binding DataChoices}" IsEnabled="{Binding !!DataChoices.Count}" ItemContainerTheme="{StaticResource ChoiceItem}" />
          <MenuItem Header="New Table" ItemsSource="{Binding TableChoices}" IsEnabled="{Binding !!TableChoices.Count}" ItemContainerTheme="{StaticResource ChoiceItem}" />
          <Separator />
          <MenuItem Header="Rename Folder" Click="HandleRenameFolderClick" InputGesture="F2" />
          <MenuItem Header="Delete Folder" Click="HandleDeleteFolderClick" />
        </ContextMenu>
      </TreeView.ContextMenu>
    </TreeView>
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
    <DockPanel Grid.Column="2">
      <DockPanel DockPanel.Dock="Top" Margin="2,1">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
          <Button Classes="icon" ToolTip.Tip="Up to the parent folder" Command="{Binding UpCommand}">
            <PathIcon Data="{x:Static shell:MaterialIcons.Collapse}" />
          </Button>
          <Button Classes="icon" ToolTip.Tip="New folder, scene, material or mood" Flyout="{StaticResource NewMenu}">
            <PathIcon Data="{x:Static shell:MaterialIcons.New}" />
          </Button>
          <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
            <PathIcon Data="{x:Static shell:MaterialIcons.Refresh}" />
          </Button>
          <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Width="100">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="assets:AssetFilter">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox Text="{Binding SearchText}" PlaceholderText="Search" Width="160" />
          <TextBlock Text="{Binding SelectedFolder.Path}" VerticalAlignment="Center" Margin="6,0" Opacity="0.6" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0"
                   Foreground="{StaticResource EditorDeleteBrush}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <ListBox x:Name="AssetList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedAsset}" DragDrop.AllowDrop="True"
               DoubleTapped="HandleDoubleTapped" KeyDown="HandleKeyDown" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="1" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="assets:AssetEntry">
            <StackPanel Width="76" Spacing="2" ToolTip.Tip="{Binding Path}">
              <PathIcon Width="40" Height="40" Margin="0,4,0,0" Data="{Binding Kind, Converter={x:Static assets:AssetKindLooks.Icon}}"
                        Foreground="{Binding Kind, Converter={x:Static assets:AssetKindLooks.Brush}}" />
              <Border Height="2" Margin="6,0" Background="{Binding Kind, Converter={x:Static assets:AssetKindLooks.Brush}}" />
              <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                         FontSize="{StaticResource EditorSmallFontSize}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedAsset}" InputGesture="Enter" />
            <MenuItem Header="Rename" Click="HandleRenameClick" InputGesture="F2" />
            <MenuItem Header="Delete" Click="HandleDeleteClick" InputGesture="Delete" />
            <Separator />
            <MenuItem Header="New Folder" Command="{Binding CreateFolderCommand}" />
            <MenuItem Header="New Scene" Command="{Binding CreateSceneCommand}" />
            <MenuItem Header="New Material" Command="{Binding CreateMaterialCommand}" />
            <MenuItem Header="New Mood" Command="{Binding CreateMoodCommand}" />
            <MenuItem Header="New Flow" Command="{Binding CreateFlowCommand}" />
            <MenuItem Header="New Data Asset" ItemsSource="{Binding DataChoices}" IsEnabled="{Binding !!DataChoices.Count}" ItemContainerTheme="{StaticResource ChoiceItem}" />
            <MenuItem Header="New Table" ItemsSource="{Binding TableChoices}" IsEnabled="{Binding !!TableChoices.Count}" ItemContainerTheme="{StaticResource ChoiceItem}" />
          </ContextMenu>
        </ListBox.ContextMenu>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
