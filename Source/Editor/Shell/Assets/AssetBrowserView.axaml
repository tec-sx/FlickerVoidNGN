<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assets="using:FlickerVoid.Editor.Assets"
             xmlns:flows="using:FlickerVoid.Editor.Assets.Flows"
             xmlns:shell="using:FlickerVoid.Editor"
             xmlns:controls="using:FlickerVoid.Editor.Controls"
             x:Class="FlickerVoid.Editor.Assets.AssetBrowserView"
             x:DataType="assets:AssetBrowserViewModel">
  <!-- The folder tree under its search box, a narrow column of kind filters, and the tiles; everything else is in the context
       menus (right-click) and the New menu (Shift+A). -->
  <Grid ColumnDefinitions="170,2,Auto,*" controls:EditorMenus.AddChoices="{Binding NewChoices}">
    <DockPanel>
      <controls:SearchBox DockPanel.Dock="Top" Margin="3" Text="{Binding SearchText}"
                          ToolTip.Tip="Search every file below the selected folder." />
      <Border Classes="well">
      <TreeView x:Name="FolderTree" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DragDrop.AllowDrop="True">
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="assets:AssetFolder" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent">
              <PathIcon Width="14" Height="14" Data="{Binding Converter={x:Static assets:AssetTypeLooks.FolderIcon}}"
                        Foreground="{Binding Converter={x:Static assets:AssetTypeLooks.FolderBrush}}" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="New" ItemsSource="{Binding NewChoices, Converter={x:Static controls:MenuConverters.Separators}}"
                      ItemContainerTheme="{StaticResource ChoiceMenuItem}" InputGesture="Shift+A">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Add}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Import..." Click="HandleImportClick">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Import}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Rename Folder" Click="HandleRenameFolderClick" InputGesture="F2">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Rename}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete Folder" Click="HandleDeleteFolderClick" InputGesture="Delete">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Delete}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Refresh" Command="{Binding RefreshCommand}">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Refresh}" /></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </TreeView.ContextMenu>
      </TreeView>
      </Border>
    </DockPanel>
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
    <Border Grid.Column="2" Classes="well">
    <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Classes="filters"
             ToolTip.Tip="Show one kind of file, from every folder below the selected one.">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="assets:AssetFilter">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Panel Width="12" Height="12">
              <PathIcon Width="12" Height="12" Data="{Binding Type, Converter={x:Static assets:AssetTypeLooks.Icon}}"
                        Foreground="{Binding Type, Converter={x:Static assets:AssetTypeLooks.Brush}}"
                        IsVisible="{Binding Type, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Panel>
            <TextBlock Text="{Binding Label}" Classes="small" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </Border>
    <DockPanel Grid.Column="3">
      <DockPanel DockPanel.Dock="Top" Margin="6,2" Height="18">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" VerticalAlignment="Center" Margin="6,0"
                   Foreground="{StaticResource EditorDeleteBrush}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding SelectedFolder.Path}" VerticalAlignment="Center" Opacity="0.6" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <!-- Asks for a new flow node class's name and code folder; Enter creates it, Escape cancels. -->
      <Border DockPanel.Dock="Top" Margin="6,2" Padding="8" CornerRadius="5" BorderBrush="{StaticResource EditorLineBrush}" BorderThickness="1"
              IsVisible="{Binding Prompt, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel x:DataType="flows:FlowNodePrompt" DataContext="{Binding Prompt}" Orientation="Horizontal" Spacing="6"
                    KeyDown="HandlePromptKeyDown">
          <PathIcon Width="14" Height="14" Data="{x:Static shell:MaterialIcons.Code}" Foreground="#B48EC9" />
          <TextBlock Text="New Flow Node" VerticalAlignment="Center" FontWeight="SemiBold" />
          <TextBox x:Name="PromptName" Width="180" Text="{Binding Name}" PlaceholderText="Name, such as Open Gate" />
          <TextBlock Text="in" VerticalAlignment="Center" Opacity="0.6" />
          <ComboBox MinWidth="220" ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}"
                    ToolTip.Tip="The code folder the class goes in; its namespace follows the folder." />
          <Button Content="Create" Click="HandlePromptCreateClick" />
          <Button Content="Cancel" Click="HandlePromptCancelClick" />
        </StackPanel>
      </Border>
      <Border Classes="well">
      <ListBox x:Name="AssetList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedAsset}" DragDrop.AllowDrop="True"
               DoubleTapped="HandleDoubleTapped" KeyDown="HandleKeyDown" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="1" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="assets:AssetEntry">
            <StackPanel Width="76" Spacing="2" ToolTip.Tip="{Binding Path}">
              <PathIcon Width="40" Height="40" Margin="0,4,0,0" Data="{Binding Type, Converter={x:Static assets:AssetTypeLooks.Icon}}"
                        Foreground="{Binding Type, Converter={x:Static assets:AssetTypeLooks.Brush}}" />
              <Border Height="2" Margin="6,0" Background="{Binding Type, Converter={x:Static assets:AssetTypeLooks.Brush}}" />
              <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                         FontSize="{StaticResource EditorSmallFontSize}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedAsset}" InputGesture="Enter">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Open}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Reimport" Command="{Binding ReimportCommand}" IsEnabled="{Binding CanReimport}">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Reimport}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Rename" Click="HandleRenameClick" InputGesture="F2">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Rename}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete" Click="HandleDeleteClick" InputGesture="Delete">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Delete}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="New" ItemsSource="{Binding NewChoices, Converter={x:Static controls:MenuConverters.Submenus}}"
                      ItemContainerTheme="{StaticResource ChoiceMenuItem}" InputGesture="Shift+A">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Add}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Import..." Click="HandleImportClick">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Import}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Up" Command="{Binding UpCommand}" InputGesture="Back">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Up}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Refresh" Command="{Binding RefreshCommand}">
              <MenuItem.Icon><PathIcon Data="{x:Static shell:MaterialIcons.Refresh}" /></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </ListBox.ContextMenu>
      </ListBox>
      </Border>
    </DockPanel>
  </Grid>
</UserControl>
