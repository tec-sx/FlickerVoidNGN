<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:music="using:FlickerVoid.Editor.Music"
             xmlns:coremusic="using:FlickerVoid.Editor.Core.Music"
             xmlns:data="using:FlickerVoid.Editor.Data"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Music.MusicDockView"
             x:DataType="coremusic:MusicEditorViewModel">
  <!-- The dock under the lanes: the Mixer (a strip for each track of the cue and each bus, and the project's mix states) and the
       Clip (the selected clip's file, found tempo, length and what stretches it to the cue). -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="dockTabs">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="icon" ToolTip.Tip="Close the dock" Click="HandleClose"><PathIcon Data="{x:Static shell:LucideIcons.Close}" /></Button>
        <StackPanel Orientation="Horizontal">
          <ToggleButton Classes="stripTab" IsChecked="{Binding DockTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=0, Mode=OneWay}" Command="{Binding ShowMixerCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Mixer}" /><TextBlock Text="Mixer" /></StackPanel>
          </ToggleButton>
          <ToggleButton Classes="stripTab" IsChecked="{Binding DockTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=1, Mode=OneWay}" Command="{Binding ShowClipCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Waveform}" /><TextBlock Text="Clip" /></StackPanel>
          </ToggleButton>
          <ToggleButton Classes="stripTab" IsChecked="{Binding DockTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=2, Mode=OneWay}" Command="{Binding ShowLiveCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Music}" /><TextBlock Text="Live" /></StackPanel>
          </ToggleButton>
          <TextBlock Text="{Binding Status}" Classes="hint small" VerticalAlignment="Center" Margin="12,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding DockTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=0}">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
          <ItemsControl ItemsSource="{Binding Tracks}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="coremusic:MusicTrackViewModel">
                <Border Width="78" BorderBrush="{DynamicResource EditorLineBrush}" BorderThickness="0,0,1,0" Padding="4,4">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding GainText}" Classes="hint" HorizontalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" Margin="0,2">
                      <ToggleButton Classes="icon" Content="M" IsChecked="{Binding Muted, Mode=TwoWay}" Width="22" Height="20" Padding="0" FontSize="10.5" />
                      <ToggleButton Classes="icon" Content="S" IsChecked="{Binding Soloed, Mode=TwoWay}" Width="22" Height="20" Padding="0" FontSize="10.5" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,10">
                      <music:Fader Grid.Column="0" Decibels="{Binding GainDb, Mode=TwoWay}" Maximum="6" />
                      <music:LevelMeter Grid.Column="1" Vertical="True" Level="{Binding Level}" Margin="0,8" />
                    </Grid>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Width="1" Background="{DynamicResource EditorAccentLineBrush}" Margin="2,0" />
          <ItemsControl ItemsSource="{Binding Buses}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="coremusic:BusStripViewModel">
                <Border Width="78" BorderBrush="{DynamicResource EditorLineBrush}" BorderThickness="0,0,1,0" Padding="4,4">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding VolumeText}" Classes="hint" HorizontalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" Margin="0,2">
                      <ToggleButton Classes="icon" Content="M" IsChecked="{Binding Muted, Mode=TwoWay}" Width="22" Height="20" Padding="0" FontSize="10.5" />
                      <ToggleButton Classes="icon" Content="S" IsChecked="{Binding Soloed, Mode=TwoWay}" Width="22" Height="20" Padding="0" FontSize="10.5" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,10">
                      <music:Fader Grid.Column="0" Decibels="{Binding Decibels, Mode=TwoWay}" Maximum="0" />
                      <music:LevelMeter Grid.Column="1" Vertical="True" Level="{Binding Level}" Margin="0,8" />
                    </Grid>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Column="1" Width="420" BorderBrush="{DynamicResource EditorLineBrush}" BorderThickness="1,0,0,0" Padding="12,8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Classes="hint small" TextWrapping="Wrap" Text="{Binding StateHint}" Margin="0,6,0,0" />
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Classes="quiet" Command="{Binding EditMixCommand}"><TextBlock Text="Edit mix" /></Button>
            <TextBlock Text="MIX STATES" Classes="caps" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding MixStates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="coremusic:MixStateViewModel">
                  <Grid ColumnDefinitions="150,*" Height="23">
                    <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" Content="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Grid IsVisible="{Binding DockTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=1}" ColumnDefinitions="260,*" Margin="10,8">
      <StackPanel Grid.Column="0" Spacing="6" IsVisible="{Binding SelectedClip, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding SelectedClip.Track.Title}" Classes="heading" />
        <TextBlock Text="{Binding SelectedClip.Track.Track.Loop}" Classes="hint" TextTrimming="CharacterEllipsis" />
        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
          <TextBlock Grid.Row="0" Text="Found tempo" Classes="hint" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedFound}" />
          <TextBlock Grid.Row="1" Text="Length" Classes="hint" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedLength}" />
          <TextBlock Grid.Row="2" Text="Cue tempo" Classes="hint" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Tempo, StringFormat='{}{0} BPM'}" />
          <TextBlock Grid.Row="3" Text="Stretched to" Classes="hint" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedClip.Track.Track.Tempo, StringFormat='{}{0} BPM (0: off)'}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="quiet" Command="{Binding FitToCueCommand}"><TextBlock Text="Fit to the cue" /></Button>
          <Button Classes="quiet" Command="{Binding ClearStretchCommand}"><TextBlock Text="Don't stretch" /></Button>
        </StackPanel>
      </StackPanel>
      <TextBlock Grid.Column="0" Classes="hint" TextWrapping="Wrap" Text="Click a clip in a lane to see its file, found tempo and length here. Drag a loop's right edge to cut its length and its top corners for the fades."
                 IsVisible="{Binding SelectedClip, Converter={x:Static ObjectConverters.IsNull}}" />
      <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="3" ClipToBounds="True">
        <music:ClipWave Editor="{Binding}" />
      </Border>
    </Grid>
    <ScrollViewer IsVisible="{Binding DockTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=2}">
      <StackPanel Margin="12,8" Spacing="2">
        <TextBlock Text="{Binding LayersText}" Classes="hint small" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding LiveRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="coremusic:LiveRowViewModel">
              <Grid ColumnDefinitions="18,200,*" Margin="0,3">
                <Ellipse Grid.Column="0" Width="9" Height="9" HorizontalAlignment="Left" Stroke="{DynamicResource EditorAccentBrush}" StrokeThickness="1.5" Fill="{DynamicResource EditorAccentBrush}" Opacity="{Binding IsOn, Converter={x:Static music:LiveDotConverter.Instance}}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                <TextBlock Grid.Column="2" Text="{Binding State}" Classes="hint" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="hint small" TextWrapping="Wrap" Margin="0,8,0,0" Text="What each layer is doing right now: sounding, waiting for an area or for its hours, or asked by a script. Click the ruler to jump to a bar and play to hear the fills." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
