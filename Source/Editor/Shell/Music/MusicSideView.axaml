<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:music="using:FlickerVoid.Editor.Music"
             xmlns:coremusic="using:FlickerVoid.Editor.Core.Music"
             xmlns:data="using:FlickerVoid.Editor.Data"
             xmlns:dataCore="using:FlickerVoid.Editor.Core.Data"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Music.MusicSideView"
             x:DataType="coremusic:MusicEditorViewModel">
  <!-- The music editor's side column, in place of the context panel and the outliner while its tab is shown: the Track and Cue tabs
       over the lists of Sounds and Cues to drag in. -->
  <Border Classes="well">
    <Grid RowDefinitions="*,1,260">
      <DockPanel Grid.Row="0">
        <Border DockPanel.Dock="Top" Classes="dockTabs">
          <StackPanel Orientation="Horizontal">
            <ToggleButton Classes="stripTab" IsChecked="{Binding SideTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=0, Mode=OneWay}" Click="HandleTrackTab">
              <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Waveform}" /><TextBlock Text="Track" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="stripTab" IsChecked="{Binding SideTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=1, Mode=OneWay}" Click="HandleCueTab">
              <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Music}" /><TextBlock Text="Cue" /></StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>
        <ScrollViewer IsVisible="{Binding SideTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=0}">
          <StackPanel Margin="8,6" Spacing="4">
            <Border Classes="entityHeader" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
              <DockPanel>
                <Border DockPanel.Dock="Left" Classes="iconTile"><PathIcon Data="{x:Static shell:LucideIcons.Waveform}" /></Border>
                <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Selected.Title}" Classes="title" />
                  <TextBlock Text="{Binding Selected.PlaysText}" Classes="hint small" />
                </StackPanel>
              </DockPanel>
            </Border>
            <TextBlock Classes="hint" Text="Select a track in the lanes to edit it here." IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}" />
            <ItemsControl ItemsSource="{Binding Selected.Forms}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="dataCore:DataObjectViewModel">
                  <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="{Binding Title}" Classes="caps" Margin="0,8,0,3" />
                    <data:DataView DataContext="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="quiet delete" Command="{Binding RemoveSelectedCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Delete}" /><TextBlock Text="Remove track" /></StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding SideTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=1}">
          <StackPanel Margin="8,6" Spacing="4">
            <Border Classes="entityHeader">
              <DockPanel>
                <Border DockPanel.Dock="Left" Classes="iconTile"><PathIcon Data="{x:Static shell:LucideIcons.Music}" /></Border>
                <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Title}" Classes="title" />
                  <TextBlock Text="{Binding Path}" Classes="hint small" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Border>
            <TextBlock Text="CUE" Classes="caps" Margin="0,8,0,3" />
            <data:DataView DataContext="{Binding Cue}" />
            <DockPanel Margin="0,10,0,3">
              <Button DockPanel.Dock="Right" Classes="icon" ToolTip.Tip="Add a notifier at the playhead" Command="{Binding AddNotifierCommand}"><PathIcon Data="{x:Static shell:LucideIcons.Add}" /></Button>
              <TextBlock Text="NOTIFIERS" Classes="caps" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="hint small" TextWrapping="Wrap" Text="A notifier is a named point on the phrase. Every time the music passes it the game gets a MusicNotifyEvent with its name, to flash a light on the snare or open a door on the drop. Double-click the Notifiers row to add one." />
            <ItemsControl ItemsSource="{Binding Notifiers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="coremusic:NotifierViewModel">
                  <Grid ColumnDefinitions="*,6,56,4,Auto" Margin="0,2">
                    <TextBox Grid.Column="0" Text="{Binding Name}" />
                    <TextBox Grid.Column="2" Text="{Binding Bar}" ToolTip.Tip="The bar of the phrase" />
                    <Button Grid.Column="4" Classes="icon delete" Click="HandleRemoveNotifier"><PathIcon Data="{x:Static shell:LucideIcons.Delete}" /></Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
      <Border Grid.Row="1" Background="{DynamicResource EditorLineBrush}" />
      <DockPanel Grid.Row="2">
        <Border DockPanel.Dock="Top" Classes="dockTabs">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="icon" ToolTip.Tip="Import sound files into Content" Click="HandleImport"><PathIcon Data="{x:Static shell:LucideIcons.Import}" /></Button>
            <StackPanel Orientation="Horizontal">
              <ToggleButton Classes="stripTab" IsChecked="{Binding ListTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=0, Mode=OneWay}" Click="HandleSoundsTab">
                <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Waveform}" /><TextBlock Text="Sounds" /></StackPanel>
              </ToggleButton>
              <ToggleButton Classes="stripTab" IsChecked="{Binding ListTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=1, Mode=OneWay}" Click="HandleCuesTab">
                <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Music}" /><TextBlock Text="Cues" /></StackPanel>
              </ToggleButton>
            </StackPanel>
          </DockPanel>
        </Border>
        <TextBox DockPanel.Dock="Top" Classes="search row" Watermark="Search sounds" Text="{Binding Search}" Margin="6,4" />
        <TextBlock DockPanel.Dock="Bottom" Classes="hint small" TextWrapping="Wrap" Margin="10,4" Text="Drag a sound onto a lane, or drop sound files from the disk to import them. A loop at another tempo is stretched to the cue without changing its pitch." />
        <ListBox ItemsSource="{Binding Sounds}" IsVisible="{Binding ListTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=0}" DoubleTapped="HandleSoundDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="coremusic:SoundItem">
              <DockPanel Background="Transparent" PointerPressed="HandleItemPressed" PointerMoved="HandleItemMoved" ToolTip.Tip="{Binding Path}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Classes="hint small" VerticalAlignment="Center" />
                <PathIcon Classes="small" DockPanel.Dock="Left" Margin="0,0,7,0" Data="{x:Static shell:LucideIcons.Waveform}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox ItemsSource="{Binding Cues}" IsVisible="{Binding ListTab, Converter={x:Static music:DockTabConverter.Instance}, ConverterParameter=1}" DoubleTapped="HandleCueDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="coremusic:SoundItem">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Music}" />
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding Path}" Classes="hint small" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </Border>
</UserControl>
