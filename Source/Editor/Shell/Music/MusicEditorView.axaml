<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:music="using:FlickerVoid.Editor.Music"
             xmlns:mix="using:FlickerVoid.Editor.Controls.Mix"
             xmlns:timelines="using:FlickerVoid.Editor.Controls.Timelines"
             xmlns:coremusic="using:FlickerVoid.Editor.Core.Music"
             xmlns:shell="using:FlickerVoid.Editor"
             xmlns:controls="using:FlickerVoid.Editor.Controls"
             x:Class="FlickerVoid.Editor.Music.MusicEditorView"
             x:DataType="coremusic:MusicEditorViewModel">
  <!-- An arrangement as a DAW: the transport on top, the ruler, the rehearsal rows, the cues and a lane per layer beside their
       headers (icon, name, mute, solo, when it plays, gain and meter), and under them the dock with the mixer and the selected
       clip. The values of the selected layer and of the arrangement, and the lists of sounds and arrangements, are in the side
       column. -->
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource EditorDeepBrush}">
    <timelines:Transport Grid.Row="0" Source="{Binding}">
      <timelines:Transport.Tools>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Border Classes="chip" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="small faint" Data="{x:Static shell:LucideIcons.Waveform}" />
              <TextBlock Classes="hint" Text="{Binding LayersText}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border x:Name="AudioReadout" Classes="chip" Margin="0,0,6,0" ToolTip.Tip="{Binding AudioTip}"
                  IsVisible="{Binding AudioText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="small faint" Data="{x:Static shell:LucideIcons.Activity}" />
              <TextBlock Classes="hint" Text="{Binding AudioText}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Classes="stripCell" Margin="0,0,6,0"
                  ToolTip.Tip="How much sound the device takes at a time. Longer plays clean while the editor is busy; shorter answers Play and triggers sooner.">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Buffer" Classes="hint" VerticalAlignment="Center" />
              <ComboBox x:Name="BufferBox" ItemsSource="{Binding BufferOptions}" SelectedItem="{Binding BufferFrames}" MinWidth="72" />
              <TextBlock Text="{Binding BufferText}" Classes="hint" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Classes="vsep" />
          <Button Classes="icon" ToolTip.Tip="Zoom out" Command="{Binding ZoomOutCommand}"><PathIcon Data="{x:Static shell:LucideIcons.ZoomOut}" /></Button>
          <Button Classes="icon" ToolTip.Tip="Zoom in" Command="{Binding ZoomInCommand}"><PathIcon Data="{x:Static shell:LucideIcons.ZoomIn}" /></Button>
          <Button Classes="icon" ToolTip.Tip="Fit every bar into the window" Click="HandleFit"><PathIcon Data="{x:Static shell:LucideIcons.Fit}" /></Button>
        </StackPanel>
      </timelines:Transport.Tools>
      <timelines:Transport.Fields>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="transportField">
            <StackPanel>
              <TextBlock Classes="name" Text="Tempo" />
              <TextBox Text="{Binding Tempo}" Width="24" />
              <TextBlock Text="BPM" />
            </StackPanel>
          </Border>
          <Border Classes="transportField" IsVisible="{Binding IsHours}">
            <StackPanel>
              <TextBlock Classes="name" Text="Ruler" />
              <TextBlock Text="Hours of the day" />
            </StackPanel>
          </Border>
          <Border Classes="transportField" IsVisible="{Binding IsHours}"
                  ToolTip.Tip="How fast the day passes while this plays, so the layers that keep hours come and go. Held, the hour under the playhead stays.">
            <StackPanel>
              <TextBlock Classes="name" Text="Day runs" />
              <ComboBox x:Name="DayPaceBox" ItemsSource="{Binding DayPaces}" SelectedItem="{Binding DayPace}" />
            </StackPanel>
          </Border>
          <Border Classes="transportField" IsVisible="{Binding !IsHours}">
            <StackPanel>
              <TextBlock Classes="name" Text="Meter" />
              <TextBox Text="{Binding BeatsPerBar}" Width="12" />
              <TextBlock Text="/ 4" />
            </StackPanel>
          </Border>
          <Border Classes="transportField" IsVisible="{Binding !IsHours}">
            <StackPanel>
              <TextBlock Classes="name" Text="Phrase" />
              <TextBox Text="{Binding PhraseBars}" Width="16" />
              <TextBlock Text="bars" />
            </StackPanel>
          </Border>
          <Border Classes="transportField" IsVisible="{Binding !IsHours}">
            <StackPanel>
              <TextBlock Classes="name" Text="Snap" />
              <ComboBox ItemsSource="{Binding SnapOptions}" SelectedItem="{Binding Snap}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </timelines:Transport.Fields>
    </timelines:Transport>

    <Grid Grid.Row="1">
      <!-- The wheel zooms the bars over the lanes, Ctrl with it the lanes' height and Shift pans; over the headers it scrolls. -->
      <ScrollViewer x:Name="LanesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="LanesContent" ColumnDefinitions="220,*">
          <!-- Over the lanes, so the last row's words may run on past the headers, and held at the left as the lanes scroll. -->
          <StackPanel x:Name="Headers" Grid.Column="0" Background="{DynamicResource EditorPanelBrush}" ZIndex="1">
            <Border Height="24" Padding="10,0" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource EditorLineBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Classes="small faint" Data="{x:Static shell:LucideIcons.Music}" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="RulerText" Text="{Binding RulerText}" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="coremusic:RehearsalRow">
                  <Border Height="22" Padding="10,0" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource EditorLineBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <PathIcon Classes="small faint" Data="{x:Static shell:LucideIcons.Tag}" />
                      <TextBlock Text="{Binding Label}" Classes="hint" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="22" Padding="10,0" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource EditorLineBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Classes="small faint" Data="{x:Static shell:LucideIcons.Cue}" />
                <TextBlock Text="Cues" Classes="hint" />
                <Button Classes="icon small" ToolTip.Tip="Add a cue at the playhead (or double-click its row)" Command="{Binding AddNotifierCommand}"><PathIcon Data="{x:Static shell:LucideIcons.Add}" /></Button>
              </StackPanel>
            </Border>
            <ItemsControl x:Name="LayerHeaders" ItemsSource="{Binding Tracks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="coremusic:MusicTrackViewModel">
                  <Border Classes="laneHeader" Classes.selected="{Binding IsSelected}" ClipToBounds="True"
                          Height="{Binding $parent[ItemsControl].((coremusic:MusicEditorViewModel)DataContext).LaneHeight}"
                          Tapped="HandleHeaderTapped" ContextRequested="HandleHeaderMenu">
                    <Border.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem Header="Move layer up" Click="HandleMoveLayerUp">
                          <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.Up}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Move layer down" Click="HandleMoveLayerDown">
                          <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.Expand}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remove layer" InputGesture="Delete" Click="HandleRemoveLayer">
                          <MenuItem.Icon><PathIcon Data="{x:Static shell:LucideIcons.Delete}" /></MenuItem.Icon>
                        </MenuItem>
                      </MenuFlyout>
                    </Border.ContextFlyout>
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="3" Background="{Binding Index, Converter={x:Static music:LayerTint.Brush}}" />
                      <StackPanel Spacing="4" Margin="9,6,8,6">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3">
                            <ToggleButton Classes="icon" Content="M" IsChecked="{Binding Muted, Mode=TwoWay}" ToolTip.Tip="Mute" Width="22" Height="20" Padding="0" FontSize="10.5" />
                            <ToggleButton Classes="icon" Content="S" IsChecked="{Binding Soloed, Mode=TwoWay}" ToolTip.Tip="Solo" Width="22" Height="20" Padding="0" FontSize="10.5" />
                          </StackPanel>
                          <PathIcon Classes="small" DockPanel.Dock="Left" Margin="0,0,6,0" Data="{Binding Icon, Converter={x:Static shell:LucideIcons.ByName}}"
                                    Foreground="{Binding Index, Converter={x:Static music:LayerTint.Brush}}" />
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    IsVisible="{Binding $parent[ItemsControl].((coremusic:MusicEditorViewModel)DataContext).ShowsLaneDetails}">
                          <Border Classes="chip" ToolTip.Tip="When the layer plays">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <PathIcon Classes="small faint" Data="{Binding PlaysIcon, Converter={x:Static shell:LucideIcons.ByName}}" />
                              <TextBlock Classes="hint small" Text="{Binding PlaysText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="104" />
                            </StackPanel>
                          </Border>
                          <Border Classes="chip outline" ToolTip.Tip="How the layer comes in"
                                  IsVisible="{Binding StartText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="hint small" Text="{Binding StartText}" VerticalAlignment="Center" />
                          </Border>
                          <Border Classes="chip outline" IsVisible="{Binding IsStretched}" ToolTip.Tip="Its loop is at another tempo and is stretched to the arrangement's.">
                            <TextBlock Classes="hint small" Text="stretched" VerticalAlignment="Center" />
                          </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,6,36" Height="18">
                          <mix:GainBar Grid.Column="0" Decibels="{Binding GainDb, Mode=TwoWay}" />
                          <mix:LevelMeter Grid.Column="2" Level="{Binding Level}" Height="18" />
                        </Grid>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="6,6,0,0">
              <Button x:Name="AddLayerButton" Classes="quiet" Command="{Binding AddTrackCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="small accent" Data="{x:Static shell:LucideIcons.Add}" />
                  <TextBlock Text="Add layer" />
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsHitTestVisible="False">
                <PathIcon Classes="small faint" Data="{x:Static shell:LucideIcons.Import}" />
                <TextBlock Classes="hint" Text="or drop loops from Content" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <music:MusicLanes x:Name="Lanes" Grid.Column="1" Editor="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
      </ScrollViewer>
      <TextBlock Classes="hint small" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,10" MaxWidth="420" TextWrapping="Wrap" TextAlignment="Right"
                 Text="The Rehearsal rows stand in for the level: drag a span to walk in and out, and the lanes show what the game will play. Hatched clips are fills, dashed gaps a layer waiting for its bar." />
      <TextBlock Classes="hint small" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="236,0,0,10" Text="{Binding Problem}" Foreground="{DynamicResource EditorDeleteBrush}" />
    </Grid>

    <!-- The dock's top line is its grip, which drags its height. -->
    <Panel Grid.Row="2" IsVisible="{Binding DockOpen}">
      <Border x:Name="Dock" Height="{Binding DockHeight}" Background="{DynamicResource EditorPanelBrush}">
        <music:MusicDockView DataContext="{Binding}" />
      </Border>
      <controls:HeightGrip x:Name="DockGrip" Value="{Binding DockHeight}" Minimum="160"><Border /></controls:HeightGrip>
    </Panel>
  </Grid>
</UserControl>
