<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:music="using:FlickerVoid.Editor.Music"
             xmlns:coremusic="using:FlickerVoid.Editor.Core.Music"
             xmlns:data="using:FlickerVoid.Editor.Data"
             xmlns:dataCore="using:FlickerVoid.Editor.Core.Data"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Music.MusicEditorView"
             x:DataType="coremusic:MusicEditorViewModel">
  <!-- A music cue as lanes: a row per track with its clips beside a header, the rehearsal that stands for the game's areas above
       them, and the selected track's values and the cue's own in the side panel. -->
  <Grid ColumnDefinitions="*,1,300">
    <Border Grid.Column="0" Classes="well">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="searchRow">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="quiet" Command="{Binding AddTrackCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Add}" />
                <TextBlock Text="Track" />
              </StackPanel>
            </Button>
            <Button Classes="icon" ToolTip.Tip="Move up" Command="{Binding MoveUpCommand}">
              <PathIcon Data="{x:Static shell:LucideIcons.Collapse}" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="Move down" Command="{Binding MoveDownCommand}">
              <PathIcon Data="{x:Static shell:LucideIcons.Expand}" />
            </Button>
            <Button Classes="icon delete" ToolTip.Tip="Remove track" Command="{Binding RemoveSelectedCommand}">
              <PathIcon Data="{x:Static shell:LucideIcons.Delete}" />
            </Button>
          </StackPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid ColumnDefinitions="180,*">
            <StackPanel Grid.Column="0" Margin="0,24,0,0">
              <Border Height="22" Padding="8,0" BorderThickness="0,1,1,1" BorderBrush="{DynamicResource EditorLineBrush}">
                <TextBlock Text="Rehearsal" Classes="hint" VerticalAlignment="Center" />
              </Border>
              <ItemsControl ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="coremusic:MusicTrackViewModel">
                    <Border Height="72" Padding="8,6" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource EditorLineBrush}"
                            Background="Transparent" Tapped="HandleHeaderTapped">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Classes="hint" Text="{Binding Track.Loop}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="hint" Text="By request" IsVisible="{Binding ByRequest}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <music:MusicLanes Grid.Column="1" Editor="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
    <Border Grid.Column="2" Classes="well">
      <ScrollViewer Padding="8">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Selected.Title, FallbackValue='Select a track'}" Classes="heading" />
          <ItemsControl ItemsSource="{Binding Selected.Forms}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="dataCore:DataObjectViewModel">
                <StackPanel Margin="0,0,0,6">
                  <TextBlock Text="{Binding Title}" Classes="hint" Margin="0,4,0,2" />
                  <data:DataView DataContext="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Cue" Classes="heading" Margin="0,8,0,0" />
          <data:DataView DataContext="{Binding Cue}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
