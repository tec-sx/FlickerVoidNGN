<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menus="using:FlickerVoid.Editor.Core.Menus"
             xmlns:controls="using:FlickerVoid.Editor.Controls"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Controls.SearchMenu"
             x:DataType="menus:SearchMenuViewModel"
             Width="240">
  <!-- Type to search, Up and Down to choose, Enter to run or open a group, Escape to close. -->
  <DockPanel>
    <controls:SearchBox x:Name="Search" DockPanel.Dock="Top" Margin="4" Text="{Binding SearchText}" />
    <ListBox x:Name="Rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Classes="menuRows"
             MaxHeight="{StaticResource EditorMenuMaxHeight}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="menus:MenuRow">
          <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="menus:MenuRow">
          <Panel>
            <TextBlock Classes="menuHeading" Text="{Binding Text}" IsVisible="{Binding IsHeading}" />
            <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="6" IsVisible="{Binding !IsHeading}" Background="Transparent">
              <Panel Width="14" Height="14">
                <PathIcon Width="14" Height="14" Data="{Binding Icon, Converter={x:Static shell:MaterialIcons.ByName}}"
                          IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <PathIcon Width="14" Height="14" Data="{x:Static shell:MaterialIcons.Back}" IsVisible="{Binding IsBack}" />
                <PathIcon Width="14" Height="14" Data="{x:Static shell:MaterialIcons.Folder}" IsVisible="{Binding IsGroup}" />
              </Panel>
              <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Detail}" Classes="menuDetail" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding Gesture}" Classes="menuDetail" IsVisible="{Binding Gesture, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <PathIcon Width="12" Height="12" Data="{x:Static shell:MaterialIcons.Next}" IsVisible="{Binding IsGroup}" />
              </StackPanel>
            </Grid>
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
