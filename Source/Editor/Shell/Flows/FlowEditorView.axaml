<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:flows="using:FlickerVoid.Editor.Core.Flows"
             xmlns:shellflows="using:FlickerVoid.Editor.Flows"
             xmlns:data="using:FlickerVoid.Editor.Data"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Flows.FlowEditorView"
             x:DataType="flows:FlowGraphViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedCommand}" />
  </UserControl.KeyBindings>
  <Grid>
    <!-- The endless canvas: drag with the right or middle button to pan, the wheel zooms, F frames the selected node (or all),
         Shift+A adds a node, right-click offers what can be done there, drag a node to move it, drag from a pin to wire it, or
         onto empty space to add a node wired to it. The pill and the minimap float over it, outside the surface that reads the mouse. -->
    <Border Classes="well viewport">
      <Panel>
        <Panel x:Name="Surface" ClipToBounds="True" Background="Transparent" Focusable="True">
          <shellflows:FlowGrid View="{Binding View}" IsHitTestVisible="False" />
          <Panel x:Name="Canvas" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1" Height="1" RenderTransformOrigin="0,0">
            <shellflows:FlowWires x:Name="Wires" Graph="{Binding}" IsHitTestVisible="False" />
            <ItemsControl ItemsSource="{Binding Nodes}" ClipToBounds="False">
              <!-- No border: nodes stand anywhere on the endless canvas, outside the control's own bounds. -->
              <ItemsControl.Template>
                <ControlTemplate>
                  <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" ClipToBounds="False" />
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter" x:DataType="flows:FlowNodeViewModel">
                  <Setter Property="Canvas.Left" Value="{Binding X}" />
                  <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </ControlTheme>
              </ItemsControl.ItemContainerTheme>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="flows:FlowNodeViewModel">
                  <Panel Width="200" Height="{Binding Height}">
                    <Border Classes="flowNode" Classes.selected="{Binding IsSelected}">
                      <StackPanel>
                        <Border Classes="flowHeader" Background="{Binding Kind, Converter={x:Static shellflows:FlowNodeBrushes.Header}}">
                          <DockPanel>
                            <PathIcon DockPanel.Dock="Left" Classes="small" Margin="0,0,7,0"
                                      Data="{Binding Icon, Converter={x:Static shell:LucideIcons.ByName}}"
                                      Foreground="{Binding Kind, Converter={x:Static shellflows:FlowNodeBrushes.Icon}}" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </Border>
                        <Border Height="{Binding BodyHeight}" ClipToBounds="True" Padding="10,6,10,0">
                          <StackPanel>
                            <TextBlock Text="{Binding DescriptionLead}" FontWeight="SemiBold"
                                       IsVisible="{Binding DescriptionLead, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding DescriptionText}" Classes="muted" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxLines="{Binding DescriptionLines}" ToolTip.Tip="{Binding Description}" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                    <!-- The pins stand outside the border, so its rounded clip does not cut the half of them that hangs over the edge. -->
                    <Grid ColumnDefinitions="*,*" VerticalAlignment="Bottom" Margin="0,0,0,3">
                      <ItemsControl ItemsSource="{Binding Inputs}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="flows:FlowPinViewModel">
                            <StackPanel Orientation="Horizontal" Height="22" Spacing="0" Margin="-11,0,0,0" Background="Transparent">
                              <Panel Classes="pinTarget" Width="22" Height="22" Background="Transparent" Cursor="Hand"
                                     ToolTip.Tip="Drag to wire, or onto empty space to add a node; right-click for options">
                              </Panel>
                              <TextBlock Text="{Binding Name}" Classes="small muted" VerticalAlignment="Center" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Outputs}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="flows:FlowPinViewModel">
                            <StackPanel Orientation="Horizontal" Height="22" Spacing="0" Margin="0,0,-11,0"
                                        HorizontalAlignment="Right" Background="Transparent">
                              <TextBlock Text="{Binding Name}" Classes="small muted" VerticalAlignment="Center" />
                              <Panel Classes="pinTarget" Width="22" Height="22" Background="Transparent" Cursor="Hand"
                                     ToolTip.Tip="Drag to wire, or onto empty space to add a node; right-click for options">
                              </Panel>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <shellflows:FlowWires x:Name="Pins" Graph="{Binding}" DrawsPins="True" IsHitTestVisible="False" />
          </Panel>
        </Panel>
        <Border Classes="viewportBar" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
          <StackPanel Orientation="Horizontal">
            <Button Classes="viewportIcon text" Click="HandleAddNodeClick" ToolTip.Tip="Add a node (Shift+A)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Add}" />
                <TextBlock Text="Add node" VerticalAlignment="Center" />
                <Border Classes="kbd"><TextBlock Text="Shift A" /></Border>
              </StackPanel>
            </Button>
            <Border Classes="vsep" Margin="4,0" />
            <Button Classes="viewportIcon" Click="HandleFitClick" ToolTip.Tip="Frame the selected node, or every node (F)">
              <PathIcon Data="{x:Static shell:LucideIcons.Fit}" />
            </Button>
            <TextBlock Text="{Binding View.ZoomText}" Classes="muted" VerticalAlignment="Center" Margin="2,0,8,0" MinWidth="34" />
          </StackPanel>
        </Border>
        <Border Classes="minimap" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
          <shellflows:FlowMinimap x:Name="Map" Graph="{Binding}" />
        </Border>
      </Panel>
    </Border>
  </Grid>
</UserControl>
