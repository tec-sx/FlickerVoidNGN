<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scenes="using:FlickerVoid.Editor.Core.Scenes"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Scenes.SceneTreeView"
             x:DataType="scenes:SceneTreeViewModel">
  <!-- Folders and entities with their icons; Ctrl or Shift picks several, a folder selects everything in it, and dragged items
       drop into a folder (or onto the empty space below, to the top). Right-click for options. -->
  <TreeView x:Name="Tree" ItemsSource="{Binding Items}" SelectionMode="Multiple" Classes="outline" DragDrop.AllowDrop="True">
    <TreeView.ItemContainerTheme>
      <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="scenes:SceneTreeItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      </ControlTheme>
    </TreeView.ItemContainerTheme>
    <TreeView.ItemTemplate>
      <TreeDataTemplate DataType="scenes:SceneTreeItem" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" Spacing="5" Background="Transparent">
          <PathIcon Width="13" Height="13" Data="{Binding Icon, Converter={x:Static shell:MaterialIcons.ByName}}"
                    Classes="outlineIcon" Classes.folder="{Binding IsFolder}" />
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
        </StackPanel>
      </TreeDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
</UserControl>
