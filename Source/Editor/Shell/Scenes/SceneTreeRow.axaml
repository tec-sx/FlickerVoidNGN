<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scenes="using:FlickerVoid.Editor.Core.Scenes"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Scenes.SceneTreeRow"
             x:DataType="scenes:SceneTreeItem">
  <!-- An outline row: icon, name and how many items it holds, nested entities in their own colour, hidden ones faded; at the
       far right, under the pointer or on the selected row, the button that reveals what is nested under the entity and the eye
       that hides it in the editor's views (a hidden entity keeps its struck eye). -->
  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Background="Transparent">
    <PathIcon Data="{Binding Icon, Converter={x:Static shell:LucideIcons.ByName}}" Margin="0,0,6,0"
              Classes="outlineIcon" Classes.folder="{Binding IsFolder}" Classes.hidden="{Binding IsHidden}" />
    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
               Classes="outlineName" Classes.folder="{Binding IsFolder}" Classes.nested="{Binding IsNested}" Classes.hidden="{Binding IsHidden}" />
    <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="faint small" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding HasCount}" />
    <ToggleButton Grid.Column="3" Classes="icon outlineRow rowEye" Classes.on="{Binding IsRevealed}" IsVisible="{Binding HasNested}"
                  IsChecked="{Binding IsRevealed, Mode=OneWay}" Command="{Binding ToggleRevealCommand}"
                  ToolTip.Tip="Reveal the entities nested under this one">
      <PathIcon Data="{x:Static shell:LucideIcons.Nested}" />
    </ToggleButton>
    <Button Grid.Column="4" Classes="icon outlineRow rowEye" Classes.on="{Binding IsHidden}" Command="{Binding ToggleHiddenCommand}" Margin="0,0,4,0"
            ToolTip.Tip="Hide or show in the editor's views">
      <Panel>
        <PathIcon Data="{x:Static shell:LucideIcons.Visible}" IsVisible="{Binding !IsHidden}" />
        <PathIcon Data="{x:Static shell:LucideIcons.Invisible}" IsVisible="{Binding IsHidden}" />
      </Panel>
    </Button>
  </Grid>
</UserControl>
