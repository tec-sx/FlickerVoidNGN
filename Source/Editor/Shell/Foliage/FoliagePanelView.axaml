<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:foliage="using:FlickerVoid.Editor.Assets.Foliage"
             xmlns:controls="using:FlickerVoid.Editor.Controls"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Foliage.FoliagePanelView"
             x:DataType="foliage:FoliagePanelViewModel">
  <!-- A tree or a bush and the seed it is grown from, then the numbers of its shape; its parts are listed in the outliner. -->
  <ScrollViewer>
    <StackPanel>
      <controls:PanelCard Header="Plant" Icon="{x:Static shell:LucideIcons.Tree}">
        <StackPanel>
          <controls:PanelRow Label="Type" ToolTip.Tip="A tree, or a bush without a trunk; changing it starts from that type's shape.">
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" />
          </controls:PanelRow>
          <controls:PanelRow Label="Seed"
                             ToolTip.Tip="The number the plant's chances are drawn from: the same seed and shape grow the same plant.">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="icon" Margin="4,0,0,0" Command="{Binding NewSeedCommand}"
                      ToolTip.Tip="Grow another plant of the same shape.">
                <PathIcon Data="{x:Static shell:LucideIcons.Scatter}" />
              </Button>
              <TextBox Text="{Binding Seed}" />
            </DockPanel>
          </controls:PanelRow>
        </StackPanel>
      </controls:PanelCard>
      <!-- Growing again replaces every part, and with it what the mesh tools made of them. -->
      <controls:PanelCard Header="Shape" Icon="{x:Static shell:LucideIcons.Scale}">
        <StackPanel>
          <controls:PanelRow Label="Height" ToolTip.Tip="How tall the plant stands, in metres.">
            <TextBox Text="{Binding Height}" />
          </controls:PanelRow>
          <controls:PanelRow Label="Crown" ToolTip.Tip="How far the leaves reach from the middle, in metres.">
            <TextBox Text="{Binding CrownRadius}" />
          </controls:PanelRow>
          <controls:PanelRow Label="Leaves" ToolTip.Tip="How many rounded masses of leaves, from 1 to 16.">
            <TextBox Text="{Binding Crowns}" />
          </controls:PanelRow>
          <controls:PanelRow Label="Limbs" IsVisible="{Binding IsTree}" ToolTip.Tip="How many limbs leave the trunk, up to 12.">
            <TextBox Text="{Binding Limbs}" />
          </controls:PanelRow>
          <controls:PanelRow Label="Trunk" IsVisible="{Binding IsTree}" ToolTip.Tip="The trunk's radius at its foot, in metres.">
            <TextBox Text="{Binding TrunkRadius}" />
          </controls:PanelRow>
          <TextBlock Classes="hint small" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Changing the type, seed or shape grows the plant anew and replaces what the mesh tools made." />
        </StackPanel>
      </controls:PanelCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>
