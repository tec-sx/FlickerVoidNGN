<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vehicles="using:FlickerVoid.Editor.Assets.Vehicles"
             x:Class="FlickerVoid.Editor.Vehicles.VehiclePanelView"
             x:DataType="vehicles:VehiclePanelViewModel">
  <!-- The vehicle's type and wheel count, then its parts. -->
  <DockPanel Margin="4,2">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
      <TextBlock Text="Type" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}"
                ToolTip.Tip="A car or a motorcycle; the wheel count goes to the nearest one the type takes." />
      <TextBlock Grid.Row="1" Text="Wheels" VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding WheelCounts}" SelectedItem="{Binding WheelCount}"
                ToolTip.Tip="Axles are added or removed at the back." />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="Parts" Classes="heading" Margin="0,8,0,0" />
    <ListBox ItemsSource="{Binding Parts}" />
  </DockPanel>
</UserControl>
