<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materials="using:FlickerVoid.Editor.Materials"
        xmlns:inspector="using:FlickerVoid.Editor.Core.Inspector"
        x:Class="FlickerVoid.Editor.Materials.MaterialEditorWindow"
        x:DataType="materials:MaterialEditorViewModel"
        Title="Material Editor"
        Width="1180" Height="680">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>
  <Grid ColumnDefinitions="260,Auto,*">
    <!-- The browser: every material in the content folder, narrowed by the search text. -->
    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel Margin="8">
        <Button DockPanel.Dock="Top" Content="New material" Command="{Binding CreateMaterialCommand}" HorizontalAlignment="Stretch" />
        <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" PlaceholderText="Search materials" Margin="0,8" />
        <ListBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" />
      </DockPanel>
    </Border>
    <!-- The preview: drag to turn the shape. -->
    <StackPanel Grid.Column="1" Margin="12" Spacing="8">
      <Border Width="320" Height="320" Background="#0B0705" CornerRadius="4" ClipToBounds="True">
        <Image x:Name="Preview" Stretch="Uniform" Cursor="SizeWestEast" ToolTip.Tip="Drag to turn" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <ToggleButton Content="Sphere" IsChecked="{Binding IsSphere}" />
        <ToggleButton Content="Cube" IsChecked="{Binding IsCube}" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="320" Foreground="#E0AC2C" />
    </StackPanel>
    <!-- The parameters the scene shader declares, held unsaved as they change until saved or discarded. -->
    <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Save" Command="{Binding SaveCommand}" ToolTip.Tip="Save the material (Ctrl+S)." />
            <Button Content="Discard" Command="{Binding DiscardCommand}" ToolTip.Tip="Forget the unsaved edits." />
          </StackPanel>
          <TextBlock Text="{Binding Heading}" Classes="heading" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Parameters}" Margin="12,0,12,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="inspector:FieldViewModel">
                <Grid ColumnDefinitions="130,*" Margin="0,3">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <ContentControl Grid.Column="1" Content="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
