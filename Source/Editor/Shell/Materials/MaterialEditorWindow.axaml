<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materials="using:FlickerVoid.Editor.Materials"
        xmlns:inspector="using:FlickerVoid.Editor.Core.Inspector"
        xmlns:assets="using:FlickerVoid.Editor.Assets.Materials"
        x:Class="FlickerVoid.Editor.Materials.MaterialEditorWindow"
        x:DataType="materials:MaterialEditorViewModel"
        Title="Material Editor"
        Width="1180" Height="680">
  <Window.Styles>
    <!-- A value the material keeps from its parent or the default shows greyed until it is edited, which overrides it. -->
    <Style Selector="ContentControl.inherited">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </Window.Styles>
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>
  <Grid ColumnDefinitions="260,Auto,*">
    <!-- The browser: every material in the content folder under the master or material it is an instance of, narrowed by the search text. -->
    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel Margin="8">
        <UniformGrid DockPanel.Dock="Top" Columns="2" ColumnSpacing="8">
          <Button Content="New material" Command="{Binding CreateMaterialCommand}" HorizontalAlignment="Stretch" />
          <Button Content="New instance" Command="{Binding CreateInstanceCommand}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Make an instance of the master or material picked, keeping all its values." />
        </UniformGrid>
        <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" PlaceholderText="Search materials" Margin="0,8" />
        <TreeView ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="assets:MaterialTreeNode" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Path}">
                <TextBlock Text="Master" IsVisible="{Binding IsMaster}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
    </Border>
    <!-- The preview: drag to turn the shape. -->
    <StackPanel Grid.Column="1" Margin="12" Spacing="8">
      <Border Width="320" Height="320" Background="#141414" CornerRadius="4" ClipToBounds="True">
        <Image x:Name="Preview" Stretch="Uniform" Cursor="SizeWestEast" ToolTip.Tip="Drag to turn" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <ToggleButton Content="Sphere" IsChecked="{Binding IsSphere}" />
        <ToggleButton Content="Cube" IsChecked="{Binding IsCube}" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="320" Foreground="#E0A040" />
    </StackPanel>
    <!-- The parent and the parameters the scene shader and the master declare, held unsaved as they change until saved or
         discarded. A ticked parameter is the material's own; an unticked one shows its parent's value or the default, greyed. -->
    <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Save" Command="{Binding SaveCommand}" ToolTip.Tip="Save the material (Ctrl+S)." />
            <Button Content="Discard" Command="{Binding DiscardCommand}" ToolTip.Tip="Forget the unsaved edits." />
          </StackPanel>
          <TextBlock Text="{Binding Heading}" Classes="heading" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="24,130,*" Margin="12,0,12,8" IsVisible="{Binding Parent, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Grid.Column="1" Text="Parent" VerticalAlignment="Center" />
          <ContentControl Grid.Column="2" Content="{Binding Parent}" />
        </Grid>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Parameters}" Margin="12,0,12,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="materials:MaterialParameterViewModel">
                <Grid ColumnDefinitions="24,130,*" Margin="0,3">
                  <CheckBox IsChecked="{Binding IsOverridden}" VerticalAlignment="Center" MinWidth="0"
                            ToolTip.Tip="Ticked: the material's own value. Unticked: kept from its parent, or the default." />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" ToolTip.Tip="{Binding Source}" />
                  <ContentControl Grid.Column="2" Content="{Binding Field}" Classes.inherited="{Binding !IsOverridden}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
