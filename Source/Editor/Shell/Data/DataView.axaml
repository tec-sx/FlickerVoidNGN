<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:FlickerVoid.Editor.Core.Data"
             xmlns:controls="using:FlickerVoid.Editor.Controls"
             xmlns:shell="using:FlickerVoid.Editor"
             x:Class="FlickerVoid.Editor.Data.DataView"
             x:DataType="data:DataObjectViewModel">
  <!-- The form of an opened data asset or a selected node as panel cards, edge to edge as the inspector's components are: one for
       its own values, then one for each object and each list of objects in it (their templates are the application's). -->
  <StackPanel IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
    <controls:PanelCard Header="{Binding Title}" Icon="{Binding Icon, Converter={x:Static shell:LucideIcons.ByName}}"
                        IsVisible="{Binding !!Fields.Count}">
      <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRow}" />
    </controls:PanelCard>
    <ItemsControl ItemsSource="{Binding Objects}" />
    <ItemsControl ItemsSource="{Binding Lists}" />
  </StackPanel>
</UserControl>
