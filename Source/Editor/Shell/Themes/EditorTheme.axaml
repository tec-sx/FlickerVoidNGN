<!-- The editor's one theme: Fluent recoloured with a warm dark palette (lamp-lit browns with one amber accent, never grey; palette A, Ember), compact
     sizes (smaller fonts, square corners, tight padding) and the shared classes of the shell's bars, icon buttons, headings and
     viewport overlay, so the viewport gets as much of the window as it can. Views use these classes and resources instead of
     their own colours and sizes. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:menus="using:FlickerVoid.Editor.Core.Menus"
        xmlns:shell="using:FlickerVoid.Editor">
  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Dark"
                             RegionColor="#120D09" Accent="#F5A639" ErrorText="#E0664A"
                             AltHigh="#0B0705" AltLow="#0B0705" AltMedium="#0B0705" AltMediumHigh="#0B0705" AltMediumLow="#0B0705"
                             BaseHigh="#EDE5D8" BaseLow="#2A2119" BaseMedium="#8F8372" BaseMediumHigh="#B6AB99" BaseMediumLow="#6B6052"
                             ChromeAltLow="#B6AB99" ChromeBlackHigh="#0C0A08" ChromeBlackLow="#B6AB99" ChromeBlackMedium="#0B0705"
                             ChromeBlackMediumLow="#2A2119" ChromeDisabledHigh="#2A2119" ChromeDisabledLow="#6B6052" ChromeGray="#8F8372"
                             ChromeHigh="#3A2F26" ChromeLow="#17110C" ChromeMedium="#241C14" ChromeMediumLow="#2A2119" ChromeWhite="#EDE5D8"
                             ListLow="#2A2119" ListMedium="#34291F" />
    </FluentTheme.Palettes>
  </FluentTheme>
  <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

  <Styles.Resources>
    <!-- The editor's palette, from deepest to lightest, then the colours of actions and axes. -->
    <SolidColorBrush x:Key="EditorDeepBrush" Color="#0B0705" />
    <SolidColorBrush x:Key="EditorPanelBrush" Color="#1D1610" />
    <!-- The frame around the content: bars, headers, tabs and the gaps between panels, lighter than the wells it holds. -->
    <SolidColorBrush x:Key="EditorFrameBrush" Color="#120D09" />
    <SolidColorBrush x:Key="EditorControlBrush" Color="#2A2119" />
    <SolidColorBrush x:Key="EditorLineBrush" Color="#3A2F26" />
    <SolidColorBrush x:Key="EditorTextBrush" Color="#EDE5D8" />
    <SolidColorBrush x:Key="EditorMutedTextBrush" Color="#B6AB99" />
    <SolidColorBrush x:Key="EditorAccentBrush" Color="#F5A639" />
    <SolidColorBrush x:Key="EditorOverlayBrush" Color="#E01D1610" />
    <SolidColorBrush x:Key="EditorPlayBrush" Color="#A6C33F" />
    <SolidColorBrush x:Key="EditorSaveBrush" Color="#4A9BBF" />
    <SolidColorBrush x:Key="EditorDeleteBrush" Color="#C8553D" />
    <SolidColorBrush x:Key="EditorBakeBrush" Color="#E0AC2C" />
    <SolidColorBrush x:Key="EditorAxisXBrush" Color="#C8553D" />
    <StaticResource x:Key="EditorAxisYBrush" ResourceKey="EditorPlayBrush" />
    <SolidColorBrush x:Key="EditorAxisZBrush" Color="#4A8FBF" />
    <!-- The bar of every other number box, which drags like the axes do. -->
    <SolidColorBrush x:Key="EditorValueBrush" Color="#D9B23A" />

    <!-- Colours the code views draw with: the curve palette, code assets, the splash track and shadows. -->
    <Color x:Key="EditorCurveBlue">#5ACCFF</Color>
    <Color x:Key="EditorCurvePink">#D97BA6</Color>
    <Color x:Key="EditorCodeColor">#B48EC9</Color>
    <Color x:Key="EditorSplashTrack">#26FFFFFF</Color>
    <Color x:Key="EditorNodeShadow">#E0000000</Color>

    <!-- Fluent's own tokens, read by its control themes. -->
    <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
    <Thickness x:Key="ButtonPadding">6,1</Thickness>
    <x:Double x:Key="TextControlThemeMinHeight">20</x:Double>
    <x:Double x:Key="ExpanderMinHeight">20</x:Double>
    <x:Double x:Key="ExpanderChevronButtonSize">16</x:Double>
    <Thickness x:Key="ExpanderChevronMargin">4,0</Thickness>
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="EditorLineBrush" />
    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="EditorMutedTextBrush" />
    <StaticResource x:Key="TextControlBackground" ResourceKey="EditorDeepBrush" />
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="EditorDeepBrush" />
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="EditorDeepBrush" />
    <Thickness x:Key="TextControlThemePadding">4,1</Thickness>

    <!-- The editor's own sizes. -->
    <x:Double x:Key="EditorFontSize">12</x:Double>
    <x:Double x:Key="EditorHeadingFontSize">12</x:Double>
    <x:Double x:Key="EditorSmallFontSize">11</x:Double>
    <x:Double x:Key="EditorSpacing">2</x:Double>
    <!-- Menus scroll past this height. -->
    <x:Double x:Key="EditorMenuMaxHeight">360</x:Double>
    <CornerRadius x:Key="EditorSearchCornerRadius">10</CornerRadius>
    <!-- The wells: content sunk into the frame, slightly rounded, shaded along their top and sides. -->
    <CornerRadius x:Key="EditorWellCornerRadius">3</CornerRadius>
    <BoxShadows x:Key="EditorWellShadow">0 0 0 0 #00000000</BoxShadows>

    <!-- The item of a menu built from choices (MenuNode): its icon, its key and its submenu, or a separator. -->
    <ControlTheme x:Key="ChoiceMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="menus:MenuNode">
      <Setter Property="Header" Value="{Binding Header}" />
      <Setter Property="Command" Value="{Binding Command}" />
      <Setter Property="InputGesture" Value="{Binding Gesture, Converter={x:Static shell:KeyGestures.Parse}}" />
      <Setter Property="ItemsSource" Value="{Binding Children}" />
      <Setter Property="Icon">
        <Template>
          <PathIcon Data="{Binding Icon, Converter={x:Static shell:MaterialIcons.ByName}}"
                    IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Template>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <!-- Text: every control inherits the window's size. The window is the frame that the wells sink into. -->
  <Style Selector="Window">
    <Setter Property="FontSize" Value="{StaticResource EditorFontSize}" />
    <Setter Property="Background" Value="{StaticResource EditorFrameBrush}" />
  </Style>

  <!-- A well: an area of content (a tree, list, form or canvas) sunk into the frame, so the content reads as deeper than the
       bars and headers around it. Lists and trees inside let it show through. -->
  <Style Selector="Border.well">
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BoxShadow" Value="{StaticResource EditorWellShadow}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="1,3,1,1" />
  </Style>
  <Style Selector="Border.well.viewport">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.well ListBox, Border.well TreeView, Border.well ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource EditorLineBrush}" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{StaticResource EditorHeadingFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="6,4" />
  </Style>
  <!-- What fills an empty panel. -->
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{StaticResource EditorSmallFontSize}" />
  </Style>

  <!-- Buttons and inputs: square and tight. -->
  <Style Selector="Button, ToggleButton, DropDownButton, SplitButton, RepeatButton">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox, AutoCompleteBox">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="6,1,0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="4,0,0,0" />
  </Style>

  <!-- Lists, trees, menus and tabs. -->
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="MenuItem PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <!-- Menus and submenus scroll once they hold more than fits. -->
  <Style Selector="MenuFlyoutPresenter, ContextMenu, MenuItem /template/ Popup > Border">
    <Setter Property="MaxHeight" Value="{StaticResource EditorMenuMaxHeight}" />
  </Style>

  <!-- The asset picker (AssetPickerView): a field showing the current file, over a popup like the searchable menu. -->
  <Style Selector="ToggleButton.asset">
    <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5,2" />
  </Style>
  <Style Selector="ToggleButton.asset:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Border.pickerPopup">
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource EditorWellCornerRadius}" />
    <Setter Property="BoxShadow" Value="0 4 12 0 #80000000" />
  </Style>
  <Style Selector="Button.pickerNone">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- The search box (SearchBox) and the searchable menu (SearchMenu). -->
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="{StaticResource EditorSearchCornerRadius}" />
    <Setter Property="Padding" Value="2,1,4,1" />
  </Style>
  <Style Selector="TextBox.search PathIcon.searchGlass">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Margin" Value="7,0,0,0" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="TextBox.search Button.searchClear">
    <Setter Property="Margin" Value="0,0,3,0" />
  </Style>
  <Style Selector="FlyoutPresenter.searchMenu">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="ListBox.menuRows ListBoxItem">
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="ListBox.menuRows ListBoxItem:disabled">
    <Setter Property="Padding" Value="8,6,8,1" />
  </Style>
  <Style Selector="TextBlock.menuHeading">
    <Setter Property="FontSize" Value="{StaticResource EditorSmallFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <!-- The scene outline: small icons, folders in the asset browser's folder colour. -->
  <Style Selector="TreeView.outline TreeViewItem">
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="PathIcon.outlineIcon">
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="PathIcon.outlineIcon.folder">
    <Setter Property="Foreground" Value="#DCBC98" />
  </Style>
  <Style Selector="TreeView.outline TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <!-- Entities shown under the entity they are nested under, in the axis blue; hidden ones faded. -->
  <Style Selector="TextBlock.outlineName.nested">
    <Setter Property="Foreground" Value="{StaticResource EditorAxisZBrush}" />
  </Style>
  <Style Selector="TextBlock.outlineName.hidden, PathIcon.outlineIcon.hidden">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector=":is(Button).icon.outlineRow">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector=":is(Button).icon.outlineRow PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>

  <!-- The asset browser's narrow column of kind filters. -->
  <Style Selector="ListBox.filters">
    <Setter Property="Width" Value="88" />
  </Style>
  <Style Selector="ListBox.filters ListBoxItem">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="MinHeight" Value="18" />
  </Style>
  <Style Selector="TextBlock.menuDetail">
    <Setter Property="FontSize" Value="{StaticResource EditorSmallFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{StaticResource EditorHeadingFontSize}" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="8,1" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="6,0,2,0" />
  </Style>
  <!-- Views that want the chevron somewhere else draw their own and hide Fluent's. -->
  <Style Selector="Expander.ownChevron /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- The shell's bars: the toolbar above the viewport and the status bar below it, part of the frame. -->
  <Style Selector="Border.toolbar, Border.statusbar">
    <Setter Property="Background" Value="{StaticResource EditorFrameBrush}" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Padding" Value="2,1" />
  </Style>
  <Style Selector="Border.toolbar StackPanel">
    <Setter Property="Spacing" Value="{StaticResource EditorSpacing}" />
  </Style>
  <Style Selector="Border.toolbar Separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Background" Value="{StaticResource EditorLineBrush}" />
  </Style>
  <!-- The toolbar doubles as the window's title bar, leaving room on the right for the window's own buttons. -->
  <Style Selector="Border.titleBar">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6,0,140,0" />
  </Style>
  <Style Selector="Border.titleBar StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="PathIcon.logo">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="2,0,4,0" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.windowTitle">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="Border.statusbar">
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontSize" Value="{StaticResource EditorSmallFontSize}" />
  </Style>

  <!-- The viewport's floating tool bars and camera buttons. -->
  <Style Selector="Border.viewportBar">
    <Setter Property="Background" Value="{StaticResource EditorOverlayBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="1" />
  </Style>
  <Style Selector="ToggleButton.viewportIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="ComboBox.viewportSnap">
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.viewportIcon:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Button.viewportRound">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource EditorOverlayBrush}" />
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="Button.viewportRound PathIcon, ToggleButton.viewportIcon PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <!-- Icon buttons in the shell's bars; a colour class marks what an action does: play, save, delete or bake. -->
  <Style Selector="Button.icon, ToggleButton.icon, DropDownButton.icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="DropDownButton.icon">
    <Setter Property="Width" Value="32" />
  </Style>
  <Style Selector=":is(Button).icon PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Button.icon.small PathIcon, PathIcon.small">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked">
    <Setter Property="Foreground" Value="{StaticResource EditorDeepBrush}" />
  </Style>
  <Style Selector="Button.icon.save">
    <Setter Property="Foreground" Value="{StaticResource EditorSaveBrush}" />
  </Style>
  <Style Selector="Button.icon.delete">
    <Setter Property="Foreground" Value="{StaticResource EditorDeleteBrush}" />
  </Style>
  <Style Selector="Button.icon.bake">
    <Setter Property="Foreground" Value="{StaticResource EditorBakeBrush}" />
  </Style>
  <Style Selector="Button.icon.play">
    <Setter Property="Foreground" Value="{StaticResource EditorPlayBrush}" />
  </Style>
  <Style Selector="Button.icon.play PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="Button.icon.play:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground" Value="#C2DB5E" />
  </Style>
  <Style Selector="Button.icon.play:disabled /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource EditorPlayBrush}" />
  </Style>
  <Style Selector="Button.icon.play:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- The inspector: a line under each component's header and number boxes that fit three to a row. -->
  <!-- A field's value sits beside its label, or, holding fields of its own, under it, across the row and indented (FieldRow in
       App.axaml); set by style, as a local column would win over the nested one. -->
  <Style Selector="ContentControl.fieldValue">
    <Setter Property="Grid.Column" Value="1" />
  </Style>
  <Style Selector="ContentControl.fieldValue.nested">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="10,2,0,0" />
  </Style>
  <Style Selector="Border.category">
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,0,2" />
  </Style>
  <Style Selector="TextBox.drag">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>
  <Style Selector="TextBox.drag.typing">
    <Setter Property="Cursor" Value="Ibeam" />
  </Style>
</Styles>
