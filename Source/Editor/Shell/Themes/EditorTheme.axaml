<!-- The editor's one theme (Docs/Design/EditorUi.md): palette A, Ember (lamp-lit browns with one amber accent, never grey), and
     the component kit every view is built from: 22 px rows, 1 px lines, the outline icons, quiet buttons with one filled primary,
     fields, switches, chips, panel and document tabs, tree rows, the viewport's floating pills. Fluent stays underneath for the
     controls the kit does not redraw (text boxes, menus, scroll bars). Views use these classes and resources, never their own
     colours and sizes. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:menus="using:FlickerVoid.Editor.Core.Menus"
        xmlns:shell="using:FlickerVoid.Editor"
        xmlns:controls="using:FlickerVoid.Editor.Controls"
        xmlns:timelines="using:FlickerVoid.Editor.Controls.Timelines"
        xmlns:mix="using:FlickerVoid.Editor.Controls.Mix"
        xmlns:lists="using:FlickerVoid.Editor.Controls.Lists"
        xmlns:corelists="using:FlickerVoid.Editor.Core.Lists"
        xmlns:coretimelines="using:FlickerVoid.Editor.Core.Timelines"
        xmlns:chrome="using:Avalonia.Controls.Chrome">
  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Dark"
                             RegionColor="#120D09" Accent="#F5A639" ErrorText="#E0664A"
                             AltHigh="#0B0705" AltLow="#0B0705" AltMedium="#0B0705" AltMediumHigh="#0B0705" AltMediumLow="#0B0705"
                             BaseHigh="#EDE5D8" BaseLow="#2A2119" BaseMedium="#8F8372" BaseMediumHigh="#B6AB99" BaseMediumLow="#6B6052"
                             ChromeAltLow="#B6AB99" ChromeBlackHigh="#0C0A08" ChromeBlackLow="#B6AB99" ChromeBlackMedium="#0B0705"
                             ChromeBlackMediumLow="#2A2119" ChromeDisabledHigh="#2A2119" ChromeDisabledLow="#6B6052" ChromeGray="#8F8372"
                             ChromeHigh="#3A2F26" ChromeLow="#17110C" ChromeMedium="#241C14" ChromeMediumLow="#2A2119" ChromeWhite="#EDE5D8"
                             ListLow="#2A2119" ListMedium="#34291F" />
    </FluentTheme.Palettes>
  </FluentTheme>
  <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

  <Styles.Resources>
    <!-- The palette, from deepest to lightest: input, base (bars), panel, raised (headers, buttons), line, then the three texts. -->
    <SolidColorBrush x:Key="EditorDeepBrush" Color="#0B0705" />
    <SolidColorBrush x:Key="EditorFrameBrush" Color="#120D09" />
    <SolidColorBrush x:Key="EditorPanelBrush" Color="#1D1610" />
    <SolidColorBrush x:Key="EditorControlBrush" Color="#2A2119" />
    <SolidColorBrush x:Key="EditorHoverBrush" Color="#34291F" />
    <SolidColorBrush x:Key="EditorRowHoverBrush" Color="#241B13" />
    <SolidColorBrush x:Key="EditorLineBrush" Color="#3A2F26" />
    <SolidColorBrush x:Key="EditorTextBrush" Color="#EDE5D8" />
    <SolidColorBrush x:Key="EditorMutedTextBrush" Color="#B6AB99" />
    <SolidColorBrush x:Key="EditorHintBrush" Color="#8F8372" />
    <!-- The one accent: selection, focus, unsaved work and the single primary action; its ink, its wash and its line. -->
    <SolidColorBrush x:Key="EditorAccentBrush" Color="#F5A639" />
    <SolidColorBrush x:Key="EditorMeterBrush" Color="#9BCB3C" />
    <SolidColorBrush x:Key="EditorMeterWarnBrush" Color="#E0C02C" />
    <SolidColorBrush x:Key="EditorMeterPeakBrush" Color="#E0553D" />
    <SolidColorBrush x:Key="EditorAccentInkBrush" Color="#211201" />
    <SolidColorBrush x:Key="EditorAccentSoftBrush" Color="#422F17" />
    <SolidColorBrush x:Key="EditorAccentLineBrush" Color="#946527" />
    <SolidColorBrush x:Key="EditorFillBrush" Color="#38F5A639" />
    <SolidColorBrush x:Key="EditorNumberFillBrush" Color="#3E2A10" />
    <SolidColorBrush x:Key="EditorFolderBrush" Color="#CC9A4F" />
    <!-- Things floating over the picture. -->
    <SolidColorBrush x:Key="EditorOverlayBrush" Color="#E0120D09" />
    <SolidColorBrush x:Key="EditorOverlayLineBrush" Color="#B33A2F26" />
    <SolidColorBrush x:Key="EditorScrimBrush" Color="#52000000" />
    <!-- Meaning: done, warning, destructive, information; and the axes. -->
    <SolidColorBrush x:Key="EditorPlayBrush" Color="#A6C33F" />
    <SolidColorBrush x:Key="EditorSaveBrush" Color="#5BA3D0" />
    <SolidColorBrush x:Key="EditorDeleteBrush" Color="#E0664A" />
    <SolidColorBrush x:Key="EditorBakeBrush" Color="#E0AC2C" />
    <SolidColorBrush x:Key="EditorAxisXBrush" Color="#E0664A" />
    <StaticResource x:Key="EditorAxisYBrush" ResourceKey="EditorPlayBrush" />
    <SolidColorBrush x:Key="EditorAxisZBrush" Color="#5B9BE0" />
    <!-- The bar of every other number box, which drags like the axes do. -->
    <SolidColorBrush x:Key="EditorValueBrush" Color="#D9B23A" />

    <!-- The flow graph's nodes: a header tint and an icon colour for each kind (FlowNodeLook). -->
    <SolidColorBrush x:Key="FlowDialogueHeaderBrush" Color="#2E3A44" />
    <SolidColorBrush x:Key="FlowDialogueIconBrush" Color="#6FA8DC" />
    <SolidColorBrush x:Key="FlowChoiceHeaderBrush" Color="#4E3519" />
    <SolidColorBrush x:Key="FlowChoiceIconBrush" Color="#F5A639" />
    <SolidColorBrush x:Key="FlowQuestHeaderBrush" Color="#4A401C" />
    <SolidColorBrush x:Key="FlowQuestIconBrush" Color="#E0C040" />
    <SolidColorBrush x:Key="FlowStartHeaderBrush" Color="#34401F" />
    <SolidColorBrush x:Key="FlowStartIconBrush" Color="#A6C33F" />
    <SolidColorBrush x:Key="FlowFinishHeaderBrush" Color="#4A2822" />
    <SolidColorBrush x:Key="FlowFinishIconBrush" Color="#E0664A" />
    <SolidColorBrush x:Key="FlowCameraHeaderBrush" Color="#3B2F4A" />
    <SolidColorBrush x:Key="FlowCameraIconBrush" Color="#B48EC9" />
    <SolidColorBrush x:Key="FlowConditionHeaderBrush" Color="#2E3F3C" />
    <SolidColorBrush x:Key="FlowConditionIconBrush" Color="#5FB8A8" />
    <SolidColorBrush x:Key="FlowEffectHeaderBrush" Color="#3A2F26" />
    <SolidColorBrush x:Key="FlowEffectIconBrush" Color="#B6AB99" />
    <SolidColorBrush x:Key="FlowWireBrush" Color="#8F8372" />
    <SolidColorBrush x:Key="FlowDotBrush" Color="#2E241B" />
    <SolidColorBrush x:Key="FlowMapNodeBrush" Color="#4A3D31" />
    <SolidColorBrush x:Key="FlowMapFrameFillBrush" Color="#14F5A639" />

    <!-- Colours the code views draw with: layer and cue colours (with the ink for text on them), the curve palette, code assets, the splash track and shadows. -->
    <Color x:Key="EditorTrack1">#F5A639</Color>
    <Color x:Key="EditorTrack2">#E27641</Color>
    <Color x:Key="EditorTrack3">#F26A5D</Color>
    <Color x:Key="EditorTrack4">#C9B957</Color>
    <Color x:Key="EditorTrack5">#63B5B4</Color>
    <Color x:Key="EditorTrack6">#DF84A8</Color>
    <Color x:Key="EditorCue1">#56D1A3</Color>
    <Color x:Key="EditorCue2">#D892E8</Color>
    <Color x:Key="EditorCue3">#58B0FF</Color>
    <Color x:Key="EditorCue4">#E7B643</Color>
    <Color x:Key="EditorCue5">#8CC36D</Color>
    <Color x:Key="EditorCue6">#E27641</Color>
    <Color x:Key="EditorCue7">#F08698</Color>
    <Color x:Key="EditorCue8">#63B5B4</Color>
    <Color x:Key="EditorCueInk">#1A1208</Color>
    <SolidColorBrush x:Key="EditorCueInkBrush" Color="#1A1208" />
    <!-- The raised ground of a lane under a layer or outside the loop: 55% of the base over the input. -->
    <SolidColorBrush x:Key="EditorRaisedLaneBrush" Color="#0F0A07" />
    <Color x:Key="EditorCurveBlue">#5ACCFF</Color>
    <Color x:Key="EditorCurvePink">#D97BA6</Color>
    <Color x:Key="EditorCodeColor">#B48EC9</Color>
    <SolidColorBrush x:Key="EditorCodeBrush" Color="#B48EC9" />
    <Color x:Key="EditorSplashTrack">#26FFFFFF</Color>
    <Color x:Key="EditorNodeShadow">#E0000000</Color>
    <BoxShadows x:Key="EditorFloatShadow">0 2 10 0 #59000000</BoxShadows>
    <BoxShadows x:Key="EditorPopupShadow">0 8 28 0 #99000000</BoxShadows>
    <BoxShadows x:Key="EditorDrawerShadow">0 -12 32 0 #73000000</BoxShadows>
    <BoxShadows x:Key="EditorSelectedBar">inset 2 0 0 0 #F5A639</BoxShadows>
    <BoxShadows x:Key="EditorTabTopBar">inset 0 2 0 0 #F5A639</BoxShadows>
    <BoxShadows x:Key="EditorTabBottomBar">inset 0 -2 0 0 #F5A639</BoxShadows>

    <!-- Fluent's own tokens, read by the control themes the kit keeps (text boxes, menus, tooltips, scroll bars). -->
    <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
    <Thickness x:Key="ButtonPadding">8,0</Thickness>
    <x:Double x:Key="TextControlThemeMinHeight">20</x:Double>
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="EditorLineBrush" />
    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="EditorHintBrush" />
    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="EditorAccentBrush" />
    <StaticResource x:Key="TextControlBackground" ResourceKey="EditorDeepBrush" />
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="EditorDeepBrush" />
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="EditorDeepBrush" />
    <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="EditorHintBrush" />
    <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="EditorHintBrush" />
    <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="EditorHintBrush" />
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <Thickness x:Key="TextControlThemePadding">6,1</Thickness>
    <StaticResource x:Key="ToolTipBackground" ResourceKey="EditorControlBrush" />
    <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="EditorLineBrush" />
    <StaticResource x:Key="ToolTipForeground" ResourceKey="EditorTextBrush" />
    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="EditorPanelBrush" />
    <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="EditorLineBrush" />
    <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="EditorAccentSoftBrush" />
    <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="EditorAccentSoftBrush" />
    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="EditorPanelBrush" />
    <StaticResource x:Key="FlyoutBorderThemeBrush" ResourceKey="EditorLineBrush" />
    <x:Double x:Key="ScrollBarSize">8</x:Double>

    <!-- The kit's measures. -->
    <x:Double x:Key="EditorFontSize">12</x:Double>
    <x:Double x:Key="EditorTitleFontSize">13</x:Double>
    <x:Double x:Key="EditorHeadingFontSize">12</x:Double>
    <x:Double x:Key="EditorSmallFontSize">11</x:Double>
    <x:Double x:Key="EditorCapsFontSize">10.5</x:Double>
    <x:Double x:Key="EditorRowHeight">22</x:Double>
    <x:Double x:Key="EditorSpacing">2</x:Double>
    <!-- Menus scroll past this height. -->
    <x:Double x:Key="EditorMenuMaxHeight">360</x:Double>
    <CornerRadius x:Key="EditorFieldCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="EditorButtonCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="EditorFloatCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="EditorSearchCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="EditorWellCornerRadius">6</CornerRadius>

    <!-- The outline icons: every PathIcon strokes its 24 by 24 path in the text colour; PathIcon.filled fills it instead. -->
    <!-- The window's own buttons, drawn over the top bar's right end (Avalonia's Fluent decorations, MIT, without their title,
         which the top bar replaces): 44 px wide, outline icons, the close button red under the pointer. -->
    <ControlTheme x:Key="EditorCaptionButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource EditorHoverBrush}" />
      <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
      <Setter Property="Width" Value="44" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="(WindowDecorationProperties.ElementRole)" Value="DecorationsElement" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{TemplateBinding Background}" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
      <Setter Property="DefaultTitleBarHeight" Value="30" />
      <Setter Property="DefaultFrameThickness" Value="1" />
      <Setter Property="DefaultShadowThickness" Value="8" />
      <Setter Property="Template">
        <WindowDrawnDecorationsTemplate>
          <WindowDrawnDecorationsContent>
            <WindowDrawnDecorationsContent.Underlay>
              <Panel x:Name="PART_UnderlayWrapper">
                <Border x:Name="PART_WindowBorder" Background="Transparent" BorderThickness="{TemplateBinding FrameThickness}"
                        BorderBrush="{StaticResource EditorLineBrush}" IsHitTestVisible="False" />
                <Panel x:Name="PART_TitleBar" VerticalAlignment="Top" Height="{TemplateBinding TitleBarHeight}"
                       Background="{StaticResource EditorFrameBrush}" IsVisible="{TemplateBinding HasTitleBar}"
                       WindowDecorationProperties.ElementRole="TitleBar" />
              </Panel>
            </WindowDrawnDecorationsContent.Underlay>
            <WindowDrawnDecorationsContent.Overlay>
              <Panel x:Name="PART_OverlayWrapper">
                <StackPanel x:Name="PART_OverlayPanel" VerticalAlignment="Top" HorizontalAlignment="Right" Height="29"
                            IsVisible="{TemplateBinding HasTitleBar}" Orientation="Horizontal">
                  <Button x:Name="PART_MinimizeButton" Theme="{StaticResource EditorCaptionButton}"
                          WindowDecorationProperties.ElementRole="MinimizeButton">
                    <PathIcon Width="12" Height="12" Data="{x:Static shell:LucideIcons.Minimize}" />
                  </Button>
                  <Button x:Name="PART_MaximizeButton" Theme="{StaticResource EditorCaptionButton}"
                          WindowDecorationProperties.ElementRole="MaximizeButton">
                    <Panel>
                      <PathIcon x:Name="MaximizeIcon" Width="12" Height="12" Data="{x:Static shell:LucideIcons.Restore}" />
                      <PathIcon x:Name="RestoreIcon" Width="12" Height="12" Data="{x:Static shell:LucideIcons.Duplicate}" IsVisible="False" />
                    </Panel>
                  </Button>
                  <Button x:Name="PART_CloseButton" Background="{StaticResource EditorDeleteBrush}" Theme="{StaticResource EditorCaptionButton}"
                          WindowDecorationProperties.ElementRole="CloseButton">
                    <PathIcon Width="12" Height="12" Data="{x:Static shell:LucideIcons.Close}" />
                  </Button>
                </StackPanel>
              </Panel>
            </WindowDrawnDecorationsContent.Overlay>
          </WindowDrawnDecorationsContent>
        </WindowDrawnDecorationsTemplate>
      </Setter>
      <Style Selector="^:has-shadow /template/ Panel#PART_UnderlayWrapper">
        <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
      </Style>
      <Style Selector="^:has-shadow /template/ Border#PART_WindowBorder">
        <Setter Property="BoxShadow" Value="0 2 10 2 #80000000" />
      </Style>
      <Style Selector="^:has-shadow /template/ Panel#PART_OverlayWrapper">
        <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
      </Style>
      <Style Selector="^:has-border /template/ Panel#PART_TitleBar">
        <Setter Property="Margin" Value="1,1,1,0" />
      </Style>
      <Style Selector="^:has-border /template/ StackPanel#PART_OverlayPanel">
        <Setter Property="Margin" Value="0,1,1,0" />
      </Style>
      <Style Selector="^:maximized /template/ PathIcon#MaximizeIcon">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:maximized /template/ PathIcon#RestoreIcon">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ Button:disabled">
        <Setter Property="Opacity" Value="0.2" />
      </Style>
      <Style Selector="^:not(:has-minimize) /template/ Button#PART_MinimizeButton">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:not(:has-maximize) /template/ Button#PART_MaximizeButton">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:fullscreen /template/ StackPanel#PART_OverlayPanel">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:fullscreen /template/ Panel#PART_TitleBar">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type PathIcon}" TargetType="PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Viewbox Stretch="Uniform">
              <Canvas Width="24" Height="24">
                <Path x:Name="PART_Path" Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75"
                      StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
            </Viewbox>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.filled /template/ Path#PART_Path">
        <Setter Property="Fill" Value="{Binding $parent[PathIcon].Foreground}" />
        <Setter Property="StrokeThickness" Value="0" />
      </Style>
      <Style Selector="^.solid /template/ Path#PART_Path">
        <Setter Property="Fill" Value="{Binding $parent[PathIcon].Foreground}" />
      </Style>
      <Style Selector="^.thin /template/ Path#PART_Path">
        <Setter Property="StrokeThickness" Value="1.3" />
      </Style>
      <Style Selector="^.bold /template/ Path#PART_Path">
        <Setter Property="StrokeThickness" Value="2.6" />
      </Style>
    </ControlTheme>

    <!-- Buttons: quiet until hovered, 22 px tall. Button.primary is the one filled amber action of a screen. -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource EditorControlBrush}" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource EditorButtonCornerRadius}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}" RecognizesAccessKey="True"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource EditorHoverBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource EditorLineBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}">
      <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Foreground" Value="{StaticResource EditorAccentInkBrush}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton" BasedOn="{StaticResource {x:Type Button}}" />

    <!-- A switch, for a setting that applies at once: a ToggleButton with Theme="{StaticResource Switch}". -->
    <ControlTheme x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Padding="0,3">
            <Border x:Name="Track" Width="26" Height="14" CornerRadius="7" Background="{StaticResource EditorDeepBrush}"
                    BorderBrush="{StaticResource EditorLineBrush}" BorderThickness="1">
              <Ellipse x:Name="Knob" Width="10" Height="10" Fill="{StaticResource EditorHintBrush}" HorizontalAlignment="Left" Margin="1,0" />
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#Track">
        <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
      </Style>
      <Style Selector="^:checked /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{StaticResource EditorAccentInkBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>

    <!-- A checkbox, inside lists: a 14 px box, amber with a dark tick when checked. -->
    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="Padding" Value="6,0,0,0" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="Auto,*" Background="Transparent">
            <Border x:Name="Box" Width="14" Height="14" CornerRadius="3" Background="{StaticResource EditorDeepBrush}"
                    BorderBrush="{StaticResource EditorLineBrush}" BorderThickness="1" VerticalAlignment="Center">
              <PathIcon x:Name="Tick" Classes="bold" Data="{x:Static shell:LucideIcons.Check}" Width="10" Height="10"
                        Foreground="{StaticResource EditorAccentInkBrush}" IsVisible="False" />
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#Box">
        <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
      </Style>
      <Style Selector="^:checked /template/ PathIcon#Tick">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{StaticResource EditorHintBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>

    <!-- A choice: the field's look, the chosen item and a chevron, over a popup of rows. -->
    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource EditorFieldCornerRadius}" />
      <Setter Property="Padding" Value="6,0,2,0" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="MaxDropDownHeight" Value="{StaticResource EditorMenuMaxHeight}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="*,Auto">
            <Border x:Name="Background" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
            <TextBlock x:Name="PlaceholderTextBlock" Text="{TemplateBinding PlaceholderText}" Margin="{TemplateBinding Padding}"
                       Foreground="{StaticResource EditorHintBrush}" VerticalAlignment="Center"
                       IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
            <ContentControl x:Name="ContentPresenter" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding ItemTemplate}"
                            Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" ClipToBounds="True" />
            <PathIcon Grid.Column="1" Data="{x:Static shell:LucideIcons.Expand}" Width="11" Height="11" Margin="2,0,5,0"
                      Foreground="{StaticResource EditorHintBrush}" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" IsLightDismissEnabled="True"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}" PlacementTarget="Background" InheritsTransform="True"
                   WindowManagerAddShadowHint="False">
              <Border Background="{StaticResource EditorPanelBrush}" BorderBrush="{StaticResource EditorLineBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource EditorButtonCornerRadius}" Padding="2" Margin="0,2">
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                  <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{StaticResource EditorHintBrush}" />
      </Style>
      <Style Selector="^:dropdownopen /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="{StaticResource EditorRowHeight}" />
      <Setter Property="CornerRadius" Value="{StaticResource EditorFieldCornerRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource EditorHoverBrush}" />
      </Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
      </Style>
    </ControlTheme>

    <!-- List rows: 22 px, a soft amber wash and a 2 px bar when selected. -->
    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="{StaticResource EditorRowHeight}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource EditorRowHoverBrush}" />
      </Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
        <Setter Property="BoxShadow" Value="{StaticResource EditorSelectedBar}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.6" />
      </Style>
    </ControlTheme>

    <!-- The panel card (rule R26): the one card every side panel is built from, as the inspector shows a component: a 24 px
         raised header with a chevron, an icon, the title, the card's actions and its More menu, over a body of panel rows.
         Folded, the header sinks into the panel and says what the card holds. -->
    <ControlTheme x:Key="PanelCardHeader" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource EditorLineBrush}" BorderThickness="0,0,0,1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{StaticResource EditorControlBrush}" />
        <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type controls:PanelCard}" TargetType="controls:PanelCard">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="Padding" Value="10,5,8,7" />
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <ToggleButton x:Name="PART_Header" DockPanel.Dock="Top" Theme="{StaticResource PanelCardHeader}"
                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
              <DockPanel>
                <Panel DockPanel.Dock="Left" Width="14" Margin="0,0,6,0">
                  <PathIcon x:Name="PART_Closed" Classes="small faint" Data="{x:Static shell:LucideIcons.Next}" />
                  <PathIcon x:Name="PART_Opened" Classes="small faint" Data="{x:Static shell:LucideIcons.Expand}" />
                </Panel>
                <PathIcon x:Name="PART_Icon" DockPanel.Dock="Left" Classes="muted" Data="{TemplateBinding Icon}" Margin="0,0,7,0"
                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button x:Name="PART_More" DockPanel.Dock="Right" Classes="icon small" Flyout="{TemplateBinding Menu}" ToolTip.Tip="More">
                  <PathIcon Data="{x:Static shell:LucideIcons.More}" />
                </Button>
                <ContentPresenter x:Name="PART_Actions" DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
                <ContentPresenter x:Name="PART_HeaderPresenter" DockPanel.Dock="Left" Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
                <TextBlock x:Name="PART_Note" DockPanel.Dock="Left" Classes="faint small" Text="{TemplateBinding Note}" FontWeight="Normal"
                           VerticalAlignment="Center" Margin="7,0,0,0"
                           IsVisible="{TemplateBinding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock x:Name="PART_Summary" Classes="faint small" Text="{TemplateBinding Summary}" FontWeight="Normal"
                           VerticalAlignment="Center" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </ToggleButton>
            <Border x:Name="PART_Body" Padding="{TemplateBinding Padding}" Grid.IsSharedSizeScope="True"
                    BorderBrush="{StaticResource EditorLineBrush}" BorderThickness="0,0,0,1">
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </DockPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ PathIcon#PART_Opened">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:expanded /template/ PathIcon#PART_Opened">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:expanded /template/ PathIcon#PART_Closed">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Border#PART_Body">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:expanded /template/ Border#PART_Body">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:expanded /template/ TextBlock#PART_Summary">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Button#PART_More">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:menu /template/ Button#PART_More">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter > TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
    </ControlTheme>
    <!-- The timeline kit (rule R28, Docs/Design/Timeline.md). A lane header: a 3 px edge in the lane's colour, the icon in that
         colour, the name, a note, the buttons at the row's end and the content under it; a lane under another is indented 22 px
         on the raised ground in the hint colour; a selected one is washed in the accent. -->
    <ControlTheme x:Key="{x:Type timelines:LaneHeader}" TargetType="timelines:LaneHeader">
      <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="Padding" Value="9,6,8,0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{StaticResource EditorLineBrush}" BorderThickness="0,0,1,1">
            <DockPanel>
              <Border x:Name="PART_Edge" DockPanel.Dock="Left" Width="{x:Static timelines:LaneHeader.Edge}" Background="{TemplateBinding Tint}" />
              <DockPanel x:Name="PART_Body" Margin="{TemplateBinding Padding}">
                <DockPanel x:Name="PART_Row" DockPanel.Dock="Top" Height="18">
                  <ContentPresenter x:Name="PART_Buttons" DockPanel.Dock="Right" Content="{TemplateBinding Buttons}" VerticalAlignment="Center" />
                  <PathIcon x:Name="PART_Icon" DockPanel.Dock="Left" Data="{TemplateBinding Icon}" Foreground="{TemplateBinding Tint}" Margin="0,0,6,0"
                            IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock x:Name="PART_Title" DockPanel.Dock="Left" Text="{TemplateBinding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="PART_Note" Classes="faint small" Text="{TemplateBinding Note}" VerticalAlignment="Center" Margin="6,0,0,0"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Margin="0,5,0,0" />
              </DockPanel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
      </Style>
      <Style Selector="^:compact /template/ DockPanel#PART_Body">
        <Setter Property="Margin" Value="8,0" />
      </Style>
      <Style Selector="^:compact /template/ DockPanel#PART_Row">
        <Setter Property="DockPanel.Dock" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^:compact /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:sub">
        <Setter Property="Background" Value="{StaticResource EditorRaisedLaneBrush}" />
        <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
        <Setter Property="FontSize" Value="11" />
      </Style>
      <Style Selector="^:sub /template/ DockPanel#PART_Body">
        <Setter Property="Margin" Value="19,0,8,0" />
      </Style>
      <Style Selector="^:sub /template/ PathIcon#PART_Icon">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
      </Style>
      <Style Selector="^:sub /template/ TextBlock#PART_Title">
        <Setter Property="FontWeight" Value="Normal" />
      </Style>
      <Style Selector="^:sub /template/ TextBlock#PART_Note">
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
    </ControlTheme>

    <!-- The transport bar: play and pause on the accent, stop, loop, the position in 15 px and the clock faint, then the
         editor's fields and its tools, on a 34 px bar of the panel colour. -->
    <ControlTheme x:Key="TransportButton" TargetType="Button">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource EditorHoverBrush}" />
      </Style>
      <Style Selector="^.play /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource EditorAccentInkBrush}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="TransportToggle" TargetType="ToggleButton" BasedOn="{StaticResource TransportButton}">
      <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource EditorAccentInkBrush}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type timelines:Transport}" TargetType="timelines:Transport">
      <Setter Property="Height" Value="{x:Static timelines:Transport.BarHeight}" />
      <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="Template">
        <ControlTemplate x:DataType="timelines:Transport">
          <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource EditorLineBrush}" BorderThickness="0,0,0,1" Padding="8,0">
            <DockPanel>
              <ContentPresenter x:Name="PART_Tools" DockPanel.Dock="Right" Content="{TemplateBinding Tools}" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="PART_Play" Theme="{StaticResource TransportButton}" Classes="play" ToolTip.Tip="Play or pause (Space)">
                  <Panel>
                    <PathIcon Classes="filled" Data="{x:Static shell:LucideIcons.Play}"
                              IsVisible="{Binding !Source.IsPlaying, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=True}" />
                    <PathIcon Classes="filled" Data="{x:Static shell:LucideIcons.Pause}"
                              IsVisible="{Binding Source.IsPlaying, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=False}" />
                  </Panel>
                </Button>
                <Button x:Name="PART_Stop" Theme="{StaticResource TransportButton}" ToolTip.Tip="Stop; again, back to the start"
                        IsVisible="{TemplateBinding ShowsStop}">
                  <PathIcon Classes="filled" Data="{x:Static shell:LucideIcons.Stop}" />
                </Button>
                <ToggleButton x:Name="PART_Loop" Theme="{StaticResource TransportToggle}" ToolTip.Tip="Go round at the end instead of stopping"
                              IsVisible="{TemplateBinding ShowsLoop}"
                              IsChecked="{Binding Source.IsLooping, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <PathIcon Data="{x:Static shell:LucideIcons.Repeat}" />
                </ToggleButton>
                <TextBlock x:Name="PART_Position" Text="{Binding Source.PositionText, RelativeSource={RelativeSource TemplatedParent}}"
                           FontSize="15" FontWeight="SemiBold" LetterSpacing="0.3" VerticalAlignment="Center" Margin="8,0,6,0" />
                <TextBlock x:Name="PART_Time" Classes="faint" Text="{Binding Source.TimeText, RelativeSource={RelativeSource TemplatedParent}}"
                           VerticalAlignment="Center" />
                <Border Classes="vsep" IsVisible="{TemplateBinding Fields, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ContentPresenter x:Name="PART_Fields" Content="{TemplateBinding Fields}" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- A trigger button: a cue, a shot. 24 px, radius 5, a 16 px key box, the icon, the name and a note; washed 14% in its
         colour while idle, filled while live, dashed and glowing while queued (the button draws its own ground). -->
    <ControlTheme x:Key="{x:Type timelines:TriggerButton}" TargetType="timelines:TriggerButton">
      <Setter Property="Height" Value="{x:Static timelines:TriggerButton.ButtonHeight}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,0,10,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel x:Name="PART_Row" Orientation="Horizontal" Spacing="7" Margin="{TemplateBinding Padding}" Background="Transparent">
            <Border x:Name="PART_Key" Width="{x:Static timelines:TriggerButton.KeyBox}" Height="{x:Static timelines:TriggerButton.KeyBox}" CornerRadius="3"
                    Background="{TemplateBinding KeyBoxBrush}" VerticalAlignment="Center"
                    IsVisible="{TemplateBinding Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{TemplateBinding Key}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource EditorCueInkBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <PathIcon x:Name="PART_Icon" Data="{TemplateBinding ShownIcon}" Width="11" Height="11" Foreground="{TemplateBinding Ink}" VerticalAlignment="Center"
                      IsVisible="{TemplateBinding ShownIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Ink}" VerticalAlignment="Center" />
            <TextBlock x:Name="PART_Note" Text="{TemplateBinding Note}" FontWeight="Normal" Foreground="{StaticResource EditorMutedTextBrush}"
                       VerticalAlignment="Center" IsVisible="{TemplateBinding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:live /template/ TextBlock#PART_Note">
        <Setter Property="Foreground" Value="{StaticResource EditorCueInkBrush}" />
        <Setter Property="Opacity" Value="0.75" />
      </Style>
      <Style Selector="^:queued">
        <Setter Property="Padding" Value="3,0,9,0" />
      </Style>
    </ControlTheme>
    <!-- The button group and the pill filter are lists drawn by the styles below. -->
    <ControlTheme x:Key="{x:Type timelines:ButtonGroup}" TargetType="timelines:ButtonGroup" BasedOn="{StaticResource {x:Type ListBox}}" />
    <ControlTheme x:Key="{x:Type lists:PillFilter}" TargetType="lists:PillFilter" BasedOn="{StaticResource {x:Type ListBox}}" />

    <!-- Mute and solo on a lane header or a channel strip: 18 by 16, radius 3, on the input colour; on, filled in the warning
         colour with dark ink. -->
    <ControlTheme x:Key="MuteSoloToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="16" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{StaticResource EditorMeterWarnBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EditorMeterWarnBrush}" />
        <Setter Property="Foreground" Value="{StaticResource EditorCueInkBrush}" />
      </Style>
    </ControlTheme>

    <!-- A channel strip: 88 px, its name on a raised 22 px header under a 3 px bar of its colour, the fader, two meters and the
         scale, the route, the gain and mute and solo; a bus's name bold on the base colour; a silent strip at 55%. -->
    <ControlTheme x:Key="{x:Type mix:ChannelStrip}" TargetType="mix:ChannelStrip">
      <Setter Property="Width" Value="{x:Static mix:ChannelStrip.StripWidth}" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{StaticResource EditorLineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,0,0,6">
              <Border x:Name="PART_Name" DockPanel.Dock="Top" Height="22" Background="{StaticResource EditorControlBrush}"
                      BorderBrush="{TemplateBinding Tint}" BorderThickness="0,3,0,0">
                <TextBlock x:Name="PART_Title" Text="{TemplateBinding Title}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="4,0" />
              </Border>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" Margin="0,5,0,0">
                <ToggleButton x:Name="PART_Mute" Theme="{StaticResource MuteSoloToggle}" Content="M" ToolTip.Tip="Mute"
                              IsChecked="{Binding IsMuted, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                <ToggleButton x:Name="PART_Solo" Theme="{StaticResource MuteSoloToggle}" Content="S" ToolTip.Tip="Solo"
                              IsVisible="{TemplateBinding ShowsSolo}"
                              IsChecked="{Binding IsSoloed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock x:Name="PART_Gain" DockPanel.Dock="Bottom" Text="{TemplateBinding GainText}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
              <ContentPresenter x:Name="PART_Route" DockPanel.Dock="Bottom" Content="{TemplateBinding Route}" HorizontalAlignment="Center" Margin="0,5,0,0" />
              <Grid x:Name="PART_Fader" ColumnDefinitions="18,3,8,3,8,3,22" Width="68" HorizontalAlignment="Center" Margin="0,5,0,0">
                <mix:Fader Grid.Column="0" Decibels="{Binding Decibels, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                           Maximum="{TemplateBinding Maximum}" />
                <mix:LevelMeter Grid.Column="2" Vertical="True" Level="{TemplateBinding Level}" Margin="0,8" />
                <mix:LevelMeter Grid.Column="4" Vertical="True" Level="{TemplateBinding Level}" Margin="0,8" />
                <mix:FaderScale Grid.Column="6" />
              </Grid>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:bus /template/ Border#PART_Name">
        <Setter Property="Background" Value="{StaticResource EditorFrameBrush}" />
      </Style>
      <Style Selector="^:bus /template/ TextBlock#PART_Title">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style Selector="^:silent">
        <Setter Property="Opacity" Value="0.55" />
      </Style>
    </ControlTheme>
    <!-- A row of a panel card: the label in a column 96 px wide or as wide as the card's longest label, the value beside it, or
         under it, indented, when it holds rows of its own. The row cuts its label before its value runs out of room. -->
    <ControlTheme x:Key="{x:Type controls:PanelRow}" TargetType="controls:PanelRow">
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="{x:Static controls:PanelRow.LabelColumn}" SharedSizeGroup="FieldLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PART_Label" Classes="fieldLabel" Text="{TemplateBinding Label}" />
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^:nested /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="10,2,0,0" />
      </Style>
    </ControlTheme>

    <!-- Tree rows: the same 22 px row, indented 14 px a level, with an outline chevron. -->
    <ControlTheme x:Key="TreeChevron" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="{StaticResource EditorRowHeight}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Panel>
              <PathIcon x:Name="Closed" Data="{x:Static shell:LucideIcons.Next}" Width="12" Height="12" />
              <PathIcon x:Name="Opened" Data="{x:Static shell:LucideIcons.Expand}" Width="12" Height="12" IsVisible="False" />
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ PathIcon#Closed">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:checked /template/ PathIcon#Opened">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="MinHeight" Value="{StaticResource EditorRowHeight}" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <Border x:Name="PART_LayoutRoot" Classes="TreeViewItemLayoutRoot" Focusable="True" Background="{TemplateBinding Background}"
                    MinHeight="{TemplateBinding MinHeight}" TemplatedControl.IsTemplateFocusTarget="True">
              <Grid x:Name="PART_Header" ColumnDefinitions="Auto,*"
                    Margin="{TemplateBinding Level, Mode=OneWay, Converter={x:Static shell:TreeIndent.FromLevel}}">
                <Panel Width="16" Margin="2,0,2,0">
                  <ToggleButton x:Name="PART_ExpandCollapseChevron" Theme="{StaticResource TreeChevron}" Focusable="False"
                                IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                </Panel>
                <ContentPresenter x:Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}" Focusable="False"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ItemsPresenter x:Name="PART_ItemsPresenter" IsVisible="{TemplateBinding IsExpanded}" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{StaticResource EditorRowHoverBrush}" />
      </Style>
      <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
        <Setter Property="BoxShadow" Value="{StaticResource EditorSelectedBar}" />
      </Style>
    </ControlTheme>

    <!-- Panel tabs: a 26 px strip on the base colour; the tab in front takes the panel's colour and joins it. -->
    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel Background="{TemplateBinding Background}">
            <Panel DockPanel.Dock="Top" Height="26" Background="{StaticResource EditorFrameBrush}">
              <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource EditorLineBrush}" />
              <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" HorizontalAlignment="Left" />
            </Panel>
            <ContentPresenter x:Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" Margin="{TemplateBinding Padding}" />
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
      <Setter Property="FontSize" Value="{StaticResource EditorFontSize}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_LayoutRoot" Background="{TemplateBinding Background}" BorderBrush="{StaticResource EditorLineBrush}"
                  BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      </Style>
    </ControlTheme>

    <!-- The item of a menu built from choices (MenuNode): its icon, its key and its submenu, or a separator. -->
    <ControlTheme x:Key="ChoiceMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="menus:MenuNode">
      <Setter Property="Header" Value="{Binding Header}" />
      <Setter Property="Command" Value="{Binding Command}" />
      <Setter Property="InputGesture" Value="{Binding Gesture, Converter={x:Static shell:KeyGestures.Parse}}" />
      <Setter Property="ItemsSource" Value="{Binding Children}" />
      <Setter Property="Icon">
        <Template>
          <PathIcon Data="{Binding Icon, Converter={x:Static shell:LucideIcons.ByName}}"
                    IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Template>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <!-- Text: every control inherits the window's size and colour. The window is the base the panels sit on. -->
  <Style Selector="Window">
    <Setter Property="FontSize" Value="{StaticResource EditorFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    <Setter Property="Background" Value="{StaticResource EditorFrameBrush}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- A well: an area of content (a tree, list, form or canvas) in the panel's colour. -->
  <Style Selector="Border.well">
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ListBox, TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- Splitters and grips are 1 px lines that can be grabbed 3 px to either side. -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="MinHeight" Value="1" />
    <Setter Property="ZIndex" Value="10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
          <Border Background="{TemplateBinding Background}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Columns]">
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="Margin" Value="-3,0" />
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Rows]">
    <Setter Property="Padding" Value="0,3" />
    <Setter Property="Margin" Value="0,-3" />
  </Style>
  <Style Selector="GridSplitter:pointerover, GridSplitter:pressed">
    <Setter Property="Background" Value="{StaticResource EditorAccentLineBrush}" />
  </Style>
  <Style Selector="controls|HeightGrip">
    <Setter Property="Height" Value="7" />
    <Setter Property="Margin" Value="0,-3,0,0" />
    <Setter Property="Padding" Value="0,3" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="ZIndex" Value="10" />
  </Style>
  <Style Selector="controls|HeightGrip > Border">
    <Setter Property="Background" Value="{StaticResource EditorLineBrush}" />
  </Style>
  <Style Selector="controls|HeightGrip:pointerover > Border">
    <Setter Property="Background" Value="{StaticResource EditorAccentLineBrush}" />
  </Style>

  <!-- Type: 13 semibold for names and titles, 12 semibold for section headers, 12 for everything else, 11 for hints and units,
       10.5 caps for group labels. -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource EditorTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{StaticResource EditorHeadingFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="10,6" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="PathIcon.muted">
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="PathIcon.faint">
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{StaticResource EditorSmallFontSize}" />
  </Style>
  <Style Selector="TextBlock.caps">
    <Setter Property="FontSize" Value="{StaticResource EditorCapsFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <!-- A key hint: Ctrl K, Shift A. -->
  <Style Selector="Border.kbd">
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontSize" Value="{StaticResource EditorCapsFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A small rounded label: a template's name, a count. -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource EditorControlBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip.outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.hsep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,5" />
    <Setter Property="Background" Value="{StaticResource EditorLineBrush}" />
  </Style>
  <Style Selector="Border.vsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="5,0" />
    <Setter Property="Background" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Buttons by role. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentInkBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FFB955" />
  </Style>
  <!-- Tags (owner, 2026-11-27, as Unreal's): a value's tags as chips with an x, a dashed "+ Tag" chip that opens the picker, and
       the picker: the project's tags as a tree with checkboxes, a search, a footer to add one, and add, rename and remove on a
       hovered row. -->
  <Style Selector="Border.tagChip">
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,0,3,0" />
    <Setter Property="Background" Value="{StaticResource EditorControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.tagChip TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tagChip PathIcon.tag">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Button.tagRemove">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="Button.tagRemove PathIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
  </Style>
  <Style Selector="Button.tagAdd">
    <Setter Property="Height" Value="20" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,0,8,0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="Button.tagAdd PathIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="FlyoutPresenter.bare">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MaxWidth" Value="320" />
  </Style>
  <Style Selector="Border.tagPicker">
    <Setter Property="Width" Value="300" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorHintBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.tagPickerBar">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
  </Style>
  <Style Selector="Border.tagRow">
    <Setter Property="Height" Value="23" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,0,8,0" />
  </Style>
  <Style Selector="Border.tagRow:pointerover">
    <Setter Property="Background" Value="{StaticResource EditorControlBrush}" />
  </Style>
  <Style Selector="Border.tagRow StackPanel.tagActions">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.tagRow:pointerover StackPanel.tagActions">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.tagCheck">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorHintBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.tagCheck.part">
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Border.tagCheck.on">
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Border.tagCheck PathIcon">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentInkBrush}" />
  </Style>
  <Style Selector="Border.tagCheck Rectangle">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="2" />
    <Setter Property="Fill" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Button.tagAction">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="Button.tagAction PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="TextBox.tagRename">
    <Setter Property="Height" Value="19" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Button.delete">
    <Setter Property="Foreground" Value="{StaticResource EditorDeleteBrush}" />
  </Style>
  <!-- Quiet: no box until hovered; the bars' and headers' buttons. -->
  <Style Selector=":is(Button).quiet, :is(Button).icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
    <Setter Property="Padding" Value="7,0" />
  </Style>
  <Style Selector=":is(Button).icon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector=":is(Button).icon.small">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector=":is(Button).icon.small PathIcon, PathIcon.small">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="ToggleButton.icon:checked, ToggleButton.quiet:checked">
    <Setter Property="Foreground" Value="{StaticResource EditorAccentInkBrush}" />
  </Style>
  <!-- An icon button that shows something is on: Play while the music plays. -->
  <Style Selector="Button.icon.on">
    <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentInkBrush}" />
  </Style>
  <Style Selector="Button.icon.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Button.icon.save">
    <Setter Property="Foreground" Value="{StaticResource EditorSaveBrush}" />
  </Style>
  <Style Selector="Button.icon.delete">
    <Setter Property="Foreground" Value="{StaticResource EditorDeleteBrush}" />
  </Style>
  <Style Selector="Button.icon.bake">
    <Setter Property="Foreground" Value="{StaticResource EditorBakeBrush}" />
  </Style>

  <!-- Fields: 20 px inside a 22 px row, 3 px corners, the deepest colour, an amber border when focused. -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="{StaticResource EditorFieldCornerRadius}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="AutoCompleteBox">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="{StaticResource EditorFieldCornerRadius}" />
  </Style>
  <Style Selector="TextBox.drag">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>
  <Style Selector="TextBox.drag:pointerover /template/ Border#PART_BorderElement, TextBox.drag:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
  </Style>
  <Style Selector="TextBox.drag.typing">
    <Setter Property="Cursor" Value="Ibeam" />
  </Style>
  <!-- A number box's axis letter, unit and the fill that shows where it sits in its range. -->
  <Style Selector="TextBlock.axis">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="5,0,0,0" />
  </Style>
  <Style Selector="TextBlock.unit">
    <Setter Property="FontSize" Value="{StaticResource EditorSmallFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!-- Menus. -->
  <Style Selector="MenuItem">
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="MenuFlyoutPresenter, ContextMenu, MenuItem /template/ Popup > Border">
    <Setter Property="MaxHeight" Value="{StaticResource EditorMenuMaxHeight}" />
  </Style>
  <Style Selector="ContextMenu, MenuFlyoutPresenter">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
  </Style>

  <!-- The asset picker (AssetPickerView): a field showing the current file, over a popup like the searchable menu. -->
  <Style Selector="ToggleButton.asset">
    <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource EditorFieldCornerRadius}" />
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    <Setter Property="Padding" Value="6,0,5,0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ToggleButton.asset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="ToggleButton.asset:checked">
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.asset:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Border.pickerPopup">
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource EditorWellCornerRadius}" />
    <Setter Property="BoxShadow" Value="{StaticResource EditorPopupShadow}" />
  </Style>
  <Style Selector="Button.pickerNone">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>

  <!-- The search box (SearchBox) and the searchable menu (SearchMenu). -->
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="{StaticResource EditorSearchCornerRadius}" />
    <Setter Property="Padding" Value="4,1,4,1" />
  </Style>
  <Style Selector="TextBox.search PathIcon.searchGlass">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Margin" Value="7,0,0,0" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="TextBox.search Button.searchClear">
    <Setter Property="Margin" Value="0,0,2,0" />
  </Style>
  <!-- A search row at the top of a panel: no box, only a line under it. -->
  <Style Selector="TextBox.search.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="TextBox.search.row:focus /template/ Border#PART_BorderElement, TextBox.search.row:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.searchRow">
    <Setter Property="Height" Value="26" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,4,0" />
  </Style>
  <Style Selector="Border.searchRow TextBox.search.row">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="25" />
  </Style>
  <Style Selector="Border.searchRow TextBox.search.row:focus /template/ Border#PART_BorderElement, Border.searchRow TextBox.search.row:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- A panel tab's header: an icon, then its name. -->
  <Style Selector="StackPanel.tabHeader">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="StackPanel.tabHeader > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="FlyoutPresenter.searchMenu">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="640" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
  </Style>
  <Style Selector="ListBox.menuRows ListBoxItem">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="ListBox.menuRows ListBoxItem:disabled">
    <Setter Property="Padding" Value="12,6,12,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBlock.menuHeading">
    <Setter Property="FontSize" Value="{StaticResource EditorCapsFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.menuDetail">
    <Setter Property="FontSize" Value="{StaticResource EditorSmallFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>

  <!-- The flow graph: nodes with a tinted header, ring pins, the pill over the canvas and the minimap. -->
  <Style Selector="Border.flowNode">
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #99000000" />
  </Style>
  <Style Selector="Border.flowNode.selected">
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BoxShadow" Value="0 0 14 0 #66F5A639" />
  </Style>
  <Style Selector="Border.flowHeader">
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Border.flowHeader TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.minimap">
    <Setter Property="Background" Value="{StaticResource EditorOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorOverlayLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource EditorFloatCornerRadius}" />
    <Setter Property="BoxShadow" Value="{StaticResource EditorFloatShadow}" />
    <Setter Property="Width" Value="168" />
    <Setter Property="Height" Value="104" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ListBox.nodeList ListBoxItem">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- The scene outline: type icons in the hint colour, folders warmer; nested entities dimmer, hidden ones faint. -->
  <Style Selector="PathIcon.outlineIcon">
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="PathIcon.outlineIcon.folder">
    <Setter Property="Foreground" Value="{StaticResource EditorFolderBrush}" />
  </Style>
  <Style Selector="TextBlock.outlineName.folder">
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.outlineName.nested">
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.outlineName.hidden">
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="PathIcon.outlineIcon.hidden">
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector=":is(Button).icon.outlineRow">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector=":is(Button).icon.outlineRow PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>
  <!-- A row's eye shows on the row under the pointer, on the selected row and on a hidden entity. -->
  <Style Selector="TreeViewItem :is(Button).rowEye">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover :is(Button).rowEye, TreeViewItem:selected /template/ Border#PART_LayoutRoot :is(Button).rowEye, TreeViewItem :is(Button).rowEye.on">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- The button group (rule R28): joined tabs on a 26 px bar, the chosen one raised with an accent bar at its foot; with
       chips, rounded filters, the chosen one washed in the accent. -->
  <Style Selector="timelines|ButtonGroup">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="timelines|ButtonGroup ListBoxItem">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="Height" Value="25" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="timelines|ButtonGroup ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="timelines|ButtonGroup ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource EditorTabBottomBar}" />
  </Style>
  <Style Selector="timelines|ButtonGroup.chips ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0,0,3,0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="timelines|ButtonGroup.chips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentLineBrush}" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <!-- A field on a transport bar: 22 px, radius 4, on the input colour, its name faint before its value. -->
  <Style Selector="Border.transportField">
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.transportField > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.transportField TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.transportField TextBlock.name">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="Border.transportField TextBox, Border.transportField ComboBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.transportField TextBox /template/ Border#PART_BorderElement, Border.transportField ComboBox /template/ Border#Background">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- The pill filter (rule R28): a wrapping row of 20 px pills, radius 10, on the raised colour with a line border, each with
       its count faint; the chosen one washed in the accent with an accent border and a cross; the add pill dashed. -->
  <Style Selector="lists|PillFilter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="corelists:FilterPill">
        <Panel>
          <Rectangle x:Name="PillDash" Stroke="{StaticResource EditorHintBrush}" StrokeThickness="1" StrokeDashArray="3,2" RadiusX="10" RadiusY="10"
                     IsVisible="{Binding IsAdd}" Margin="-6,-1" />
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <PathIcon Width="10" Height="10" Data="{x:Static shell:LucideIcons.Add}" IsVisible="{Binding IsAdd}" Foreground="{StaticResource EditorHintBrush}" />
            <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CountText}" FontSize="10.5" Foreground="{StaticResource EditorHintBrush}" VerticalAlignment="Center"
                       IsVisible="{Binding !IsAdd}" />
            <PathIcon Width="10" Height="10" Data="{x:Static shell:LucideIcons.Close}" Foreground="{StaticResource EditorMutedTextBrush}"
                      IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
          </StackPanel>
        </Panel>
      </DataTemplate>
    </Setter>
  </Style>
  <Style Selector="lists|PillFilter ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Height" Value="{x:Static lists:PillFilter.PillHeight}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="Background" Value="{StaticResource EditorControlBrush}" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="lists|PillFilter ListBoxItem.add">
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="lists|PillFilter ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="lists|PillFilter ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- The category rail: a 30 px column of icon buttons; the chosen one washed, with a 2 px bar at the panel's edge. -->
  <Style Selector="ListBox.rail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rail ListBoxItem">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="3,1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.rail ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="ListBox.rail ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="-3 0 0 -1 #F5A639" />
  </Style>

  <Style Selector="Border.rail">
    <Setter Property="Width" Value="30" />
    <Setter Property="Background" Value="{StaticResource EditorFrameBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="0,5" />
  </Style>
  <Style Selector=":is(Button).railButton">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="3,1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector=":is(Button).railButton.on, ToggleButton.railButton:checked">
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector=":is(Button).railButton.on /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.railButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
    <Setter Property="BoxShadow" Value="-3 0 0 -1 #F5A639" />
  </Style>
  <!-- The inspector's header: the entity's icon on a tile, its name over where it is. -->
  <Style Selector="Border.entityHeader">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.iconTile">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{StaticResource EditorControlBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.iconTile > PathIcon">
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <!-- A tile that is clicked to pick another icon, and the icons it offers. -->
  <Style Selector="Button.iconTile">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{StaticResource EditorControlBrush}" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.iconChoices">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.iconChoices ListBoxItem">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.iconChoices ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Button.addRow">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- A panel row's label; the row narrows it further as the panel narrows. -->
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="MaxWidth" Value="170" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- The top bar (30 px): the project menu, the document tabs, the command search, then unsaved work, undo, Compile and Play. -->
  <Style Selector="Border.topBar">
    <Setter Property="Height" Value="30" />
    <Setter Property="Background" Value="{StaticResource EditorFrameBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="PathIcon.logo">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Button.project">
    <Setter Property="Height" Value="29" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="Button.unsaved">
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <!-- A document tab: the level, or an editor opened in place; the one shown has a 2 px amber bar on top. -->
  <Style Selector="ListBox.docTabs ListBoxItem">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="29" />
    <Setter Property="Height" Value="29" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="ListBox.docTabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="ListBox.docTabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource EditorTabTopBar}" />
  </Style>
  <Style Selector="Button.docTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,1,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="29" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="Button.docTab.shown">
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="Button.docTab.shown /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource EditorTabTopBar}" />
  </Style>
  <Style Selector="Ellipse.unsavedDot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The command search in the middle of the top bar. -->
  <Style Selector="Button.command">
    <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Width" Value="380" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.command:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <!-- The window's own buttons. -->
  <Style Selector="Button.caption">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="29" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="Button.caption PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorDeleteBrush}" />
  </Style>

  <!-- The bottom strip (24 px): the docks' tabs, the last message, then tasks, the selection and the GPU. -->
  <Style Selector="Border.strip">
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="{StaticResource EditorFrameBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.strip TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.stripTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="Height" Value="23" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.stripTab:checked">
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.stripTab:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource EditorTabTopBar}" />
  </Style>
  <!-- The bus a mixer strip goes to: a choice small enough to sit under the fader. -->
  <Style Selector="ComboBox.route">
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="70" />
    <Setter Property="Padding" Value="4,0,0,0" />
    <Setter Property="FontSize" Value="{StaticResource EditorCapsFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}" />
  </Style>
  <!-- A layer's header beside its lane; the picked layer's is tinted. -->
  <Style Selector="Border.laneHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
  </Style>
  <Style Selector="Border.laneHeader.selected">
    <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
  </Style>
  <Style Selector="Border.stripCell">
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <!-- Over the viewport: pills floating on the picture at 88% opacity, 28 px tall, holding 22 px buttons. -->
  <Style Selector="Border.viewportBar">
    <Setter Property="Background" Value="{StaticResource EditorOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorOverlayLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource EditorFloatCornerRadius}" />
    <Setter Property="BoxShadow" Value="{StaticResource EditorFloatShadow}" />
    <Setter Property="Padding" Value="3,2" />
    <Setter Property="Height" Value="28" />
  </Style>

  <!-- A bar along the viewport's bottom shows its tips above it: below the pointer they have no room, and a tip over the pointer takes the click. -->
  <Style Selector="Border.viewportBar.low :is(Button)">
    <Setter Property="ToolTip.Placement" Value="Top" />
    <Setter Property="ToolTip.VerticalOffset" Value="-6" />
  </Style>
  <Style Selector=":is(Button).viewportIcon">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector=":is(Button).viewportIcon.text">
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="ToggleButton.viewportIcon:checked">
    <Setter Property="Foreground" Value="{StaticResource EditorAccentInkBrush}" />
  </Style>
  <Style Selector="ToggleButton.viewportIcon.flat:checked">
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.viewportIcon.flat:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="PathIcon.accent">
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="ComboBox.viewportSnap">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5,0,0,0" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- The tool rail's buttons are square, and the one in hand is filled. -->
  <Style Selector="ToggleButton.viewportIcon.rail">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.viewportIcon.accent">
    <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentInkBrush}" />
  </Style>
  <!-- A message floating at the bottom left of the picture. -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{StaticResource EditorOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorOverlayLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <!-- A dock's tab bar, 26 px, holding a button group; the Day dock's 20 px value rows. -->
  <Style Selector="Border.dockTabs">
    <Setter Property="Height" Value="26" />
    <Setter Property="Background" Value="{StaticResource EditorFrameBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBlock.fieldLabel.undrawn">
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="ToggleButton.eye:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.eye:checked">
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.eye">
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="Border.transport">
    <Setter Property="Height" Value="26" />
    <Setter Property="Background" Value="{StaticResource EditorFrameBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="TextBlock.stripName">
    <Setter Property="FontSize" Value="{StaticResource EditorCapsFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentInkBrush}" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A folder's tile: a dashed frame in place of a thumbnail. -->
  <Style Selector="Rectangle.folderFrame">
    <Setter Property="Stroke" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="3,3" />
    <Setter Property="RadiusX" Value="4" />
    <Setter Property="RadiusY" Value="4" />
  </Style>
  <!-- The content drawer's header (30 px on the base colour): the breadcrumb, the search, the chips, then New, Import and Close. -->
  <Style Selector="Border.drawerHeader">
    <Setter Property="Height" Value="30" />
    <Setter Property="Background" Value="{StaticResource EditorFrameBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="PathIcon.tileIcon">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
  </Style>
  <Style Selector="TextBlock.tileKind">
    <Setter Property="FontSize" Value="{StaticResource EditorCapsFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <!-- The content drawer's tiles: a 104 by 78 thumbnail with its type's colour along the bottom, the name and the kind. -->
  <Style Selector="ListBox.tiles ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="ListBox.tiles ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.tiles ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="Border.thumb">
    <Setter Property="Width" Value="104" />
    <Setter Property="Height" Value="78" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.thumb.folder">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tiles ListBoxItem:pointerover Border.thumb">
    <Setter Property="BorderBrush" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="ListBox.tiles ListBoxItem:selected Border.thumb">
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="BoxShadow" Value="0 0 0 1 #F5A639" />
  </Style>

  <!-- The building creator's Tool tab (rule R3: hairlines, warm colours): segmented choices, row actions, list rows. -->
  <Style Selector="ToggleButton.segment">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{StaticResource EditorDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1,1,0,1" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentLineBrush}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked">
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Button.toolAction">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Background" Value="{StaticResource EditorControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.toolAction.accentOutline">
    <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
  <Style Selector="Button.listRow">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="2,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.listRow PathIcon.rowIcon">
    <Setter Property="Foreground" Value="{StaticResource EditorHintBrush}" />
  </Style>
  <Style Selector="Button.listRow.chosen /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
  </Style>
  <Style Selector="Button.listRow.warning TextBlock.rowLabel">
    <Setter Property="Foreground" Value="{StaticResource EditorDeleteBrush}" />
  </Style>
  <Style Selector="Button.listRow.warning PathIcon.rowIcon">
    <Setter Property="Foreground" Value="{StaticResource EditorDeleteBrush}" />
  </Style>

  <!-- The building creator over the viewport: labels of rooms, sizes and drags, and the storey switcher. -->
  <Style Selector="Border.planRoom">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.planRoom TextBlock.title">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.planTag">
    <Setter Property="Background" Value="{StaticResource EditorOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorOverlayLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.planTag.drag">
    <Setter Property="BorderBrush" Value="{StaticResource EditorAccentLineBrush}" />
  </Style>
  <Style Selector="Border.planTag.drag TextBlock.title">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.planTag.cut">
    <Setter Property="BorderBrush" Value="{StaticResource EditorDeleteBrush}" />
  </Style>
  <Style Selector="Border.planTag.cut TextBlock.title">
    <Setter Property="Foreground" Value="{StaticResource EditorDeleteBrush}" />
  </Style>
  <!-- A warning over the viewport: the overlay's dark panel with a hairline in the warning colour, taken away by a click. -->
  <Style Selector="Button.toast">
    <Setter Property="Background" Value="{StaticResource EditorOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorDeleteBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource EditorFloatCornerRadius}" />
    <Setter Property="Padding" Value="10,6,12,6" />
    <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.toast /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{StaticResource EditorFloatShadow}" />
  </Style>
  <Style Selector="Button.toast:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorDeleteBrush}" />
  </Style>
  <Style Selector="Button.toast PathIcon">
    <Setter Property="Foreground" Value="{StaticResource EditorDeleteBrush}" />
  </Style>
  <Style Selector="ListBox.storeys ListBoxItem">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ListBox.storeys ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EditorAccentSoftBrush}" />
  </Style>
  <Style Selector="ListBox.storeys ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
  </Style>
</Styles>
