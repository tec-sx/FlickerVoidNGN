<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:textures="using:FlickerVoid.Editor.Assets.Textures"
        xmlns:inspector="using:FlickerVoid.Editor.Core.Inspector"
        x:Class="FlickerVoid.Editor.Textures.TextureEditorWindow"
        x:DataType="textures:TextureEditorViewModel"
        Title="{Binding Heading, StringFormat='Texture Editor - {0}'}"
        Width="900" Height="560">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>
  <Grid ColumnDefinitions="Auto,*">
    <!-- The preview: what the build makes of the image, or the canvas repeated by its tiling. -->
    <StackPanel Grid.Column="0" Margin="12" Spacing="8">
      <Border Classes="well" Width="384" Height="384" ClipToBounds="True">
        <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
      </Border>
      <TextBlock Text="{Binding Summary}" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="384" Foreground="#E0AC2C" />
    </StackPanel>
    <!-- The settings, held unsaved as they change until saved or discarded. -->
    <Border Grid.Column="1" Classes="well" Margin="0,12,12,12">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Save" Classes="save" Command="{Binding SaveCommand}" ToolTip.Tip="Save the settings (Ctrl+S); the content build makes the texture again." />
            <Button Content="Discard" Classes="delete" Command="{Binding DiscardCommand}" ToolTip.Tip="Forget the unsaved edits." />
          </StackPanel>
          <TextBlock Text="{Binding Heading}" Classes="heading" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Fields}" Margin="12,0,12,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="inspector:FieldViewModel">
                <Grid ColumnDefinitions="110,*" Margin="0,3">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <ContentControl Grid.Column="1" Content="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
