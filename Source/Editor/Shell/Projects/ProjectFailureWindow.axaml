<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:projects="using:FlickerVoid.Editor.Projects"
        x:Class="FlickerVoid.Editor.Projects.ProjectFailureWindow"
        x:DataType="projects:ProjectOpenFailure"
        Title="{Binding Project, StringFormat='{}{0} failed to open'}"
        Width="820" Height="520" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
               Text="{Binding Project, StringFormat='{}{0} failed to open:'}" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Copy" Click="HandleCopyClick" />
      <Button Content="Close" Click="HandleCloseClick" IsDefault="True" IsCancel="True" />
    </StackPanel>
    <TextBox x:Name="Log" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="12"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
