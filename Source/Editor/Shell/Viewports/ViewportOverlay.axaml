<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:FlickerVoid.Editor"
             xmlns:viewports="using:FlickerVoid.Editor.Viewports"
             xmlns:shots="using:FlickerVoid.Editor.Shots"
             xmlns:inspector="using:FlickerVoid.Editor.Inspector"
             x:Class="FlickerVoid.Editor.Viewports.ViewportOverlay"
             x:DataType="viewports:ViewportViewModel">
  <Panel>
    <StackPanel Orientation="Horizontal" Spacing="1" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Border Classes="viewportBar">
        <StackPanel Orientation="Horizontal">
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding IsSelectMode}" ToolTip.Tip="Select (Q)">
            <PathIcon Data="{x:Static shell:MaterialIcons.Select}" />
          </ToggleButton>
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding IsMoveMode}" ToolTip.Tip="Move (W)">
            <PathIcon Data="{x:Static shell:MaterialIcons.Move}" />
          </ToggleButton>
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding IsRotateMode}" ToolTip.Tip="Rotate (E)">
            <PathIcon Data="{x:Static shell:MaterialIcons.Rotate}" />
          </ToggleButton>
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding IsScaleMode}" ToolTip.Tip="Scale (R)">
            <PathIcon Data="{x:Static shell:MaterialIcons.Scale}" />
          </ToggleButton>
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding IsLocalSpace}" ToolTip.Tip="World or local axes">
            <Panel>
              <PathIcon Data="{x:Static shell:MaterialIcons.WorldSpace}" IsVisible="{Binding !IsLocalSpace}" />
              <PathIcon Data="{x:Static shell:MaterialIcons.LocalSpace}" IsVisible="{Binding IsLocalSpace}" />
            </Panel>
          </ToggleButton>
        </StackPanel>
      </Border>
      <Border Classes="viewportBar">
        <StackPanel Orientation="Horizontal">
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding Gizmo.MoveSnap.IsOn}" ToolTip.Tip="Snap moves to the grid, in world units">
            <PathIcon Data="{x:Static shell:MaterialIcons.Grid}" />
          </ToggleButton>
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding ShowDepthFade}" ToolTip.Tip="Depth fade (the main camera's)">
            <PathIcon Data="{x:Static shell:MaterialIcons.DepthFade}" />
          </ToggleButton>
          <ComboBox Classes="viewportSnap" ItemsSource="{Binding Gizmo.MoveSnap.Steps}" SelectedItem="{Binding Gizmo.MoveSnap.Step}"
                    ToolTip.Tip="Grid size, in world units" />
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding Gizmo.RotateSnap.IsOn}" ToolTip.Tip="Snap turns to steps, in degrees">
            <PathIcon Data="{x:Static shell:MaterialIcons.Rotate}" />
          </ToggleButton>
          <ComboBox Classes="viewportSnap" ItemsSource="{Binding Gizmo.RotateSnap.Steps}" SelectedItem="{Binding Gizmo.RotateSnap.Step}"
                    ToolTip.Tip="Turn step, in degrees" />
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding Gizmo.ScaleSnap.IsOn}" ToolTip.Tip="Snap scaling to steps of the starting scale">
            <PathIcon Data="{x:Static shell:MaterialIcons.Scale}" />
          </ToggleButton>
          <ComboBox Classes="viewportSnap" ItemsSource="{Binding Gizmo.ScaleSnap.Steps}" SelectedItem="{Binding Gizmo.ScaleSnap.Step}"
                    ToolTip.Tip="Scale step, as a share of the starting scale" />
        </StackPanel>
      </Border>
      <Border Classes="viewportBar">
        <StackPanel Orientation="Horizontal">
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding IsPerspective}" ToolTip.Tip="Perspective or orthographic view">
            <PathIcon Data="{x:Static shell:MaterialIcons.Perspective}" />
          </ToggleButton>
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding ShowGrid}" ToolTip.Tip="Grid">
            <PathIcon Data="{x:Static shell:MaterialIcons.Grid}" />
          </ToggleButton>
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding ShowDepthFade}" ToolTip.Tip="Depth fade (the main camera's)">
            <PathIcon Data="{x:Static shell:MaterialIcons.DepthFade}" />
          </ToggleButton>
        </StackPanel>
      </Border>
    </StackPanel>
    <!-- The creator's mesh mode: element kind, tools with their numbers, mirror and the door test, along the bottom. -->
    <Border Classes="viewportBar" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
            IsVisible="{Binding MeshTools.IsMeshMode}">
      <StackPanel Orientation="Horizontal" Spacing="2" DataContext="{Binding MeshTools}" x:DataType="viewports:MeshToolsViewModel">
        <RadioButton GroupName="MeshElement" Content="Point" IsChecked="{Binding IsPoint}" ToolTip.Tip="Points (1)" />
        <RadioButton GroupName="MeshElement" Content="Edge" IsChecked="{Binding IsEdge}" ToolTip.Tip="Edges (2)" />
        <RadioButton GroupName="MeshElement" Content="Face" IsChecked="{Binding IsFace}" ToolTip.Tip="Faces (3)" />
        <Rectangle Width="1" Fill="{StaticResource EditorLineBrush}" Margin="2,0" />
        <Button Content="Extrude" Command="{Binding ExtrudeCommand}" ToolTip.Tip="Extrude the faces by the amount (E)" />
        <Button Content="Inset" Command="{Binding InsetCommand}" ToolTip.Tip="Inset the faces by the thickness (I)" />
        <Button Content="Cut" Command="{Binding CutCommand}" ToolTip.Tip="Cut the faces in by the amount, or through (C)" />
        <Button Content="Bevel" Command="{Binding BevelCommand}" ToolTip.Tip="Bevel the edges by the thickness (Ctrl+B)" />
        <Button Content="Loop" Command="{Binding LoopCutCommand}" ToolTip.Tip="Cut loops through the face under the mouse (Ctrl+R)" />
        <Button Content="Door" Command="{Binding HangDoorCommand}" ToolTip.Tip="Hang a door in the face under the mouse (D)" />
        <Button Content="Test" Command="{Binding TestCommand}" ToolTip.Tip="Open or shut the selected door" />
        <Rectangle Width="1" Fill="{StaticResource EditorLineBrush}" Margin="2,0" />
        <ToggleButton Content="Mirror" IsChecked="{Binding Mirror}" ToolTip.Tip="Edits are made on both sides of the centre line" />
        <ToggleButton Content="Round" IsChecked="{Binding Round}" ToolTip.Tip="Round bevels" />
        <ToggleButton Content="Through" IsChecked="{Binding Through}" ToolTip.Tip="Cuts and doors go through the whole part" />
        <ToggleButton Content="Outward" IsChecked="{Binding Outward}" ToolTip.Tip="Doors swing out of the face" />
        <inspector:DragNumberBox Width="56" Value="{Binding Amount}" Minimum="0" ToolTip.Tip="Amount: extrude and cut depth, in metres" />
        <inspector:DragNumberBox Width="56" Value="{Binding Thickness}" Minimum="0" ToolTip.Tip="Thickness: inset, bevel width and door depth, in metres" />
        <inspector:DragNumberBox Width="44" Value="{Binding Rows}" Minimum="1" Maximum="8" Step="1" ToolTip.Tip="Bevel rows" />
        <inspector:DragNumberBox Width="44" Value="{Binding Cuts}" Minimum="1" Maximum="8" Step="1" ToolTip.Tip="Loop cuts" />
        <inspector:DragNumberBox Width="48" Value="{Binding Slide}" Minimum="-1" Maximum="1" ToolTip.Tip="Loop slide, -1 to 1" />
        <inspector:DragNumberBox Width="52" Value="{Binding Angle}" Minimum="1" Maximum="170" Step="1" ToolTip.Tip="Door angle, in degrees" />
        <Rectangle Width="1" Fill="{StaticResource EditorLineBrush}" Margin="2,0" />
        <ComboBox SelectedIndex="{Binding TransformToolIndex}" ToolTip.Tip="Numeric move, rotate or scale of the selection">
          <ComboBoxItem>Move</ComboBoxItem>
          <ComboBoxItem>Rotate</ComboBoxItem>
          <ComboBoxItem>Scale</ComboBoxItem>
        </ComboBox>
        <inspector:DragNumberBox Width="52" Value="{Binding TransformX}" AxisBrush="{StaticResource EditorAxisXBrush}" ToolTip.Tip="X" />
        <inspector:DragNumberBox Width="52" Value="{Binding TransformY}" AxisBrush="{StaticResource EditorAxisYBrush}" ToolTip.Tip="Y" />
        <inspector:DragNumberBox Width="52" Value="{Binding TransformZ}" AxisBrush="{StaticResource EditorAxisZBrush}" ToolTip.Tip="Z" />
        <Button Content="Apply" Command="{Binding ApplyTransformCommand}" ToolTip.Tip="Do it to the selection" />
      </StackPanel>
    </Border>
    <!-- The selected shot's timeline, left of the camera preview in the bottom right corner. -->
    <Grid ColumnDefinitions="3*,*" VerticalAlignment="Bottom" IsVisible="{Binding Timeline.HasShot}">
      <Border Classes="viewportBar" Margin="4,4,8,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Classes="icon" Command="{Binding AddShotKeyCommand}"
                    ToolTip.Tip="Add a key where the view stands, at the scrubbed time.">
              <PathIcon Data="{x:Static shell:MaterialIcons.Add}" />
            </Button>
            <Button Classes="icon delete" Command="{Binding Timeline.DeleteSelectedKeyCommand}" ToolTip.Tip="Delete the selected key.">
              <PathIcon Data="{x:Static shell:MaterialIcons.Remove}" />
            </Button>
          </StackPanel>
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0" MinWidth="48" TextAlignment="Right"
                     Text="{Binding Timeline.ScrubTime, StringFormat={}{0:0.00} s}" />
          <shots:ShotTimelineStrip Timeline="{Binding Timeline}" Height="28" />
        </DockPanel>
      </Border>
    </Grid>
    <StackPanel Margin="4" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top">
      <viewports:NavigationGizmo Width="80" Height="80" Camera="{Binding Camera}" />
      <viewports:CameraDragButton Classes="viewportRound" Drag="Pan" Camera="{Binding Camera}"
                                  ViewportHeight="{Binding $parent[UserControl].Bounds.Height}" ToolTip.Tip="Drag to pan the view.">
        <PathIcon Data="{x:Static shell:MaterialIcons.Pan}" />
      </viewports:CameraDragButton>
      <viewports:CameraDragButton Classes="viewportRound" Drag="Zoom" Camera="{Binding Camera}" ToolTip.Tip="Drag to zoom the view.">
        <PathIcon Data="{x:Static shell:MaterialIcons.Zoom}" />
      </viewports:CameraDragButton>
    </StackPanel>
  </Panel>
</UserControl>
