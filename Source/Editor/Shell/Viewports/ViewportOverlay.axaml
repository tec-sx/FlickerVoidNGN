<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:FlickerVoid.Editor"
             xmlns:viewports="using:FlickerVoid.Editor.Viewports"
             xmlns:inspector="using:FlickerVoid.Editor.Inspector"
             xmlns:shots="using:FlickerVoid.Editor.Shots"
             x:Class="FlickerVoid.Editor.Viewports.ViewportOverlay"
             x:DataType="viewports:ViewportViewModel">
  <Panel>
    <!-- Top left, the tools in hand: select, move, turn and scale, the axes they follow, and the snap of the tool chosen. -->
    <Border Classes="viewportBar" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal">
        <!-- A creator's object or mesh, and in the mesh the kind of element a click selects. -->
        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsCreating}" DataContext="{Binding MeshTools}" x:DataType="viewports:MeshToolsViewModel">
          <ToggleButton Classes="viewportIcon text" IsChecked="{Binding !IsMeshMode}" Command="{Binding LeaveCommand}" ToolTip.Tip="Move and select the creation's parts">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static shell:LucideIcons.Cube}" />
              <TextBlock Text="Object" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="viewportIcon text" IsChecked="{Binding IsMeshMode, Mode=OneWay}" Command="{Binding ToggleMeshCommand}"
                        ToolTip.Tip="Edit the mesh of the selected part (Tab); click a part first">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static shell:LucideIcons.Grid}" />
              <TextBlock Text="Mesh" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <StackPanel Orientation="Horizontal" IsVisible="{Binding IsMeshMode}">
            <Border Classes="vsep" />
            <ToggleButton Classes="viewportIcon text" IsChecked="{Binding IsPoint}" ToolTip.Tip="Points (1)" Content="Point" />
            <ToggleButton Classes="viewportIcon text" IsChecked="{Binding IsEdge}" ToolTip.Tip="Edges (2)" Content="Edge" />
            <ToggleButton Classes="viewportIcon text" IsChecked="{Binding IsFace}" ToolTip.Tip="Faces (3)" Content="Face" />
          </StackPanel>
          <Border Classes="vsep" />
        </StackPanel>
        <ToggleButton Classes="viewportIcon text flat" IsChecked="{Binding IsLocalSpace}" ToolTip.Tip="The axes the handles follow: the world's, or the selected entity's own.">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Panel>
              <PathIcon Data="{x:Static shell:LucideIcons.WorldSpace}" IsVisible="{Binding !IsLocalSpace}" />
              <PathIcon Data="{x:Static shell:LucideIcons.LocalSpace}" IsVisible="{Binding IsLocalSpace}" />
            </Panel>
            <Panel>
              <TextBlock Text="World" IsVisible="{Binding !IsLocalSpace}" VerticalAlignment="Center" />
              <TextBlock Text="Local" IsVisible="{Binding IsLocalSpace}" VerticalAlignment="Center" />
            </Panel>
          </StackPanel>
        </ToggleButton>
        <Border Classes="vsep" />
        <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowsMoveSnap}">
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding Gizmo.MoveSnap.IsOn}" ToolTip.Tip="Snap moves to the grid">
            <PathIcon Data="{x:Static shell:LucideIcons.Snap}" />
          </ToggleButton>
          <ComboBox Classes="viewportSnap" ItemsSource="{Binding Gizmo.MoveSnap.Steps}" SelectedItem="{Binding Gizmo.MoveSnap.Step}"
                    ToolTip.Tip="Grid size, in metres">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat='{}{0} m'}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsRotateMode}">
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding Gizmo.RotateSnap.IsOn}" ToolTip.Tip="Snap turns to steps">
            <PathIcon Data="{x:Static shell:LucideIcons.Snap}" />
          </ToggleButton>
          <ComboBox Classes="viewportSnap" ItemsSource="{Binding Gizmo.RotateSnap.Steps}" SelectedItem="{Binding Gizmo.RotateSnap.Step}"
                    ToolTip.Tip="Turn step, in degrees">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat='{}{0}°'}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsScaleMode}">
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding Gizmo.ScaleSnap.IsOn}" ToolTip.Tip="Snap scaling to steps of the starting scale">
            <PathIcon Data="{x:Static shell:LucideIcons.Snap}" />
          </ToggleButton>
          <ComboBox Classes="viewportSnap" ItemsSource="{Binding Gizmo.ScaleSnap.Steps}" SelectedItem="{Binding Gizmo.ScaleSnap.Step}"
                    ToolTip.Tip="Scale step, as a share of the starting scale">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat='{}{0} x'}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- A selected greybox of the level: shape it with the mesh tools, or cut the other selected greyboxes out of it. -->
    <Border Classes="viewportBar" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding CanShapeSelected}">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="viewportIcon text" Content="Shape" Command="{Binding ShapeSelectedCommand}"
                ToolTip.Tip="Shape this greybox with the mesh tools, in place (double-click it)" />
        <Button Classes="viewportIcon text" Content="Cut" Command="{Binding CutSelectedCommand}" IsVisible="{Binding CanCutSelected}"
                ToolTip.Tip="Cut the other selected greyboxes out of the one selected last: a tunnel, a doorway, a window" />
      </StackPanel>
    </Border>
    <!-- The tool rail down the left edge, under the mode bar: one component, filled with the tools of what is being edited. -->
    <viewports:ToolRailView Margin="12,50,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" DataContext="{Binding ToolRail}" />
    <!-- A tool with a pending result waits here: Apply (Enter) keeps it, Cancel (Escape) puts the mesh back. -->
    <Border Classes="viewportBar" Margin="12" Height="34" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="10,3,4,3"
            IsVisible="{Binding MeshTools.IsConfirming}">
      <StackPanel Orientation="Horizontal" Spacing="8" DataContext="{Binding MeshTools}" x:DataType="viewports:MeshToolsViewModel">
        <TextBlock Text="{Binding ToolName}" VerticalAlignment="Center" FontWeight="Medium" />
        <Border Classes="vsep" Margin="0" />
        <Button Classes="viewportIcon text" Height="26" Content="Cancel" Command="{Binding CancelCommand}" ToolTip.Tip="Put the mesh back (Escape)" />
        <Button Classes="viewportIcon text accent" Height="26" Padding="10,0" Content="Apply" Command="{Binding ApplyCommand}" ToolTip.Tip="Keep the result (Enter)" />
      </StackPanel>
    </Border>
    <!-- The selected shot's timeline, left of the camera preview in the bottom right corner. -->
    <Grid ColumnDefinitions="3*,*" VerticalAlignment="Bottom" IsVisible="{Binding Timeline.HasShot}">
      <Border Classes="viewportBar" Margin="12,4,8,12" Height="34">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Classes="icon" Command="{Binding AddShotKeyCommand}"
                    ToolTip.Tip="Add a key where the view stands, at the scrubbed time.">
              <PathIcon Data="{x:Static shell:LucideIcons.Add}" />
            </Button>
            <Button Classes="icon delete" Command="{Binding Timeline.DeleteSelectedKeyCommand}" ToolTip.Tip="Delete the selected key.">
              <PathIcon Data="{x:Static shell:LucideIcons.Remove}" />
            </Button>
          </StackPanel>
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0" MinWidth="48" TextAlignment="Right"
                     Text="{Binding Timeline.ScrubTime, StringFormat={}{0:0.00} s}" />
          <shots:ShotTimelineStrip Timeline="{Binding Timeline}" Height="28" />
        </DockPanel>
      </Border>
    </Grid>
    <!-- Top right, the picture: the hour of the day, what is drawn over the scene, the projection and the game's view. -->
    <StackPanel Margin="12" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Border Classes="viewportBar" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <Button Classes="viewportIcon text" Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).ToggleDayDockCommand}"
                  ToolTip.Tip="The hour the viewport is lit at; opens the Day dock, where the scene's environment is edited over the day.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="accent" Data="{x:Static shell:LucideIcons.Sun}" />
              <TextBlock Text="{Binding HourText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Classes="vsep" />
          <Button Classes="viewportIcon text" ToolTip.Tip="What the viewport draws over the scene.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static shell:LucideIcons.Visible}" />
              <TextBlock Text="Show" VerticalAlignment="Center" />
              <PathIcon Classes="small faint" Data="{x:Static shell:LucideIcons.Expand}" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Grid" ToggleType="CheckBox" IsChecked="{Binding ShowGrid}" />
                <MenuItem Header="Depth fade" ToggleType="CheckBox" IsChecked="{Binding ShowDepthFade}" ToolTip.Tip="The main camera's depth fade." />
                <MenuItem Header="Canvas" ToggleType="CheckBox" IsChecked="{Binding ShowCanvas}"
                          ToolTip.Tip="The canvas the scene is painted on. Off hides it in the viewport only." />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding IsPerspective}" ToolTip.Tip="Perspective or orthographic view">
            <PathIcon Data="{x:Static shell:LucideIcons.Perspective}" />
          </ToggleButton>
          <Border Classes="vsep" />
          <ToggleButton Classes="viewportIcon" IsChecked="{Binding IsGameView}"
                        ToolTip.Tip="Game View (G): hides the grid, sky, icons, selection and gizmo to show the world as the game will.">
            <PathIcon Data="{x:Static shell:LucideIcons.GameView}" />
          </ToggleButton>
        </StackPanel>
      </Border>
      <viewports:NavigationGizmo Width="80" Height="80" Camera="{Binding Camera}" HorizontalAlignment="Right" />
    </StackPanel>
  </Panel>
</UserControl>
