<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlickerVoid.Editor.App"
             xmlns:inspector="using:FlickerVoid.Editor.Core.Inspector"
             xmlns:shellInspector="using:FlickerVoid.Editor.Inspector"
             xmlns:shell="using:FlickerVoid.Editor"
             RequestedThemeVariant="Dark">
  <!-- One template per kind of field, picked by the field's type, for the inspector and the material editor alike:
       components and materials need no editor code of their own. -->
  <Application.Resources>
    <!-- A field's row: its label beside it, or above it, indented, when it holds fields of its own (nested objects and lists). The
         label column is 96 px or as wide as the longest label of its section, so no label is cut. -->
    <DataTemplate x:Key="FieldRow" DataType="inspector:FieldViewModel">
      <Grid RowDefinitions="Auto,Auto" Margin="0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="FieldLabel" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Classes="fieldLabel" ToolTip.Tip="{Binding Label}" />
        <ContentControl Classes="fieldValue" Classes.nested="{Binding IsNested}" Content="{Binding}" />
      </Grid>
    </DataTemplate>
  </Application.Resources>
  <Application.DataTemplates>
    <!-- Ranged numbers first: a template matches subclasses too, and the first match wins. Numbers are dragged sideways or typed
         after a click; X, Y and Z carry the axes' colours, every other number a yellow bar. -->
    <DataTemplate DataType="inspector:RangedNumberFieldViewModel">
      <shellInspector:DragNumberBox Value="{Binding Value}" Minimum="{Binding Lowest}" Maximum="{Binding Highest}"
                                    Step="{Binding DragStep}" IsReadOnly="{Binding IsReadOnly}" />
    </DataTemplate>
    <DataTemplate DataType="inspector:NumberFieldViewModel">
      <shellInspector:DragNumberBox Value="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" />
    </DataTemplate>
    <DataTemplate DataType="inspector:BoolFieldViewModel">
      <ToggleButton Theme="{StaticResource Switch}" IsChecked="{Binding Value}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Left" />
    </DataTemplate>
    <DataTemplate DataType="inspector:TextFieldViewModel">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !IsReadOnly}" />
    </DataTemplate>
    <DataTemplate DataType="inspector:AssetFieldViewModel">
      <Panel IsEnabled="{Binding !IsReadOnly}">
        <shellInspector:AssetPickerView DataContext="{Binding Picker}" />
      </Panel>
    </DataTemplate>
    <DataTemplate DataType="inspector:ListFieldViewModel">
      <StackPanel Spacing="2">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="inspector:ListItemViewModel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,1">
                <Panel>
                  <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding IsText}" />
                  <Panel IsVisible="{Binding !IsText}">
                    <shellInspector:AssetPickerView DataContext="{Binding Picker}" />
                  </Panel>
                </Panel>
                <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Remove"
                        Command="{Binding $parent[ItemsControl].((inspector:ListFieldViewModel)DataContext).RemoveCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{x:Static shell:LucideIcons.Remove}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="icon" ToolTip.Tip="Add" Command="{Binding AddCommand}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Left">
          <PathIcon Data="{x:Static shell:LucideIcons.Add}" />
        </Button>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="inspector:ObjectFieldViewModel">
      <StackPanel Spacing="1">
        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" IsVisible="{Binding HasKinds}"
                  IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Stretch" />
        <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRow}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="inspector:CollectionFieldViewModel">
      <StackPanel Spacing="1">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="inspector:FieldViewModel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldRow}" />
                <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Remove" VerticalAlignment="Top"
                        IsEnabled="{Binding !IsReadOnly}"
                        Command="{Binding $parent[ItemsControl].((inspector:CollectionFieldViewModel)DataContext).RemoveCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{x:Static shell:LucideIcons.Remove}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="icon" ToolTip.Tip="Add" Command="{Binding AddCommand}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Left">
          <PathIcon Data="{x:Static shell:LucideIcons.Add}" />
        </Button>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="inspector:EnumFieldViewModel">
      <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" IsEnabled="{Binding !IsReadOnly}"
                HorizontalAlignment="Stretch" />
    </DataTemplate>
    <DataTemplate DataType="inspector:VectorFieldViewModel">
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
        <shellInspector:DragNumberBox Grid.Column="0" Value="{Binding X}" Axis="X" AxisBrush="{StaticResource EditorAxisXBrush}" ToolTip.Tip="X" />
        <shellInspector:DragNumberBox Grid.Column="1" Value="{Binding Y}" Axis="Y" AxisBrush="{StaticResource EditorAxisYBrush}" ToolTip.Tip="Y" />
        <shellInspector:DragNumberBox Grid.Column="2" Value="{Binding Z}" Axis="Z" AxisBrush="{StaticResource EditorAxisZBrush}" ToolTip.Tip="Z" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="inspector:RotationFieldViewModel">
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
        <shellInspector:DragNumberBox Grid.Column="0" Value="{Binding X}" Step="0.5" Axis="X" AxisBrush="{StaticResource EditorAxisXBrush}"
                                      ToolTip.Tip="Pitch about X, in degrees" />
        <shellInspector:DragNumberBox Grid.Column="1" Value="{Binding Y}" Step="0.5" Axis="Y" AxisBrush="{StaticResource EditorAxisYBrush}"
                                      ToolTip.Tip="Yaw about Y, in degrees" />
        <shellInspector:DragNumberBox Grid.Column="2" Value="{Binding Z}" Step="0.5" Axis="Z" AxisBrush="{StaticResource EditorAxisZBrush}"
                                      ToolTip.Tip="Roll about Z, in degrees" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="inspector:ColorFieldViewModel">
      <ColorPicker Color="{Binding Color, Converter={x:Static shellInspector:SrgbColorConverter.Instance}}" IsAlphaEnabled="False" HorizontalAlignment="Left" />
    </DataTemplate>
    <DataTemplate DataType="inspector:ReadOnlyFieldViewModel">
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="muted" VerticalAlignment="Center" />
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <StyleInclude Source="/Themes/EditorTheme.axaml" />
  </Application.Styles>
</Application>
