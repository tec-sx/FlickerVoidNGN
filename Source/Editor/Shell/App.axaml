<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlickerVoid.Editor.App"
             xmlns:inspector="using:FlickerVoid.Editor.Core.Inspector"
             xmlns:shellInspector="using:FlickerVoid.Editor.Inspector"
             xmlns:shell="using:FlickerVoid.Editor"
             RequestedThemeVariant="Dark">
  <!-- One template per kind of field, picked by the field's type, for the inspector and the material editor alike:
       components and materials need no editor code of their own. -->
  <Application.DataTemplates>
    <!-- Ranged numbers first: a template matches subclasses too, and the first match wins. Numbers are dragged sideways or typed
         after a click; X, Y and Z carry the axes' colours. -->
    <DataTemplate DataType="inspector:RangedNumberFieldViewModel">
      <shellInspector:DragNumberBox Value="{Binding Value}" Minimum="{Binding Lowest}" Maximum="{Binding Highest}"
                                    Step="{Binding DragStep}" IsReadOnly="{Binding IsReadOnly}" />
    </DataTemplate>
    <DataTemplate DataType="inspector:NumberFieldViewModel">
      <shellInspector:DragNumberBox Value="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" />
    </DataTemplate>
    <DataTemplate DataType="inspector:BoolFieldViewModel">
      <CheckBox IsChecked="{Binding Value}" IsEnabled="{Binding !IsReadOnly}" />
    </DataTemplate>
    <DataTemplate DataType="inspector:TextFieldViewModel">
      <AutoCompleteBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding Suggestions}"
                       FilterMode="Contains" MinimumPrefixLength="0" IsEnabled="{Binding !IsReadOnly}" />
    </DataTemplate>
    <DataTemplate DataType="inspector:ListFieldViewModel">
      <StackPanel Spacing="2">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="inspector:ListItemViewModel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,1">
                <AutoCompleteBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding Suggestions}"
                                 FilterMode="Contains" MinimumPrefixLength="0" />
                <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Remove"
                        Command="{Binding $parent[ItemsControl].((inspector:ListFieldViewModel)DataContext).RemoveCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{x:Static shell:MaterialIcons.Remove}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="icon" ToolTip.Tip="Add" Command="{Binding AddCommand}" IsEnabled="{Binding !IsReadOnly}">
          <PathIcon Data="{x:Static shell:MaterialIcons.Add}" />
        </Button>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="inspector:EnumFieldViewModel">
      <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" IsEnabled="{Binding !IsReadOnly}"
                HorizontalAlignment="Stretch" />
    </DataTemplate>
    <DataTemplate DataType="inspector:VectorFieldViewModel">
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2">
        <shellInspector:DragNumberBox Grid.Column="0" Value="{Binding X}" AxisBrush="{StaticResource EditorAxisXBrush}" ToolTip.Tip="X" />
        <shellInspector:DragNumberBox Grid.Column="1" Value="{Binding Y}" AxisBrush="{StaticResource EditorAxisYBrush}" ToolTip.Tip="Y" />
        <shellInspector:DragNumberBox Grid.Column="2" Value="{Binding Z}" AxisBrush="{StaticResource EditorAxisZBrush}" ToolTip.Tip="Z" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="inspector:RotationFieldViewModel">
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2">
        <shellInspector:DragNumberBox Grid.Column="0" Value="{Binding X}" Step="0.5" AxisBrush="{StaticResource EditorAxisXBrush}"
                                      ToolTip.Tip="Pitch about X, in degrees" />
        <shellInspector:DragNumberBox Grid.Column="1" Value="{Binding Y}" Step="0.5" AxisBrush="{StaticResource EditorAxisYBrush}"
                                      ToolTip.Tip="Yaw about Y, in degrees" />
        <shellInspector:DragNumberBox Grid.Column="2" Value="{Binding Z}" Step="0.5" AxisBrush="{StaticResource EditorAxisZBrush}"
                                      ToolTip.Tip="Roll about Z, in degrees" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="inspector:ColorFieldViewModel">
      <ColorPicker Color="{Binding Color, Converter={x:Static shellInspector:SrgbColorConverter.Instance}}" IsAlphaEnabled="False" HorizontalAlignment="Left" />
    </DataTemplate>
    <DataTemplate DataType="inspector:ReadOnlyFieldViewModel">
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" />
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <StyleInclude Source="/Themes/EditorTheme.axaml" />
  </Application.Styles>
</Application>
