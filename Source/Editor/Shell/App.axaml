<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlickerVoid.Editor.App"
             xmlns:inspector="using:FlickerVoid.Editor.Core.Inspector"
             xmlns:shellInspector="using:FlickerVoid.Editor.Inspector"
             RequestedThemeVariant="Dark">
  <!-- One template per kind of field, picked by the field's type, for the inspector and the material editor alike:
       components and materials need no editor code of their own. -->
  <Application.DataTemplates>
    <!-- Ranged numbers first: a template matches subclasses too, and the first match wins. A slider only where there are
         limits, as an unbound slider would clamp the value to its own default range. -->
    <DataTemplate DataType="inspector:RangedNumberFieldViewModel">
      <Grid ColumnDefinitions="*,72" ColumnSpacing="6">
        <Slider Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding Value}"
                IsEnabled="{Binding !IsReadOnly}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="inspector:NumberFieldViewModel">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}" />
    </DataTemplate>
    <DataTemplate DataType="inspector:BoolFieldViewModel">
      <CheckBox IsChecked="{Binding Value}" IsEnabled="{Binding !IsReadOnly}" />
    </DataTemplate>
    <DataTemplate DataType="inspector:TextFieldViewModel">
      <AutoCompleteBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding Suggestions}"
                       FilterMode="Contains" MinimumPrefixLength="0" IsEnabled="{Binding !IsReadOnly}" />
    </DataTemplate>
    <DataTemplate DataType="inspector:ListFieldViewModel">
      <StackPanel Spacing="2">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="inspector:ListItemViewModel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,1">
                <AutoCompleteBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding Suggestions}"
                                 FilterMode="Contains" MinimumPrefixLength="0" />
                <Button Grid.Column="1" Content="-" ToolTip.Tip="Remove"
                        Command="{Binding $parent[ItemsControl].((inspector:ListFieldViewModel)DataContext).RemoveCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="+" ToolTip.Tip="Add" Command="{Binding AddCommand}" IsEnabled="{Binding !IsReadOnly}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="inspector:EnumFieldViewModel">
      <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" IsEnabled="{Binding !IsReadOnly}"
                HorizontalAlignment="Stretch" />
    </DataTemplate>
    <DataTemplate DataType="inspector:VectorFieldViewModel">
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
        <TextBox Grid.Column="0" Text="{Binding X, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="X" />
        <TextBox Grid.Column="1" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="Y" />
        <TextBox Grid.Column="2" Text="{Binding Z, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="Z" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="inspector:RotationFieldViewModel">
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
        <TextBox Grid.Column="0" Text="{Binding X, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="Pitch about X, in degrees" />
        <TextBox Grid.Column="1" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="Yaw about Y, in degrees" />
        <TextBox Grid.Column="2" Text="{Binding Z, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="Roll about Z, in degrees" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="inspector:ColorFieldViewModel">
      <ColorPicker Color="{Binding Color, Converter={x:Static shellInspector:SrgbColorConverter.Instance}}" IsAlphaEnabled="False" HorizontalAlignment="Left" />
    </DataTemplate>
    <DataTemplate DataType="inspector:ReadOnlyFieldViewModel">
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" />
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
  </Application.Styles>
</Application>
