<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:FlickerVoid.Editor.Core.Settings"
             x:Class="FlickerVoid.Editor.Settings.ProjectSettingsView"
             x:DataType="settings:ProjectSettingsViewModel">
  <!-- Each change is set in the edited game at once and written to the project's settings file. -->
  <DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="12,8">
      <Button DockPanel.Dock="Right" Content="Reset to defaults" Classes="delete" Command="{Binding ResetToDefaultsCommand}"
              ToolTip.Tip="Put every setting back to its default and write the file." />
      <TextBlock Text="{Binding FileNote}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,12,0" />
    </DockPanel>
    <TabControl Margin="12,8,12,0">
      <TabItem Header="Graphics">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Graphics}" Margin="0,8">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="settings:SwitchSettingViewModel">
                <Grid ColumnDefinitions="180,*" Margin="0,4" ToolTip.Tip="{Binding Help}">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <CheckBox Grid.Column="1" IsChecked="{Binding IsOn}" />
                </Grid>
              </DataTemplate>
              <DataTemplate DataType="settings:ChoiceSettingViewModel">
                <Grid ColumnDefinitions="180,*" Margin="0,4" ToolTip.Tip="{Binding Help}">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" MinWidth="160" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" />
                </Grid>
              </DataTemplate>
              <DataTemplate DataType="settings:TextSettingViewModel">
                <Grid ColumnDefinitions="180,*" Margin="0,4" ToolTip.Tip="{Binding Help}">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" MinWidth="160" Text="{Binding Text}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
