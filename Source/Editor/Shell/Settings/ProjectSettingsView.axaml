<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:FlickerVoid.Editor"
             xmlns:settings="using:FlickerVoid.Editor.Core.Settings"
             x:Class="FlickerVoid.Editor.Settings.ProjectSettingsView"
             x:DataType="settings:ProjectSettingsViewModel">
  <!-- Each change is set in the edited game at once and written to the project's settings file. -->
  <DockPanel>
    <!-- The categories, down the side as in the inspector. -->
    <Border DockPanel.Dock="Left" Classes="rail">
      <StackPanel Spacing="2" HorizontalAlignment="Center">
        <Button Classes="railButton on" ToolTip.Tip="Graphics">
          <PathIcon Data="{x:Static shell:LucideIcons.Look}" />
        </Button>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="transport">
      <DockPanel Margin="10,0">
        <Button DockPanel.Dock="Right" Classes="quiet" Command="{Binding ResetToDefaultsCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Put every setting back to its default and write the file.">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="small" Data="{x:Static shell:LucideIcons.Discard}" />
            <TextBlock Text="Reset to defaults" />
          </StackPanel>
        </Button>
        <TextBlock Text="{Binding FileNote}" Classes="faint small" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Margin="0,0,12,0" />
      </DockPanel>
    </Border>
    <ScrollViewer>
      <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="GRAPHICS" Classes="caps" Margin="12,10,12,4" />
        <Border Classes="sectionBody">
          <ItemsControl ItemsSource="{Binding Graphics}">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="settings:SwitchSettingViewModel">
                <Grid Margin="0,1" ToolTip.Tip="{Binding Help}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="FieldLabel" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Classes="fieldLabel" />
                  <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding IsOn}" HorizontalAlignment="Left" />
                </Grid>
              </DataTemplate>
              <DataTemplate DataType="settings:ChoiceSettingViewModel">
                <Grid Margin="0,1" ToolTip.Tip="{Binding Help}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="FieldLabel" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Classes="fieldLabel" />
                  <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left" ItemsSource="{Binding Choices}"
                            SelectedItem="{Binding Selected}" />
                </Grid>
              </DataTemplate>
              <DataTemplate DataType="settings:TextSettingViewModel">
                <Grid Margin="0,1" ToolTip.Tip="{Binding Help}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="FieldLabel" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Classes="fieldLabel" />
                  <TextBox Grid.Column="1" Width="200" HorizontalAlignment="Left" Text="{Binding Text}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
