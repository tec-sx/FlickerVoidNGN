<!-- The HUD: tracked quests at the top left, the minimap at the bottom right, and at the bottom centre the dialogue box while
     talking, the scan card in scan mode, else the prompt for what the pointer is over. Only the dialogue box takes clicks, so everything else leaves the mouse
     to the world. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hud="using:FlickerVoid.Interface.Hud"
             xmlns:controls="using:FlickerVoid.Interface.Controls"
             xmlns:quests="using:FlickerVoid.Interface.Hud.Quests"
             xmlns:conversations="using:FlickerVoid.Interface.Hud.Conversations"
             xmlns:prompts="using:FlickerVoid.Interface.Hud.Prompts"
             xmlns:minimap="using:FlickerVoid.Interface.Hud.Minimap"
             xmlns:scanning="using:FlickerVoid.Interface.Hud.Scanning"
             x:Class="FlickerVoid.Interface.Hud.HudView"
             x:DataType="hud:HudViewModel">
  <Grid>
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28" Width="320" Spacing="6"
                IsHitTestVisible="False" IsVisible="{Binding !!Quests.Count}">
      <TextBlock Classes="label" Text="OBJECTIVES" />
      <controls:HudFrame>
        <ItemsControl ItemsSource="{Binding Quests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="quests:TrackedQuestViewModel">
              <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,8">
                <Rectangle Width="2" Fill="{DynamicResource HudTintBrush}" Margin="0,3,10,3" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Classes="heading" Text="{Binding Name}" />
                  <TextBlock Classes="muted" Text="{Binding Objective}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </controls:HudFrame>
    </StackPanel>

    <minimap:MinimapView DataContext="{Binding Minimap}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                         IsVisible="{Binding IsVisible}" />

    <controls:HudFrame HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,36" Width="660" Padding="22,16"
                       Chamfer="14" IsVisible="{Binding Dialogue.IsOpen}">
      <StackPanel Spacing="10">
        <TextBlock Classes="heading" Text="{Binding Dialogue.Speaker}" IsVisible="{Binding !!Dialogue.Speaker.Length}" />
        <TextBlock Text="{Binding Dialogue.Line}" FontSize="19" IsVisible="{Binding !!Dialogue.Line.Length}" />
        <ItemsControl ItemsSource="{Binding Dialogue.Choices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="conversations:DialogueChoiceViewModel">
              <Button Classes="choice" Command="{Binding ChooseCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Label}" />
                  <TextBlock Classes="muted locked" Text="{Binding LockedReason}" IsVisible="{Binding IsLocked}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
          <Button Classes="choice" Command="{Binding Dialogue.AdvanceCommand}" IsVisible="{Binding Dialogue.CanAdvance}">
            <TextBlock Classes="label" Text="Next" />
          </Button>
          <Button Classes="choice" Command="{Binding Dialogue.LeaveCommand}">
            <TextBlock Classes="label" Text="Leave" />
          </Button>
        </StackPanel>
      </StackPanel>
    </controls:HudFrame>

    <controls:HudFrame HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,36" MinWidth="200"
                       IsHitTestVisible="False" IsVisible="{Binding Prompt.IsVisible}">
      <StackPanel Spacing="4">
        <TextBlock Classes="heading" Text="{Binding Prompt.Title}" HorizontalAlignment="Center" />
        <ItemsControl ItemsSource="{Binding Prompt.Offers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="prompts:PromptOfferViewModel">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding Name}" Classes.locked="{Binding !IsAvailable}" />
                <TextBlock Classes="muted" Text="{Binding LockedReason}" IsVisible="{Binding IsLocked}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </controls:HudFrame>

    <controls:HudFrame HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,36" Width="420" Padding="20,14"
                       IsHitTestVisible="False" IsVisible="{Binding Scan.IsVisible, FallbackValue=False}">
      <StackPanel Spacing="6">
        <TextBlock Classes="label" Text="SCAN" />
        <TextBlock Classes="heading" Text="{Binding Scan.Title}" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Scan.Progress}" MinHeight="3" Height="3"
                     Foreground="{DynamicResource HudTintBrush}" IsVisible="{Binding Scan.ShowsProgress}" />
        <ItemsControl ItemsSource="{Binding Scan.Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="scanning:ScanEntryViewModel">
              <Grid ColumnDefinitions="90,*" Margin="0,2">
                <TextBlock Classes="label" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </controls:HudFrame>
  </Grid>
</UserControl>
