<Project Sdk="Microsoft.NET.Sdk">
  <!-- FlickerVoid's interface: the HUD and the hub as Avalonia views over view models of the game's systems, drawn over the scene. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(FlickerVoidEngine)Source/Engine/Ui/FlickerVoid.Engine.Ui.csproj" />
    <ProjectReference Include="../Gameplay/FlickerVoid.Gameplay.csproj" />
  </ItemGroup>
</Project>
