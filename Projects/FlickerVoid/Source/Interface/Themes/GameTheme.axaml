<!-- The game's look over Fluent: warm, dark, see-through panels with ink-coloured edges, and parchment text. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#D8211A15" />
    <SolidColorBrush x:Key="PanelEdgeBrush" Color="#806B5440" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2E6D2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B8A88F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F0B46A" />
    <SolidColorBrush x:Key="LockedBrush" Color="#8C7F70" />
  </Styles.Resources>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.locked">
    <Setter Property="Foreground" Value="{StaticResource LockedBrush}" />
  </Style>

  <!-- Choices read as lines of text that light up, not as boxes. -->
  <Style Selector="Button.choice">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.choice:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#33F0B46A" />
  </Style>
  <Style Selector="Button.choice:pointerover TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.choice:disabled TextBlock">
    <Setter Property="Foreground" Value="{StaticResource LockedBrush}" />
  </Style>
  <Style Selector="Button.choice:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
