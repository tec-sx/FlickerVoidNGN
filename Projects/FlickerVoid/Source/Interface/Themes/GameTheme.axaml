<!-- The game's look over Fluent. HUD lines, text and icons are drawn in HudTint, white by default, so one colour tints them all;
     panels are dark and see-through; the hub's accent is the yellow of its striped bar. Headings use Glitch Goblin, text Rajdhani
     (both SIL OFL 1.1, licences beside the fonts). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FlickerVoid.Interface.Controls">
  <Styles.Resources>
    <Color x:Key="HudTint">#FFFFFF</Color>
    <SolidColorBrush x:Key="HudTintBrush" Color="{StaticResource HudTint}" />
    <SolidColorBrush x:Key="HudMutedBrush" Color="{StaticResource HudTint}" Opacity="0.62" />
    <SolidColorBrush x:Key="HudFaintBrush" Color="{StaticResource HudTint}" Opacity="0.35" />
    <SolidColorBrush x:Key="PanelBrush" Color="#C4080A10" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E8A700" />
    <SolidColorBrush x:Key="InkBrush" Color="#0B0B0D" />
    <FontFamily x:Key="HeadingFont">avares://FlickerVoid.Interface/Assets/Fonts#Glitch Goblin</FontFamily>
    <FontFamily x:Key="TextFont">avares://FlickerVoid.Interface/Assets/Fonts#Rajdhani</FontFamily>
  </Styles.Resources>

  <Style Selector="controls|HudFrame">
    <Setter Property="Stroke" Value="{StaticResource HudFaintBrush}" />
    <Setter Property="Fill" Value="{StaticResource PanelBrush}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="Foreground" Value="{StaticResource HudTintBrush}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LetterSpacing" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource HudMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource HudMutedBrush}" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBlock.locked">
    <Setter Property="Foreground" Value="{StaticResource HudFaintBrush}" />
  </Style>

  <!-- Choices read as lines of text with a bar that lights up, not as boxes. -->
  <Style Selector="Button.choice">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.choice:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource HudTintBrush}" />
  </Style>
  <Style Selector="Button.choice:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#38FFFFFF" />
  </Style>
  <Style Selector="Button.choice:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.choice:disabled TextBlock">
    <Setter Property="Foreground" Value="{StaticResource HudFaintBrush}" />
  </Style>
</Styles>
