<!-- The game's look over Fluent. HUD lines, text and icons are drawn in HudTint, white by default, so one colour tints them all;
     panels are dark and see-through; the hub's accent is the yellow of its striped bar. Headings use Glitch Goblin, text Rajdhani
     (both SIL OFL 1.1, licences beside the fonts). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FlickerVoid.Interface.Controls">
  <Styles.Resources>
    <Color x:Key="HudTint">#FFFFFF</Color>
    <SolidColorBrush x:Key="HudTintBrush" Color="{StaticResource HudTint}" />
    <SolidColorBrush x:Key="HudMutedBrush" Color="{StaticResource HudTint}" Opacity="0.62" />
    <SolidColorBrush x:Key="HudFaintBrush" Color="{StaticResource HudTint}" Opacity="0.35" />
    <SolidColorBrush x:Key="PanelBrush" Color="#C4080A10" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E8A700" />
    <SolidColorBrush x:Key="InkBrush" Color="#0B0B0D" />
    <FontFamily x:Key="HeadingFont">avares://FlickerVoid.Interface/Assets/Fonts#Glitch Goblin</FontFamily>
    <FontFamily x:Key="TextFont">avares://FlickerVoid.Interface/Assets/Fonts#Rajdhani</FontFamily>
  </Styles.Resources>

  <Style Selector="controls|HudFrame">
    <Setter Property="Stroke" Value="{StaticResource HudFaintBrush}" />
    <Setter Property="Fill" Value="{StaticResource PanelBrush}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="Foreground" Value="{StaticResource HudTintBrush}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LetterSpacing" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource HudMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource HudMutedBrush}" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBlock.locked">
    <Setter Property="Foreground" Value="{StaticResource HudFaintBrush}" />
  </Style>

  <!-- Choices read as lines of text with a bar that lights up, not as boxes. -->
  <Style Selector="Button.choice">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.choice:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource HudTintBrush}" />
  </Style>
  <Style Selector="Button.choice:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#38FFFFFF" />
  </Style>
  <Style Selector="Button.choice:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.choice:disabled TextBlock">
    <Setter Property="Foreground" Value="{StaticResource HudFaintBrush}" />
  </Style>
  <!-- The hub: tabs in the heading font on the yellow bar itself, underlined; the ones not shown are faded. -->
  <Style Selector="TextBlock.value">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16,4,16,6" />
    <Setter Property="MinWidth" Value="170" />
    <Setter Property="Height" Value="50" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter, Button.tab:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBlock.tab">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="TextDecorations" Value="Underline" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.tab:pointerover TextBlock.tab">
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.tab.selected TextBlock.tab">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.close">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="50" />
    <Setter Property="Height" Value="50" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.close:pointerover /template/ ContentPresenter, Button.close:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Cells and outfit slots: dark squares outlined in the tint, filled faintly when selected and outlined in the accent when the
       selected stack can be worn there. -->
  <Style Selector="Button.cell, Button.slot">
    <Setter Property="Background" Value="#0B0B0D" />
    <Setter Property="BorderBrush" Value="{StaticResource HudFaintBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.cell">
    <Setter Property="Height" Value="78" />
  </Style>
  <Style Selector="Button.slot">
    <Setter Property="Height" Value="112" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Button.cell:pointerover /template/ ContentPresenter, Button.slot:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1C1C20" />
    <Setter Property="BorderBrush" Value="{StaticResource HudMutedBrush}" />
  </Style>
  <Style Selector="Button.cell:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#0B0B0D" />
    <Setter Property="BorderBrush" Value="{StaticResource HudFaintBrush}" />
  </Style>
  <Style Selector="Button.cell.selected /template/ ContentPresenter, Button.slot.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A2A30" />
    <Setter Property="BorderBrush" Value="{StaticResource HudTintBrush}" />
  </Style>
  <Style Selector="Button.slot.take /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.cell.worn TextBlock.cell, Button.slot.blocked TextBlock.cell">
    <Setter Property="Foreground" Value="{StaticResource HudMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.cell">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.count">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="TextBlock.slot">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.action">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource HudMutedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="14,4" />
  </Style>
  <Style Selector="Button.action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource HudTintBrush}" />
  </Style>
  <Style Selector="TextBlock.action">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
</Styles>
