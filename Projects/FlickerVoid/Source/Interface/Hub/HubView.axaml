<!-- The hub menu: the yellow bar with its skewed strips, the page tabs and Close at the top, the selected page below and a yellow bar
     closing the bottom. Its dark background takes every click, so nothing reaches the world while it is open. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hub="using:FlickerVoid.Interface.Hub"
             xmlns:inventory="using:FlickerVoid.Interface.Hub.Inventory"
             xmlns:character="using:FlickerVoid.Interface.Hub.Character"
             xmlns:journal="using:FlickerVoid.Interface.Hub.Journal"
             x:Class="FlickerVoid.Interface.Hub.HubView"
             x:DataType="hub:HubViewModel"
             IsVisible="{Binding IsOpen}">
  <Grid RowDefinitions="64,*,28" Background="#EE060608">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
      <Panel Grid.Column="0" Margin="300,0,0,0" ClipToBounds="True">
        <Rectangle Fill="{StaticResource AccentBrush}" Width="333" HorizontalAlignment="Left" RenderTransformOrigin="50%,50%">
          <Rectangle.OpacityMask>
            <ImageBrush Source="avares://FlickerVoid.Interface/Assets/Images/FadingStrips.png" Stretch="Fill" />
          </Rectangle.OpacityMask>
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="-1" />
              <SkewTransform AngleX="-30" />
            </TransformGroup>
          </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Fill="{StaticResource AccentBrush}" Margin="300,0,0,0" />
      </Panel>
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Pages}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="hub:HubPageViewModel">
            <Button Classes="tab" Classes.selected="{Binding IsSelected}" CommandParameter="{Binding}"
                    Command="{Binding $parent[ItemsControl].((hub:HubViewModel)DataContext).SelectPageCommand}">
              <TextBlock Classes="tab" Text="{Binding Title}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Grid.Column="2" Classes="close" Command="{Binding CloseCommand}">
        <Path Data="M0,0 L16,16 M16,0 L0,16" Stroke="{StaticResource InkBrush}" StrokeThickness="2" />
      </Button>
    </Grid>

    <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" Margin="48,24,48,16">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="inventory:InventoryPageViewModel">
          <inventory:InventoryPageView />
        </DataTemplate>
        <DataTemplate DataType="character:CharacterPageViewModel">
          <character:CharacterPageView />
        </DataTemplate>
        <DataTemplate DataType="journal:JournalPageViewModel">
          <journal:JournalPageView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <Rectangle Grid.Row="2" Fill="{StaticResource AccentBrush}" Margin="48,0" />
  </Grid>
</UserControl>
