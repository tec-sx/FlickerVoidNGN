<!-- The journal: active quests with their objectives, finished quests, and what the protagonist knows, side by side. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:journal="using:FlickerVoid.Interface.Hub.Journal"
             xmlns:controls="using:FlickerVoid.Interface.Controls"
             x:Class="FlickerVoid.Interface.Hub.Journal.JournalPageView"
             x:DataType="journal:JournalPageViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="journal:JournalEntryViewModel">
      <StackPanel Margin="0,3,0,8" Spacing="1">
        <TextBlock Classes="heading" Text="{Binding Name}" />
        <TextBlock Classes="muted" Text="{Binding Description}" IsVisible="{Binding !!Description.Length}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid ColumnDefinitions="*,24,*,24,*" VerticalAlignment="Top">
    <StackPanel Grid.Column="0" Spacing="6">
      <TextBlock Classes="label" Text="QUESTS" />
      <controls:HudFrame>
        <Panel>
          <TextBlock Classes="muted" Text="No quests." IsVisible="{Binding !ActiveQuests.Count}" />
          <ItemsControl ItemsSource="{Binding ActiveQuests}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="journal:JournalQuestViewModel">
                <StackPanel Margin="0,3,0,10" Spacing="2">
                  <TextBlock Classes="heading" Text="{Binding Name}" />
                  <TextBlock Classes="muted" Text="{Binding Description}" IsVisible="{Binding !!Description.Length}" />
                  <ItemsControl ItemsSource="{Binding Objectives}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2,0,0">
                          <Rectangle Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </controls:HudFrame>
    </StackPanel>
    <StackPanel Grid.Column="2" Spacing="6">
      <TextBlock Classes="label" Text="FINISHED" />
      <controls:HudFrame>
        <Panel>
          <TextBlock Classes="muted" Text="Nothing finished yet." IsVisible="{Binding !FinishedQuests.Count}" />
          <ItemsControl ItemsSource="{Binding FinishedQuests}" />
        </Panel>
      </controls:HudFrame>
    </StackPanel>
    <StackPanel Grid.Column="4" Spacing="6">
      <TextBlock Classes="label" Text="KNOWLEDGE" />
      <controls:HudFrame>
        <Panel>
          <TextBlock Classes="muted" Text="Nothing learned yet." IsVisible="{Binding !Knowledge.Count}" />
          <ItemsControl ItemsSource="{Binding Knowledge}" />
        </Panel>
      </controls:HudFrame>
    </StackPanel>
  </Grid>
</UserControl>
