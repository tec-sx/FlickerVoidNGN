{
  "$schema": "../.schemas/data.schema.json",
  "type": "marker",
  "id": "Marker.Objective",
  "display": { "name": "Objective" },
  "tags": [ "Marker.Category.Quest" ],
  "priority": 2,
  "visibleWhen": { "conditions": [ { "$type": "questState", "quest": "Quest.Cellar", "state": "Active" } ] },
  "fragments": [ { "$type": "minimap", "clampToEdge": true }, { "$type": "compass" }, { "$type": "worldMap" } ]
}
