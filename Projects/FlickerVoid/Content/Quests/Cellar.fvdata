{
  "$schema": "../.schemas/data.schema.json",
  "type": "quest",
  "id": "Quest.Cellar",
  "display": { "name": "The cellar key", "shortDescription": "The innkeeper lost the key to the cellar." },
  "flow": "Quests/Cellar.fvflow",
  "objectives": [
    {
      "fact": "Quest.Cellar.FoundKey",
      "description": "Find the cellar key",
      "completeWhen": { "conditions": [ { "$type": "hasItem", "item": "Items/CellarKey.fvdata" } ] }
    },
    {
      "fact": "Quest.Cellar.ReturnedKey",
      "description": "Tell the innkeeper",
      "visibleWhen": { "conditions": [ { "$type": "fact", "fact": "Quest.Cellar.FoundKey" } ] }
    }
  ],
  "onCompleted": { "effects": [ { "$type": "giveMoney", "amount": 5 } ] }
}
