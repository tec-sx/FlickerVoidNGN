<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Arch" Version="2.1.0" />
    <PackageVersion Include="Arch.System" Version="1.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Physics">
    <PackageVersion Include="BepuPhysics" Version="2.5.0-beta.33" />
  </ItemGroup>
  <ItemGroup Label="Debug">
    <PackageVersion Include="Hexa.NET.ImGui" Version="2.2.9" />
  </ItemGroup>
  <ItemGroup Label="Platform">
    <PackageVersion Include="Silk.NET.Input.Sdl" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing.Sdl" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup Label="Graphics">
    <PackageVersion Include="Silk.NET.Core" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup Label="Rendering">
    <PackageVersion Include="SharpGLTF.Core" Version="1.0.7" />
    <PackageVersion Include="StbImageSharp" Version="2.30.16" />
    <PackageVersion Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup Label="Shaders">
    <PackageVersion Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
    <PackageVersion Include="Vortice.Dxc.Native" Version="1.0.6" />
  </ItemGroup>
  <ItemGroup Label="Editor">
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup Label="Samples">
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup Label="Generators">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="SharpGLTF.Toolkit" Version="1.0.7" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
