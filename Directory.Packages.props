<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Arch" Version="2.1.0" />
    <PackageVersion Include="Arch.System" Version="1.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Physics">
    <PackageVersion Include="BepuPhysics" Version="2.5.0-beta.33" />
  </ItemGroup>
  <ItemGroup Label="Samples">
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
