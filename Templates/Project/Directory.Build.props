<Project InitialTargets="CheckFlickerVoidEngine">
  <!-- The engine this project builds against, from the FLICKERVOID_ENGINE environment variable.
       Engine modules are referenced as $(FlickerVoidEngine)Source/<Module>/... -->
  <PropertyGroup>
    <FlickerVoidEngine>$(FLICKERVOID_ENGINE)</FlickerVoidEngine>
    <FlickerVoidEngine>$([MSBuild]::EnsureTrailingSlash('$(FlickerVoidEngine)'))</FlickerVoidEngine>
  </PropertyGroup>
  <!-- The engine's build settings: target framework, warnings as errors, and the test libraries for *.Tests projects. -->
  <Import Project="$(FlickerVoidEngine)Directory.Build.props" Condition="'$(FlickerVoidEngine)' != '' and Exists('$(FlickerVoidEngine)Directory.Build.props')" />
  <Target Name="CheckFlickerVoidEngine">
    <Error Condition="'$(FlickerVoidEngine)' == '' or !Exists('$(FlickerVoidEngine)Directory.Build.props')" Text="No FlickerVoid engine at '$(FlickerVoidEngine)'. Set the FLICKERVOID_ENGINE environment variable to the engine repository's folder." />
  </Target>
</Project>
