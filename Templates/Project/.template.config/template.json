{
  "$schema": "http://json.schemastore.org/template",
  "author": "FlickerVoid",
  "classifications": [ "Game", "FlickerVoid" ],
  "identity": "FlickerVoid.Project",
  "name": "FlickerVoid project",
  "description": "A game project with its own solution that builds against a FlickerVoid engine repository.",
  "shortName": "flickervoid",
  "sourceName": "FlickerVoidGame",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "engine": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The engine repository's folder, as an absolute path. Builds use the FLICKERVOID_ENGINE environment variable instead when it is set."
    },
    "engineFolder": {
      "type": "generated",
      "generator": "regex",
      "datatype": "text",
      "replaces": "ENGINE_FOLDER_PATH",
      "parameters": {
        "source": "engine",
        "steps": [
          { "regex": "\\\\", "replacement": "/" },
          { "regex": "/+$", "replacement": "" }
        ]
      }
    }
  }
}
